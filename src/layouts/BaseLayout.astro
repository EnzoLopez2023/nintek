---
import '../styles/global.css';
import { COMPANY } from '../data/apps';
import BrandMark from '../components/BrandMark.astro';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  path?: string;
  /** Render without the site header/footer/background — for self-contained pages. */
  bare?: boolean;
  /** Load the Cairn Blueprint faces (Archivo + Instrument Sans + IBM Plex Mono). */
  cairnFonts?: boolean;
  /** Load the optional board display faces (Martian Mono + Archivo). */
  boardFonts?: boolean;
  /** Load the ShopKeep Tool Library faces (Saira + Martian Mono). */
  libraryFonts?: boolean;
  /** Absolute or site-relative social preview image. */
  socialImage?: string;
  /** Accessible description for the social preview image. */
  socialImageAlt?: string;
  /** Intrinsic social preview dimensions. Common public assets are inferred. */
  socialImageWidth?: number;
  socialImageHeight?: number;
  /** Browser chrome tint. Defaults to the Nintek house cream; a re-skinned
      app page should pass its own page colour so the chrome matches. */
  themeColor?: string;
}

const {
  title,
  description = COMPANY.tagline,
  noindex = false,
  path = '/',
  bare = false,
  cairnFonts = false,
  boardFonts = false,
  libraryFonts = false,
  socialImage = '/bg.png',
  socialImageAlt = `${COMPANY.name} portfolio`,
  socialImageWidth: socialImageWidthProp,
  socialImageHeight: socialImageHeightProp,
  themeColor = '#f5f0ea',
} = Astro.props;

const canonical = new URL(path, Astro.site ?? 'https://www.nintek.com').href;
const socialImageUrl = socialImage
  ? new URL(socialImage, Astro.site ?? 'https://www.nintek.com').href
  : undefined;
const commonSocialDimensions =
  socialImage === '/bg.png'
    ? { width: 1536, height: 1024 }
    : /^\/apps\/[^/]+\.png$/.test(socialImage)
      ? { width: 1024, height: 1024 }
      : undefined;
const socialImageWidth = socialImageWidthProp ?? commonSocialDimensions?.width;
const socialImageHeight = socialImageHeightProp ?? commonSocialDimensions?.height;
const socialImageType = socialImage.endsWith('.png')
  ? 'image/png'
  : socialImage.endsWith('.webp')
    ? 'image/webp'
    : socialImage.endsWith('.jpg') || socialImage.endsWith('.jpeg')
      ? 'image/jpeg'
      : undefined;
const twitterCard =
  socialImageWidth && socialImageHeight && socialImageWidth / socialImageHeight >= 1.5
    ? 'summary_large_image'
    : 'summary';
const schemaType =
  path === '/'
    ? 'WebSite'
    : path === '/about'
      ? 'AboutPage'
      : path === '/ios'
        ? 'CollectionPage'
        : 'WebPage';
const organizationId = 'https://www.nintek.com/#organization';
const websiteId = 'https://www.nintek.com/#website';
const pageStructuredData = {
  '@context': 'https://schema.org',
  '@graph':
    path === '/'
      ? [
          {
            '@type': 'Organization',
            '@id': organizationId,
            name: COMPANY.name,
            url: canonical,
            email: COMPANY.email,
          },
          {
            '@type': 'WebSite',
            '@id': websiteId,
            url: canonical,
            name: COMPANY.name,
            description,
            publisher: { '@id': organizationId },
          },
        ]
      : [
          {
            '@type': schemaType,
            '@id': `${canonical}#webpage`,
            url: canonical,
            name: title,
            description,
            isPartOf: { '@id': websiteId },
            publisher: { '@id': organizationId },
          },
        ],
};
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {
      cairnFonts && (
        <>
          <link rel="preconnect" href="https://fonts.googleapis.com" />
          <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
          <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&family=Instrument+Sans:wght@400;500;600;700&display=swap"
          />
        </>
      )
    }
    {
      boardFonts && (
        <>
          <link rel="preconnect" href="https://fonts.googleapis.com" />
          <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
          <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@75..112,400..700&family=Martian+Mono:wdth,wght@75..112,400..800&display=swap"
          />
        </>
      )
    }
    {
      libraryFonts && (
        <>
          <link rel="preconnect" href="https://fonts.googleapis.com" />
          <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
          <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Martian+Mono:wght@400..800&family=Saira:wght@400..800&display=swap"
          />
        </>
      )
    }
    <slot name="head" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={COMPANY.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    {socialImageUrl && <meta property="og:image:secure_url" content={socialImageUrl} />}
    {socialImageType && <meta property="og:image:type" content={socialImageType} />}
    {socialImageWidth && <meta property="og:image:width" content={socialImageWidth} />}
    {socialImageHeight && <meta property="og:image:height" content={socialImageHeight} />}
    {socialImageUrl && <meta property="og:image:alt" content={socialImageAlt} />}
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    {socialImageUrl && <meta name="twitter:image:alt" content={socialImageAlt} />}
    <meta name="theme-color" content={themeColor} />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(pageStructuredData)} />}
  </head>
  <body>
    {
      bare ? (
        <slot />
      ) : (
        <>
          <div class="bg-decor" aria-hidden="true">
            <div class="grain" />
          </div>

          <header class="site-header">
            <div class="container">
              <a class="brand" href="/">
                <BrandMark size={24} />
                <span class="brand-word" aria-label={COMPANY.name}>
                  <span class="brand-em">n</span><span class="brand-dim">in</span><span class="brand-em">t</span><span class="brand-dim">ek</span>
                </span>
              </a>
              <nav class="nav">
                <a href="/#apps">Apps</a>
                <a class="nav-native" href="/ios">
                  iOS
                  <span class="nav-dot" aria-hidden="true"></span>
                </a>
                <a href="/about">About</a>
              </nav>
            </div>
          </header>

          <main>
            <slot />
          </main>

          <footer class="site-footer">
            <div class="container">
              <span>© {year} {COMPANY.name}</span>
              <nav aria-label="Site terms and contact">
                <a href="/terms">Terms</a>
                <a href={`mailto:${COMPANY.email}`}>Support</a>
                <a href={`mailto:${COMPANY.privacyEmail}`}>Privacy questions</a>
              </nav>
            </div>
          </footer>
        </>
      )
    }

    <script>
      const reduce = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;

      // --- parallax (orbs + tagged elements) ---
      const para = Array.from(
        document.querySelectorAll<HTMLElement>('[data-parallax]')
      );
      let ticking = false;

      function applyParallax() {
        const sy = window.scrollY;
        const vh = window.innerHeight;
        for (const el of para) {
          const speed = parseFloat(el.dataset.speed || '0');
          if (el.classList.contains('orb')) {
            el.style.transform = `translateY(${sy * speed}px)`;
          } else {
            const r = el.getBoundingClientRect();
            const center = r.top + r.height / 2 - vh / 2;
            el.style.transform = `translateY(${center * speed}px)`;
          }
        }
        ticking = false;
      }

      function onScroll() {
        if (reduce || ticking) return;
        ticking = true;
        requestAnimationFrame(applyParallax);
      }

      if (!reduce) {
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', applyParallax);
        applyParallax();
      }

      // --- reveal on scroll ---
      const reveals = document.querySelectorAll('.reveal');
      if (reduce || !('IntersectionObserver' in window)) {
        reveals.forEach((el) => el.classList.add('in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.08 }
        );
        reveals.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
