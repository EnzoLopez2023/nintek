---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NintekBack from '../../components/NintekBack.astro';
import BrandMark from '../../components/BrandMark.astro';
import PhoneMock from '../../components/PhoneMock.astro';
import logo from '../../assets/sortie/logo.webp';
import poster from '../../assets/sortie/home-poster.webp';
import tundra from '../../assets/sortie/tundra.webp';
import meadow from '../../assets/sortie/meadow.webp';
import keepPlayer from '../../assets/sortie/keep-player.webp';
import keepEnemy from '../../assets/sortie/keep-enemy.webp';
import keepNeutral from '../../assets/sortie/keep-neutral.webp';
import '../../styles/sortie-landing.css';

const biomes = [
  'Meadow',
  'Marsh',
  'Woodland',
  'Desert',
  'Twilight',
  'Ember',
  'Autumn',
  'Tundra',
  'Jungle',
  'Canyon',
  'Highland',
  'Coast',
  'Ashland',
  'Crystal',
  'Storm',
];

const pageTitle = 'Sortie - Supply-line tactical conquest for iPhone and iPad';
const description =
  'Sortie is a pre-release Godot strategy game from Nintek: 1,500 tactical conquest levels across 15 biomes, local saves, and optional Game Center.';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Sortie',
  applicationCategory: 'GameApplication',
  operatingSystem: 'iOS 15 or later',
  description,
  identifier: 'com.nintek.sortie',
  url: 'https://www.nintek.com/sortie',
};
---

<BaseLayout
  bare
  boardFonts
  path="/sortie"
  title={pageTitle}
  description={description}
  themeColor="#10192a"
  socialImage={poster.src}
  socialImageAlt="Sortie pre-release campaign on iPhone"
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <!--
    THESIS: Sortie is a campaign atlas threaded by one permanent supply line, not a generic game landing page; every section shows how routes, terrain, and captured keeps reshape the front.
    OWN-WORLD: Saturated biome fields, cobalt and signal-red keeps, parchment-gold routes, steel-blue type, source art at battlefield scale, and Nintek copper used only as the family signature.
    STORY: Watch the current build, understand the persistent-line mechanic, see the 1,500-level scope, learn what stays local, and leave with an honest picture of its pre-release state.
    FIRST VIEWPORT: The title and offer hold the left field while real pre-release footage runs inside a large phone on the right, with three source keeps joined through the scene by one route.
    FORM: The fifth grounded structure, staged as a 15-biome campaign atlas threaded by a persistent supply line; seed 72627634.
  -->
  <div class="so-root">
    <header class="so-nav">
      <div class="so-shell so-nav-inner">
        <div class="so-nav-brand">
          <NintekBack />
          <a href="/sortie" class="so-wordmark" aria-label="Sortie home">
            <img src="/apps/sortie.png" alt="" width="34" height="34" />
            <span>Sortie</span>
          </a>
        </div>
        <nav aria-label="Sortie">
          <a href="#mechanic">The line</a>
          <a href="#campaign">Campaign</a>
          <a href="#release">Release</a>
        </nav>
        <span class="so-nav-state">Pre-release</span>
      </div>
    </header>

    <main>
      <section
        class="so-hero"
        style={`--so-tundra: url(${tundra.src});`}
        aria-labelledby="sortie-title"
      >
        <div class="so-hero-shade" aria-hidden="true"></div>
        <div class="so-shell so-hero-grid">
          <div class="so-hero-copy">
            <img
              class="so-logo"
              src={logo.src}
              alt="Sortie"
              width={logo.width}
              height={logo.height}
            />
            <h1 id="sortie-title">
              Draw the line.
              <span>Take the map.</span>
            </h1>
            <p class="so-hero-lede">
              Link your keeps and troops keep moving. Sortie turns every route
              into a lasting tactical commitment across a 1,500-level campaign
              for iPhone and iPad.
            </p>
            <div class="so-hero-actions">
              <a class="so-button so-button-primary" href="#mechanic">
                Follow the supply line
                <span aria-hidden="true">↓</span>
              </a>
              <a class="so-button so-button-quiet" href="#release">
                Read the release brief
              </a>
            </div>
            <p class="so-hero-proof">
              15 biomes <span aria-hidden="true">/</span> local campaign save
              <span aria-hidden="true">/</span> optional Game Center
            </p>
          </div>

          <figure class="so-hero-stage" aria-labelledby="sortie-footage-caption">
            <div class="so-route so-route-hero" aria-hidden="true">
              <span class="so-route-line"></span>
              <img
                class="so-route-keep so-route-keep-a"
                src={keepPlayer.src}
                alt=""
                width={keepPlayer.width}
                height={keepPlayer.height}
              />
              <img
                class="so-route-keep so-route-keep-b"
                src={keepNeutral.src}
                alt=""
                width={keepNeutral.width}
                height={keepNeutral.height}
              />
              <img
                class="so-route-keep so-route-keep-c"
                src={keepEnemy.src}
                alt=""
                width={keepEnemy.width}
                height={keepEnemy.height}
              />
            </div>
            <div class="so-phone">
              <PhoneMock tone="dark" fullBleed>
                <video
                  data-sortie-video
                  src="/apps/sortie/hero-loop.mp4"
                  poster={poster.src}
                  width="720"
                  height="1280"
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  aria-describedby="sortie-footage-caption"
                ></video>
              </PhoneMock>
            </div>
            <figcaption id="sortie-footage-caption">
              <span>Current pre-release build footage</span>
              <button type="button" data-sortie-video-toggle aria-pressed="false">
                Pause footage
              </button>
            </figcaption>
          </figure>
        </div>
      </section>

      <section
        id="mechanic"
        class="so-mechanic"
        style={`--so-meadow: url(${meadow.src});`}
        aria-labelledby="mechanic-title"
      >
        <div class="so-shell">
          <div class="so-mechanic-head">
            <h2 id="mechanic-title">A route is a promise.</h2>
            <p>
              Drag from one keep to another and that line keeps sending troops.
              It stays live until you cut it or point the keep somewhere else.
              The strategy is the network, not a queue of one-off moves.
            </p>
          </div>

          <figure class="so-network">
            <svg
              class="so-network-lines"
              viewBox="0 0 1000 540"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <path class="so-network-under" d="M140 395 C300 120, 520 440, 840 145" />
              <path class="so-network-live" d="M140 395 C300 120, 520 440, 840 145" />
            </svg>
            <div class="so-node so-node-start">
              <img src={keepPlayer.src} alt="" width={keepPlayer.width} height={keepPlayer.height} />
              <span>Your keep</span>
            </div>
            <div class="so-node so-node-relay">
              <img src={keepNeutral.src} alt="" width={keepNeutral.width} height={keepNeutral.height} />
              <span>Capture and relay</span>
            </div>
            <div class="so-node so-node-front">
              <img src={keepEnemy.src} alt="" width={keepEnemy.width} height={keepEnemy.height} />
              <span>Break the front</span>
            </div>
            <ol class="so-network-notes">
              <li>
                <strong>Grow.</strong>
                Higher garrisons unlock more simultaneous lanes.
              </li>
              <li>
                <strong>Relay.</strong>
                A full keep forwards surplus through the chain.
              </li>
              <li>
                <strong>Reroute.</strong>
                Cut a line the moment the board changes.
              </li>
            </ol>
            <figcaption>
              Source-art composition made from current Sortie keep and biome assets;
              it is not presented as a gameplay screenshot.
            </figcaption>
          </figure>
        </div>
      </section>

      <section id="campaign" class="so-atlas" aria-labelledby="campaign-title">
        <div class="so-shell">
          <div class="so-atlas-copy">
            <h2 id="campaign-title">One hundred sorties in every climate.</h2>
            <p>
              The current source campaign contains 1,500 levels. Fifteen biomes
              appear exactly one hundred times each, changing the terrain and
              obstacle language without changing the rules underneath.
            </p>
          </div>
          <ol class="so-biomes" aria-label="Sortie's fifteen biomes">
            {
              biomes.map((biome, index) => (
                <li style={`--biome-index: ${index}`}>
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <strong>{biome}</strong>
                  <small>100 levels</small>
                </li>
              ))
            }
          </ol>
          <p class="so-atlas-note">
            The original 300-level extraction remains in the source only as a
            backup. The game now loads the full 1,500-level campaign.
          </p>
        </div>
      </section>

      <section class="so-terrain" aria-labelledby="terrain-title">
        <div class="so-shell so-terrain-grid">
          <div class="so-terrain-copy">
            <h2 id="terrain-title">The landscape decides what can connect.</h2>
            <p>
              Sortie has no hidden edge graph. Every potential lane is tested
              geometrically against the obstacles on the board. A clear line is
              open; a blocked line is not. Terrain is not decoration around the
              tactics. It is the tactics.
            </p>
          </div>
          <dl class="so-tactical-facts">
            <div>
              <dt>Permanent lanes</dt>
              <dd>Troops continue until the route is changed.</dd>
            </div>
            <div>
              <dt>Contested routes</dt>
              <dd>Opposing troops cancel where their supply lines meet.</dd>
            </div>
            <div>
              <dt>Neutral snipers</dt>
              <dd>Map hazards fire on every side, including yours.</dd>
            </div>
            <div>
              <dt>Relay depth</dt>
              <dd>Full rear keeps can feed pressure forward through the chain.</dd>
            </div>
          </dl>
        </div>
      </section>

      <section class="so-local" aria-labelledby="local-title">
        <div class="so-shell so-local-grid">
          <div class="so-local-copy">
            <h2 id="local-title">The campaign ends at the edge of your device.</h2>
            <p>
              Sortie has no custom account, cloud save, or Nintek backend.
              Progress and settings live in a versioned JSON file inside the
              app's own container.
            </p>
          </div>
          <dl class="so-local-ledger">
            <div>
              <dt>Local record</dt>
              <dd>Campaign progress, wins, best times, plays, and settings.</dd>
            </div>
            <div>
              <dt>Game Center</dt>
              <dd>Optional achievements; gameplay still works without sign-in.</dd>
            </div>
            <div>
              <dt>Custom backend</dt>
              <dd>None.</dd>
            </div>
            <div>
              <dt>Tracking</dt>
              <dd>The current iOS privacy manifest declares no tracking.</dd>
            </div>
          </dl>
        </div>
      </section>

      <section id="release" class="so-release" aria-labelledby="release-title">
        <div class="so-shell so-release-grid">
          <div>
            <h2 id="release-title">Built and playable. Not publicly released.</h2>
            <p>
              Sortie has a current Godot project and native Xcode export, but no
              public US App Store listing as of August 20, 2026. Public launch
              details will appear here when the release is ready.
            </p>
            <p>
              The product is positioned as one paid-upfront, ad-free game.
              A final price has not been set.
            </p>
          </div>
          <dl class="so-release-brief">
            <div><dt>Current target</dt><dd>iPhone and iPad</dd></div>
            <div><dt>Orientation</dt><dd>Portrait</dd></div>
            <div><dt>Minimum OS</dt><dd>iOS 15</dd></div>
            <div><dt>Bundle ID</dt><dd><code>com.nintek.sortie</code></dd></div>
            <div><dt>Public store link</dt><dd>Not available yet</dd></div>
            <div><dt>Price</dt><dd>Not announced</dd></div>
          </dl>
        </div>
        <div class="so-shell so-release-actions">
          <a class="so-button so-button-primary" href="/ios#sortie">See Sortie in the iOS collection</a>
          <a class="so-text-link" href="mailto:hello@nintek.com?subject=Sortie">Ask Nintek about Sortie</a>
        </div>
      </section>
    </main>

    <footer class="so-footer">
      <div class="so-shell">
        <a href="/" class="so-footer-brand">
          <BrandMark size={20} />
          Nintek
        </a>
        <p>Sortie / tactical conquest / pre-release iOS build</p>
        <nav aria-label="Footer">
          <a href="/">All apps</a>
          <a href="/ios">iOS</a>
          <a href="/about">About</a>
        </nav>
      </div>
    </footer>
  </div>

  <script>
    const video = document.querySelector<HTMLVideoElement>('[data-sortie-video]');
    const toggle = document.querySelector<HTMLButtonElement>('[data-sortie-video-toggle]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const setToggle = (paused: boolean) => {
      if (!toggle) return;
      toggle.textContent = paused ? 'Play footage' : 'Pause footage';
      toggle.setAttribute('aria-pressed', String(paused));
    };

    if (video && toggle) {
      if (reduceMotion) {
        video.pause();
        setToggle(true);
      }
      toggle.addEventListener('click', () => {
        if (video.paused) void video.play();
        else video.pause();
        setToggle(video.paused);
      });
    }
  </script>
</BaseLayout>
