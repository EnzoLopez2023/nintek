---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CortexScreen from '../../components/CortexScreen.astro';
import NintekBack from '../../components/NintekBack.astro';
import hubImage from '../../assets/cortex/hub.webp';
import { getApp } from '../../data/apps';
import '../../styles/cortex-landing.css';

const app = getApp('cortex')!;
const games = [
  {
    slug: 'sudoku',
    name: 'Sudoku',
    screen: 'sudoku',
    mark: '9',
    color: '#f1c75b',
    soft: '#fff0ad',
    copy: 'The familiar 9 × 9 ritual, tuned for a native screen and a clean return to the grid.',
    motif: 'logic',
  },
  {
    slug: 'sumweave',
    name: 'Sumweave',
    screen: 'sumweave',
    mark: '+',
    color: '#ff7a66',
    soft: '#ffb8a9',
    copy: 'Trace arithmetic paths and make every total resolve across one woven board.',
    motif: 'number',
  },
  {
    slug: 'word-search',
    name: 'Word Search',
    screen: 'word-search',
    mark: 'W',
    color: '#69d5ff',
    soft: '#a7e7ff',
    copy: 'A bright field of letters, a quiet list of targets, and the satisfaction of finding the last one.',
    motif: 'word',
  },
  {
    slug: 'letter-sprint',
    name: 'Letter Sprint',
    screen: 'letter-sprint',
    mark: '→',
    color: '#ff7cc8',
    soft: '#ffb4dd',
    copy: 'Build words at speed and keep the chain moving while the board asks for one more.',
    motif: 'speed',
  },
  {
    slug: 'wordfoundry',
    name: 'Wordfoundry',
    screen: 'wordfoundry',
    mark: 'A',
    color: '#b890ff',
    soft: '#d8c7ff',
    copy: 'Turn a compact set of letters over and over until every possible word has taken shape.',
    motif: 'forge',
  },
  {
    slug: 'grid-blast',
    name: 'Grid Blast',
    screen: 'grid-blast',
    mark: '■',
    color: '#77e6ac',
    soft: '#b3f5cf',
    copy: 'Place blocks, open space and keep the board breathing one careful move at a time.',
    motif: 'block',
  },
  {
    slug: 'pixel-flow',
    name: 'Pixel Flow',
    screen: 'pixel-flow',
    mark: '◆',
    color: '#ff9f58',
    soft: '#ffd0a4',
    copy: 'Route color through compact pixel puzzles where every move changes the picture.',
    motif: 'pixel',
  },
  {
    slug: 'neon-drop',
    name: 'Neon Drop',
    screen: 'neon-drop',
    mark: '↓',
    color: '#8d8bff',
    soft: '#c3c1ff',
    copy: 'Drop, rotate and clear inside a neon playfield built for the rhythm of one more run.',
    motif: 'drop',
  },
] as const;

const pageTitle = 'Cortex — Eight native games in one vivid hub';
const description =
  'Cortex is an iPhone-only games hub from Nintek: eight native games, optional Game Center and no Nintek account or backend.';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Cortex',
  applicationCategory: 'GameApplication',
  operatingSystem: 'iOS 18 or later',
  description,
  identifier: 'com.nintek.cortex',
  url: 'https://www.nintek.com/cortex',
};
---

<BaseLayout
  bare
  boardFonts
  path="/cortex"
  title={pageTitle}
  description={description}
  themeColor="#080b1d"
  socialImage={hubImage.src}
  socialImageAlt="Cortex game hub on iPhone"
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <!--
    THESIS: Cortex is an arcade constellation, not a catalogue grid; the real hub is the center of gravity and every game becomes its own vivid world.
    OWN-WORLD: Ink-blue space, saturated game fields, crisp ivory type, black device frames, and small geometric game marks tied back to Nintek copper.
    STORY: See the real hub, move through all eight real game homes, understand optional Game Center and the absence of a Nintek backend, then continue into Nintek's iOS story.
    FIRST VIEWPORT: Editorial copy occupies the left half while the actual Cortex hub rises in a large tilted iPhone on the right, surrounded by orbiting game marks and deep color fields.
    FORM: The fourth grounded structure, staged as an arcade constellation in depth with scroll resolving one game plane at a time; seed 2ff57945.
  -->
  <div class="cx-root">
    <div class="cx-progress" aria-hidden="true"><span></span></div>

    <header class="cx-nav">
      <div class="cx-shell cx-nav-inner">
        <div class="cx-nav-brand">
          <NintekBack />
          <a class="cx-wordmark" href="/cortex" aria-label="Cortex home">
            <img src="/apps/cortex.png" alt="" width="34" height="34" />
            <span>Cortex</span>
          </a>
        </div>
        <nav aria-label="Cortex">
          <a href="#games">The eight</a>
          <a href="#native">Under the hood</a>
          <a class="cx-nav-cta" href="/ios#cortex">Nintek on iOS</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="cx-hero" aria-labelledby="cortex-title">
        <div class="cx-aurora cx-aurora-one" data-parallax data-speed="-0.055"></div>
        <div class="cx-aurora cx-aurora-two" data-parallax data-speed="0.035"></div>
        <div class="cx-grid-floor" aria-hidden="true"></div>

        <div class="cx-particle cx-particle-arcade" data-parallax data-speed="-0.09" aria-hidden="true">
          <span></span><span></span><span></span><span></span>
        </div>
        <div class="cx-particle cx-particle-letter" data-parallax data-speed="0.08" aria-hidden="true">W</div>
        <div class="cx-particle cx-particle-plus" data-parallax data-speed="-0.04" aria-hidden="true">+</div>
        <div class="cx-particle cx-particle-block" data-parallax data-speed="0.06" aria-hidden="true"><span></span></div>

        <div class="cx-shell cx-hero-grid">
          <div class="cx-hero-copy">
            <p class="cx-platform">TestFlight beta · iPhone only</p>
            <h1 id="cortex-title">
              Eight games.
              <span>One vivid little universe.</span>
            </h1>
            <p class="cx-hero-lede">
              Cortex brings wordplay, number puzzles, falling blocks and pixel
              logic into one native iPhone hub. Game Center is optional. A Cortex
              account and Nintek backend are not part of the experience.
            </p>
            <div class="cx-hero-actions">
              <a class="cx-button cx-button-primary" href="#games">
                Meet all eight
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M10 3v13m0 0 5-5m-5 5-5-5" />
                </svg>
              </a>
              <a class="cx-button cx-button-secondary" href="/ios#cortex">
                Explore Nintek on iOS
              </a>
            </div>
            <dl class="cx-hero-facts" aria-label="Cortex facts">
              <div><dt>Platform</dt><dd>iPhone</dd></div>
              <div><dt>Games</dt><dd>8 native</dd></div>
              <div><dt>Apple play</dt><dd>Game Center · optional</dd></div>
            </dl>
          </div>

          <div class="cx-hero-stage" aria-label="The real Cortex home screen">
            <div class="cx-orbit cx-orbit-one" aria-hidden="true"></div>
            <div class="cx-orbit cx-orbit-two" aria-hidden="true"></div>
            <div class="cx-device cx-device-hero" data-tilt>
              <div class="cx-device-button cx-device-button-one"></div>
              <div class="cx-device-button cx-device-button-two"></div>
              <div class="cx-device-screen">
                <CortexScreen
                  screen="hub"
                  alt="Cortex home grid showing Sudoku, Sumweave, Word Search, Letter Sprint, Wordfoundry, Grid Blast, Pixel Flow and Neon Drop"
                  sizes="(max-width: 700px) 74vw, (max-width: 1100px) 42vw, 430px"
                  priority
                />
              </div>
            </div>
            <div class="cx-hero-caption">
              <span class="cx-live-dot"></span>
              Actual Cortex home
            </div>
          </div>
        </div>
      </section>

      <section class="cx-overture" aria-labelledby="overture-title">
        <div class="cx-shell">
          <p class="cx-overture-line">
            Pick a word. Follow a number. Clear a line.
            <strong id="overture-title">Every tile opens somewhere different.</strong>
          </p>
          <div class="cx-game-index" aria-label="Jump to a Cortex game">
            {games.map((game, index) => (
              <a href={`#${game.slug}`} data-game-link={game.slug}>
                <span>{String(index + 1).padStart(2, '0')}</span>
                {game.name}
              </a>
            ))}
          </div>
        </div>
      </section>

      <section id="games" class="cx-games" aria-label="The eight Cortex games">
        {games.map((game, index) => (
          <article
            id={game.slug}
            class:list={['cx-game', index % 2 === 1 && 'cx-game-reverse']}
            style={`--game: ${game.color}; --game-soft: ${game.soft};`}
            data-game-section={game.slug}
          >
            <div class="cx-game-field" aria-hidden="true">
              <span class={`cx-motif cx-motif-${game.motif}`}>{game.mark}</span>
              <span class="cx-game-orb" data-parallax data-speed={index % 2 === 0 ? '-0.035' : '0.035'}></span>
            </div>
            <div class="cx-shell cx-game-grid">
              <div class="cx-game-copy reveal">
                <div class="cx-game-count">{String(index + 1).padStart(2, '0')} / 08</div>
                <h2>{game.name}</h2>
                <p>{game.copy}</p>
                <a href={`#${games[(index + 1) % games.length].slug}`} class="cx-next-game">
                  {index === games.length - 1 ? 'Back to Sudoku' : `Next: ${games[index + 1].name}`}
                  <span aria-hidden="true">↘</span>
                </a>
              </div>
              <div class="cx-game-stage reveal">
                <div class="cx-device cx-device-game" data-tilt>
                  <div class="cx-device-button cx-device-button-one"></div>
                  <div class="cx-device-button cx-device-button-two"></div>
                  <div class="cx-device-screen">
                    <CortexScreen
                      screen={game.screen}
                      alt={`${game.name} home screen in the Cortex iOS app`}
                      sizes="(max-width: 700px) 72vw, (max-width: 1100px) 40vw, 390px"
                    />
                  </div>
                </div>
                <span class="cx-screen-label">Actual game home</span>
              </div>
            </div>
          </article>
        ))}
      </section>

      <section id="native" class="cx-native" aria-labelledby="native-title">
        <div class="cx-native-signal" aria-hidden="true">
          <span></span><span></span><span></span><span></span><span></span>
        </div>
        <div class="cx-shell cx-native-grid">
          <div class="cx-native-copy reveal">
            <h2 id="native-title">The arcade ends at the edge of your device.</h2>
            <p>
              Cortex is native on iPhone, keeps detailed play data locally, and
              integrates with optional Apple Game Center. Sudoku statistics can use
              Apple’s private iCloud key-value storage, but there is no Cortex
              account, Nintek API, analytics service, or first-party sync backend.
            </p>
          </div>
          <dl class="cx-native-facts reveal">
            <div>
              <dt>Platform</dt>
              <dd>iPhone</dd>
            </div>
            <div>
              <dt>Minimum version</dt>
              <dd>iOS 18</dd>
            </div>
            <div>
              <dt>Apple services</dt>
              <dd>iCloud KVS + optional Game Center</dd>
            </div>
            <div>
              <dt>Bundle</dt>
              <dd><code>com.nintek.cortex</code></dd>
            </div>
            <div>
              <dt>Nintek backend</dt>
              <dd>None</dd>
            </div>
          </dl>
        </div>
      </section>

      <section class="cx-closing" aria-labelledby="closing-title">
        <div class="cx-closing-stars" aria-hidden="true"></div>
        <div class="cx-shell cx-closing-inner reveal">
          <img src="/apps/cortex.png" alt="" width="88" height="88" />
          <h2 id="closing-title">Eight ways into the zone.</h2>
          <p>
            Cortex is in TestFlight beta for iPhone. There is no public App Store
            listing yet.
          </p>
          <a class="cx-button cx-button-primary" href="/ios#cortex">
            See Cortex in the iOS collection
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </section>
    </main>

    <footer class="cx-footer">
      <div class="cx-shell">
        <a class="cx-footer-brand" href="/">
          <span class="cx-footer-grid" aria-hidden="true">
            {Array.from({ length: 9 }).map(() => <i></i>)}
          </span>
          Nintek
        </a>
        <p>Cortex · Eight native games · iPhone only</p>
        <nav aria-label="Footer">
          <a href="/">All apps</a>
          <a href="/ios">iOS</a>
          <a href={app.privacyPath}>Privacy</a>
          <a href={app.supportPath}>Support</a>
        </nav>
      </div>
    </footer>
  </div>

  <script>
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const root = document.querySelector<HTMLElement>('.cx-root');
    const progress = document.querySelector<HTMLElement>('.cx-progress span');
    const gameLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-game-link]'));
    const gameSections = Array.from(document.querySelectorAll<HTMLElement>('[data-game-section]'));

    const updateProgress = () => {
      if (!root || !progress) return;
      const total = root.scrollHeight - window.innerHeight;
      const value = total > 0 ? Math.min(1, Math.max(0, window.scrollY / total)) : 0;
      progress.style.transform = `scaleX(${value})`;
    };

    window.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();

    if ('IntersectionObserver' in window) {
      const sectionObserver = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (!visible) return;
          const active = (visible.target as HTMLElement).dataset.gameSection;
          gameLinks.forEach((link) => {
            if (link.dataset.gameLink === active) link.setAttribute('aria-current', 'true');
            else link.removeAttribute('aria-current');
          });
        },
        { rootMargin: '-28% 0px -48% 0px', threshold: [0.1, 0.35, 0.6] }
      );
      gameSections.forEach((section) => sectionObserver.observe(section));
    }

    if (!reduceMotion && window.matchMedia('(pointer: fine)').matches) {
      document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((device) => {
        device.addEventListener('pointermove', (event) => {
          const rect = device.getBoundingClientRect();
          const x = (event.clientX - rect.left) / rect.width - 0.5;
          const y = (event.clientY - rect.top) / rect.height - 0.5;
          device.style.setProperty('--tilt-x', `${(-y * 4).toFixed(2)}deg`);
          device.style.setProperty('--tilt-y', `${(x * 5).toFixed(2)}deg`);
        });
        device.addEventListener('pointerleave', () => {
          device.style.removeProperty('--tilt-x');
          device.style.removeProperty('--tilt-y');
        });
      });
    }
  </script>
</BaseLayout>
