---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NintekBack from '../../components/NintekBack.astro';
import WorkshopShowcase from '../../components/WorkshopShowcase.astro';
import { COMPANY, getApp } from '../../data/apps';
import '../../styles/workshop-landing.css';

const wkApp = getApp('workshop')!;

const journey = [
  {
    title: 'Capture',
    state: 'Idea',
    body:
      'Paste a plan URL from Kreg, Ana White or Shaper Hub and it comes back as a structured project — title, difficulty, wood types, and a cut list with real dimensions. Everything arrives pre-filled and stays editable.',
  },
  {
    title: 'Plan the cuts',
    state: 'Planning',
    body:
      'The optimiser runs a real board-layout pass over your parts — kerf and stock dimensions included — and shows the boards it would buy and the offcuts it would leave. Print it as a monospace manifest or export the sheets as a PDF.',
  },
  {
    title: 'Build',
    state: 'In progress',
    body:
      'A timestamped build log with photos, a materials list that rolls up into one shopping list across every active project, and finish records for the stain and topcoat schedule — including the recoat window.',
  },
  {
    title: 'Keep the record',
    state: 'Complete',
    body:
      'The record outlives the build. Come back in two years and the dimensions, the offcuts, the finish schedule and the photographs are all still there — and any project can be saved as a template and cloned into the next one.',
  },
];

const manifest = [
  { row: 'Cut list', detail: 'Parts with fractional dimensions, quantities, material, and kerf.' },
  { row: 'Cut plan', detail: 'A guillotine packing optimiser over your real stock, with yield and offcuts.' },
  { row: 'Materials', detail: 'Per-project material lists that consolidate into one shopping list.' },
  { row: 'Build log', detail: 'Timestamped entries with photographs of the work as it happened.' },
  { row: 'Finish records', detail: 'Stain, topcoat, application notes, and the schedule behind each finish.' },
  { row: 'Shaper Hub', detail: 'A parallel project type for CNC work — parts, bit info and design files.' },
  { row: 'Notebook', detail: 'An editable window onto Tabloom, synced as Markdown both ways.' },
  { row: 'Conversion tables', detail: 'A live mm ↔ inch calculator and fractional reference tables.' },
  { row: 'Templates', detail: 'Save any project as a template and clone it into a fresh build.' },
  { row: 'Command palette', detail: 'Search and navigate the whole shop record from ⌘K.' },
  { row: 'Account controls', detail: 'Sign in with Microsoft, download a JSON project summary, or permanently delete the current workspace from Settings.' },
];
const pageTitle = 'Workshop — Keep the whole build connected.';
const pageDescription =
  'Workshop connects woodworking plans, cut lists, materials, shopping and build records in an online account-backed web workspace.';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Workshop',
  applicationCategory: 'LifestyleApplication',
  operatingSystem: 'Web browser',
  description: pageDescription,
  url: 'https://www.nintek.com/workshop',
};
---

<BaseLayout
  bare
  path="/workshop"
  title={pageTitle}
  description={pageDescription}
  socialImage="/social/workshop.png"
  socialImageAlt="Workshop social preview with its canonical icon and a current web project capture"
  socialImageWidth={1200}
  socialImageHeight={630}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <!--
    THESIS: Workshop marketing becomes a living plan table built from the current running apps, refusing the retired departure-board imitation.
    OWN-WORLD: Cool vellum, deep spruce structure, a functional 24px drafting grid, pencil-blue annotations, restrained amber actions, and soft 14/24px geometry.
    STORY: Visitors see the current web workspace first, then follow the project journey, exact browser capabilities, and account-control boundaries.
    FIRST VIEWPORT: A slim product nav sits above a two-column field; direct copy and actions occupy the left while the current web app fills the right at readable scale.
    FORM: A pinned Living Plan Table evidence stack; product source fixed the direction, so no concept seed or staging roll was used.
  -->
  <div class="wk-root">
    <nav class="wk-nav" aria-label="Workshop">
      <div class="wk-nav-inner">
        <NintekBack />
        <a class="wk-brand" href="/workshop" aria-label="Workshop home">
          <img src="/apps/workshop.png" alt="" width="42" height="42" />
          <span>
            <strong>Workshop</strong>
            <small>Project Companion</small>
          </span>
        </a>
        <a class="wk-nav-link" href="https://workshop.nintek.com">Open Workshop</a>
      </div>
    </nav>

    <main>
      <header class="wk-hero">
        <div class="wk-wrap wk-hero-grid">
          <div class="wk-hero-copy">
            <h1>Keep the whole build connected.</h1>
            <p>
              Workshop turns every build into one durable record: the plan, the
              cut list, the optimized board layout, the materials, the progress
              photos, and the finish schedule. It stays legible from first idea
              to final coat.
            </p>
            <ul class="wk-hero-facts" aria-label="Workshop availability">
              <li>Web app</li>
              <li>Online and account-backed</li>
              <li>Read-only demo available</li>
            </ul>
            <p class="wk-delivery-note">
              <strong>Web delivery:</strong> Workshop is an online, account-backed
              workspace. It is not an installable or offline PWA, and it does not
              promise background reminders.
            </p>
            <div class="wk-actions">
              <a class="wk-action primary" href="https://workshop.nintek.com">Open Workshop</a>
              <a class="wk-action secondary" href="/workshop/privacy">Read the privacy policy</a>
            </div>
          </div>

          <WorkshopShowcase eager />
        </div>
      </header>

      <section class="wk-section">
        <div class="wk-wrap">
          <div class="wk-section-head">
            <h2>One record from plan to finish.</h2>
            <p>
              The project stays editable at every stage; generated structure
              never replaces the maker&rsquo;s judgment.
            </p>
          </div>
          <ol class="wk-journey">
            {
              journey.map((step) => (
                <li>
                  <div class="wk-step-head">
                    <h3>{step.title}</h3>
                    <span>{step.state}</span>
                  </div>
                  <p>{step.body}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <section class="wk-section">
        <div class="wk-wrap">
          <div class="wk-section-head">
            <h2>What the web workspace holds.</h2>
            <p>
              Each tool stays connected to the same browser-based project record.
            </p>
          </div>
          <div
            class="wk-table-wrap"
            role="region"
            aria-label="Workshop capability table"
            tabindex="0"
          >
            <table class="wk-manifest">
              <thead>
                <tr>
                  <th scope="col">Section</th>
                  <th scope="col">Detail</th>
                </tr>
              </thead>
              <tbody>
                {
                  manifest.map((item) => (
                    <tr>
                      <td>{item.row}</td>
                      <td>{item.detail}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>
      </section>

    </main>

    <footer class="wk-footer">
      <div class="wk-wrap wk-footer-inner">
        <img src="/apps/workshop.png" alt="Workshop icon" width="82" height="82" />
        <div>
          <h2>The record outlives the build.</h2>
          <p>
            One workspace for every dimension, offcut, photograph, and coat of
            finish — still legible years after the sawdust is swept up.
          </p>
          <div class="wk-actions">
            <a class="wk-action primary" href="https://workshop.nintek.com">Open Workshop</a>
            <a class="wk-action secondary" href={`mailto:${COMPANY.email}?subject=Workshop`}>Contact Nintek</a>
          </div>
          <p class="wk-legal">
            <a href={wkApp.supportPath}>Workshop Support</a>
            · <a href={wkApp.privacyPath}>Privacy</a>
            · <a href={wkApp.termsPath}>Terms</a>
            · <a href={`mailto:${COMPANY.email}`}>Contact Nintek</a>
          </p>
        </div>
      </div>
    </footer>
  </div>
</BaseLayout>
