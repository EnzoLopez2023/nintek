---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NintekBack from '../../components/NintekBack.astro';
import '../../styles/workshop-landing.css';

/* ── Hero project cards (final, settled fan-out) ── */
const heroCards = [
  { title: 'Walnut Floating Shelf', status: 'In Progress', parts: 6,  hours: '~12h', accent: '#A0522D' },
  { title: 'Garage Workbench',      status: 'Planning',    parts: 14, hours: '~28h', accent: '#7C3E1F' },
  { title: 'Cedar Planter Box',     status: 'Complete',    parts: 8,  hours: '6h',   accent: '#5a7a3a' },
];

/* ── URL-paste demo, rendered in its final extracted state ── */
const demo = {
  url:       'shaper.studio/projects/walnut-floating-shelf',
  name:      'Walnut Floating Shelf',
  parts:     6,
  boards:    2,
  hours:     12,
  materials: 'Walnut, Cherry',
  cuts:      [91, 76],
};

const demoStats = [
  { v: String(demo.parts),  l: 'Parts'     },
  { v: String(demo.boards), l: 'Boards'    },
  { v: `${demo.hours}h`,    l: 'Est. time' },
  { v: demo.materials,      l: 'Materials' },
];

/* ── Three pillars: Plan / Build / Curate ── */
const pillars = [
  {
    icon: '📐',
    label: 'Plan',
    headline: 'Cut lists that\ndo the math.',
    body: 'Enter your dimensions and available stock — Workshop generates an optimized cut plan, calculates waste, and tells you exactly how many boards to buy.',
  },
  {
    icon: '🔨',
    label: 'Build',
    headline: 'Log every step,\nforget nothing.',
    body: 'Timestamped build entries with photos and finish records. Your complete project history — what you used, what worked, what to do differently next time.',
  },
  {
    icon: '📖',
    label: 'Curate',
    headline: 'Import projects,\nnot screenshots.',
    body: 'Paste a Shaper Hub link and Workshop extracts the full part list automatically. A connected notebook keeps your ideas and reference material alongside every build.',
  },
];

/* ── Supporting features ── */
const supporting = [
  { icon: '🛒', title: 'Shopping List',  desc: 'Materials consolidated across every active build. Check items off as you shop.' },
  { icon: '📷', title: 'Finish Records', desc: 'Log your stain, topcoat, and application notes. Never forget what worked.' },
  { icon: '📖', title: 'Notebook',       desc: 'A connected freeform layer for ideas, reference material, and project notes.' },
  { icon: '🔗', title: 'Shaper Hub',     desc: 'Direct import from Shaper Origin projects — parts, dimensions, bit info pre-filled.' },
];

/* ── Detail strip ── */
const details = [
  { icon: '🔒', title: 'Private by default', desc: 'Your own per-user data store — your projects stay yours.' },
  { icon: '📱', title: 'Works everywhere',   desc: 'Responsive across phone, tablet, and desktop.' },
  { icon: '⚡', title: 'Instant save',        desc: 'Every change persisted automatically. Nothing slips through.' },
  { icon: '🌙', title: 'Dark mode ready',     desc: 'A warm palette that holds up in any light.' },
];
---

<BaseLayout
  bare
  noindex
  path="/workshop"
  title="Workshop — From rough sketch to finished build."
  description="A single-user companion for woodworking. Cut lists, build logs, Shaper Hub imports, and an AI that fills in the details — so you can spend less time planning and more time building."
>
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600;1,700&family=Inter:wght@400;500;600;700&display=swap"
  />

  <div class="landing-root">
    {/* ── Sticky glass nav (brand only) ── */}
    <nav class="landing-nav">
      <NintekBack />
      <div class="landing-nav-brand">
        <svg class="landing-nav-icon" viewBox="0 0 180 180" role="img" aria-label="The Workshop">
          <defs>
            <linearGradient id="wk-bg" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#D49A5C" />
              <stop offset="1" stop-color="#3D2817" />
            </linearGradient>
            <radialGradient id="wk-top" cx="50%" cy="-15%" r="85%">
              <stop offset="0" stop-color="#fff" stop-opacity="0.55" />
              <stop offset="0.55" stop-color="#fff" stop-opacity="0" />
            </radialGradient>
          </defs>
          <rect width="180" height="180" rx="42" fill="url(#wk-bg)" />
          <rect width="180" height="180" rx="42" fill="url(#wk-top)" />
          <g
            transform="translate(28.35 28.35) scale(5.137)"
            fill="none"
            stroke="#ffffff"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m15 12-9.373 9.373a1 1 0 0 1-3.001-3L12 9" />
            <path d="m18 15 4-4" />
            <path d="m21.5 11.5-1.914-1.914A2 2 0 0 1 19 8.172v-.344a2 2 0 0 0-.586-1.414l-1.657-1.657A6 6 0 0 0 12.516 3H9l1.243 1.243A6 6 0 0 1 12 8.485V10l2 2h1.172a2 2 0 0 1 1.414.586L18.5 14.5" />
          </g>
        </svg>
        <span>The Workshop</span>
      </div>
    </nav>

    {/* ── Hero — centered ── */}
    <section class="landing-hero">
      <div class="landing-hero-copy">
        <p class="landing-eyebrow">
          <span class="eyebrow-dot"></span>
          Plan · Build · Curate
        </p>

        <h1 class="landing-h1">
          From rough sketch
          <br />
          <em class="landing-h1-accent">to finished build.</em>
        </h1>

        <p class="landing-sub">
          A single-user companion for woodworking. Cut lists, build logs,
          Shaper Hub imports, and an AI that fills in the details — so you
          can spend less time planning and more time building.
        </p>
      </div>

      {/* Project cards spread out like folders on a workbench */}
      <div class="hero-cards">
        {heroCards.map((card) => (
          <div class="hero-card" style={`--card-accent:${card.accent}`}>
            <div class="hero-card-status">
              <span class="hero-card-dot" style={`background:${card.accent}`}></span>
              <span style={`color:${card.accent}`}>{card.status}</span>
            </div>
            <div class="hero-card-title">{card.title}</div>
            <div class="hero-card-meta">
              <span>{card.parts} parts</span>
              <span class="hero-card-sep">·</span>
              <span>{card.hours} est.</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    {/* ── Scroll cue ── */}
    <div class="scroll-hint">
      <span>↓</span>
    </div>

    {/* ── Three pillars: Plan / Build / Curate ── */}
    <section class="landing-pillars">
      {pillars.map((p) => (
        <div class="pillar-card">
          <span class="pillar-icon">{p.icon}</span>
          <span class="pillar-label">{p.label}</span>
          <h3 class="pillar-headline">{p.headline}</h3>
          <p class="pillar-body">{p.body}</p>
        </div>
      ))}
    </section>

    {/* ── URL paste / AI import ── */}
    <section class="landing-paste-section">
      <div class="paste-section-inner">
        <div class="paste-copy">
          <span class="paste-pill">✨ AI Import</span>
          <h2 class="paste-h2">
            Drop a link.
            <br />
            Get a <em>cut plan</em>.
          </h2>
          <p class="paste-desc">
            Paste any Shaper Hub project URL. Workshop's AI reads the page,
            extracts every part and dimension, and generates your cut list —
            ready to print and take to the shop.
          </p>
          <ul class="paste-bullets">
            <li><span class="bullet-dot"></span>Parts, dimensions, and bit info auto-extracted</li>
            <li><span class="bullet-dot"></span>Cut plan optimized for your available stock</li>
            <li><span class="bullet-dot"></span>Materials and build-time estimate included</li>
          </ul>
        </div>

        <div class="paste-demo-wrap">
          <div class="paste-demo">
            {/* URL input row — shown in its final, analyzed state */}
            <div class="paste-field-wrap">
              <div class="paste-field paste-field--active">
                <span class="paste-icon">🔗</span>
                <div class="paste-url-area">
                  <span class="paste-url-text">{demo.url}</span>
                </div>
                <div class="paste-check">✓</div>
              </div>
            </div>

            {/* Extracted results */}
            <div class="paste-results">
              <div class="paste-result-name">{demo.name}</div>

              <div class="paste-stats">
                {demoStats.map((s) => (
                  <div class="paste-stat">
                    <span class="paste-stat-val">{s.v}</span>
                    <span class="paste-stat-lbl">{s.l}</span>
                  </div>
                ))}
              </div>

              <div class="paste-cut-plan">
                <span class="paste-cut-lbl">Cut plan generated</span>
                <div class="paste-boards">
                  {demo.cuts.map((pct) => (
                    <div class="paste-board-row">
                      <div class="paste-board-fill" style={`width:${pct}%`}></div>
                      <div class="paste-board-waste" style={`width:${100 - pct}%`}></div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ── Supporting features ── */}
    <section class="landing-supporting">
      <div class="supporting-grid">
        {supporting.map((f) => (
          <div class="supporting-card">
            <span class="supporting-icon">{f.icon}</span>
            <h4 class="supporting-title">{f.title}</h4>
            <p class="supporting-desc">{f.desc}</p>
          </div>
        ))}
      </div>
    </section>

    {/* ── Detail strip ── */}
    <section class="landing-details">
      {details.map((item) => (
        <div class="detail-item">
          <span class="detail-icon">{item.icon}</span>
          <div>
            <strong>{item.title}</strong>
            <p>{item.desc}</p>
          </div>
        </div>
      ))}
    </section>

    {/* ── Bottom strip ── */}
    <section class="landing-bottom-cta">
      <div class="bottom-cta-inner">
        <svg class="bottom-cta-icon" viewBox="0 0 180 180" role="img" aria-label="The Workshop">
          <defs>
            <linearGradient id="wk-bg2" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#D49A5C" />
              <stop offset="1" stop-color="#3D2817" />
            </linearGradient>
            <radialGradient id="wk-top2" cx="50%" cy="-15%" r="85%">
              <stop offset="0" stop-color="#fff" stop-opacity="0.55" />
              <stop offset="0.55" stop-color="#fff" stop-opacity="0" />
            </radialGradient>
          </defs>
          <rect width="180" height="180" rx="42" fill="url(#wk-bg2)" />
          <rect width="180" height="180" rx="42" fill="url(#wk-top2)" />
          <g
            transform="translate(28.35 28.35) scale(5.137)"
            fill="none"
            stroke="#ffffff"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m15 12-9.373 9.373a1 1 0 0 1-3.001-3L12 9" />
            <path d="m18 15 4-4" />
            <path d="m21.5 11.5-1.914-1.914A2 2 0 0 1 19 8.172v-.344a2 2 0 0 0-.586-1.414l-1.657-1.657A6 6 0 0 0 12.516 3H9l1.243 1.243A6 6 0 0 1 12 8.485V10l2 2h1.172a2 2 0 0 1 1.414.586L18.5 14.5" />
          </g>
        </svg>
        <h2 class="bottom-cta-h2">Your next project is waiting.</h2>
        <p class="bottom-cta-sub">
          Cut lists, build logs, and Shaper Hub imports — your whole
          workshop, organized in one place.
        </p>
        <p class="landing-privacy-note">
          Questions about your data? Read the <a href="/workshop/privacy">Workshop Privacy Policy</a>.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>
