---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NintekBack from '../../components/NintekBack.astro';
import WorkshopShowcase from '../../components/WorkshopShowcase.astro';
import { COMPANY, getApp, NATIVE_STATUS_LABELS } from '../../data/apps';
import '../../styles/workshop-landing.css';

const wkApp = getApp('workshop')!;
const wkNative = wkApp.native!;

const journey = [
  {
    title: 'Capture',
    state: 'Idea',
    body:
      'Paste a plan URL from Kreg, Ana White or Shaper Hub and it comes back as a structured project — title, difficulty, wood types, and a cut list with real dimensions. Everything arrives pre-filled and stays editable.',
  },
  {
    title: 'Plan the cuts',
    state: 'Planning',
    body:
      'The optimiser runs a real board-layout pass over your parts — kerf and stock dimensions included — and shows the boards it would buy and the offcuts it would leave. Print it as a monospace manifest or export the sheets as a PDF.',
  },
  {
    title: 'Build',
    state: 'In progress',
    body:
      'A timestamped build log with photos, a materials list that rolls up into one shopping list across every active project, and finish records for the stain and topcoat schedule — including the recoat window.',
  },
  {
    title: 'Keep the record',
    state: 'Complete',
    body:
      'The record outlives the build. Come back in two years and the dimensions, the offcuts, the finish schedule and the photographs are all still there — and any project can be saved as a template and cloned into the next one.',
  },
];

const manifest = [
  { row: 'Starter workspace', detail: 'Four complete woodworking projects and three Shaper projects, with original plans, parts, materials and instructions.', where: 'iOS' },
  { row: 'Cut list', detail: 'Parts with fractional dimensions, quantities, material, and kerf.', where: 'Web · iOS' },
  { row: 'Cut plan', detail: 'A guillotine packing optimiser over your real stock, with yield and offcuts.', where: 'Web · iOS' },
  { row: 'Materials', detail: 'Per-project material lists that consolidate into one shopping list.', where: 'Web · iOS' },
  { row: 'Build log', detail: 'Timestamped entries with photographs of the work as it happened.', where: 'Web · iOS' },
  { row: 'Finish records', detail: 'Stain, topcoat and application notes, with recoat reminders on iOS.', where: 'Web · iOS' },
  { row: 'Shaper Hub', detail: 'A parallel project type for CNC work — parts, bit info and design files.', where: 'Web · iOS' },
  { row: 'Notebook', detail: 'An editable window onto Tabloom, synced as Markdown both ways.', where: 'Web' },
  { row: 'Conversion tables', detail: 'A live mm ↔ inch calculator and fractional reference tables.', where: 'Web · iOS' },
  { row: 'Templates', detail: 'Save any project as a template and clone it into a fresh build.', where: 'Web · iOS' },
  { row: 'Command palette', detail: 'Search and navigate the whole shop record from ⌘K.', where: 'Web' },
  { row: 'Appearance', detail: 'Five text sizes, five selectable annotation colors, light and dark appearances, and reduced-motion support.', where: 'iOS' },
  { row: 'System surfaces', detail: 'Widgets, Live Activities, Spotlight, Siri, Handoff, and finish reminders.', where: 'iOS' },
  { row: 'Account ownership', detail: 'Sign in with Apple or Microsoft, export a JSON project summary, and permanently delete the Workshop account in-app.', where: 'iOS' },
  { row: 'Insights', detail: 'Spend over time, cost by project, and how often you are in the shop.', where: 'iOS' },
];
const pageTitle = 'Workshop — Keep the whole build connected.';
const pageDescription =
  'Workshop connects woodworking plans, cut lists, materials, shopping and build records in an online account-backed web workspace.';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Workshop',
  applicationCategory: 'LifestyleApplication',
  operatingSystem: 'Web browser, iOS 17 or later, iPadOS 17 or later',
  description: pageDescription,
  identifier: wkApp.bundleId,
  url: 'https://www.nintek.com/workshop',
};
---

<BaseLayout
  bare
  path="/workshop"
  title={pageTitle}
  description={pageDescription}
  socialImage="/social/workshop.png"
  socialImageAlt="Workshop social preview with its canonical icon and a current web project capture"
  socialImageWidth={1200}
  socialImageHeight={630}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <!--
    THESIS: Workshop marketing becomes a living plan table built from the current running apps, refusing the retired departure-board imitation.
    OWN-WORLD: Cool vellum, deep spruce structure, a functional 24px drafting grid, pencil-blue annotations, restrained amber actions, and soft 14/24px geometry.
    STORY: Visitors see the current web workspace first, then fresh read-only Simulator proof from iPhone and iPad, the project journey, exact capabilities, and an honest withdrawn-for-rework release state.
    FIRST VIEWPORT: A slim product nav sits above a two-column field; direct copy and actions occupy the left while the current web app fills the right at readable scale.
    FORM: A pinned Living Plan Table evidence stack; product source fixed the direction, so no concept seed or staging roll was used.
  -->
  <div class="wk-root">
    <nav class="wk-nav" aria-label="Workshop">
      <div class="wk-nav-inner">
        <NintekBack />
        <a class="wk-brand" href="/workshop" aria-label="Workshop home">
          <img src="/apps/workshop.png" alt="" width="42" height="42" />
          <span>
            <strong>Workshop</strong>
            <small>Project Companion</small>
          </span>
        </a>
        <a class="wk-nav-link" href="#inside-workshop">Actual screens</a>
      </div>
    </nav>

    <main>
      <header class="wk-hero">
        <div class="wk-wrap wk-hero-grid">
          <div class="wk-hero-copy">
            <h1>Keep the whole build connected.</h1>
            <p>
              Workshop turns every build into one durable record: the plan, the
              cut list, the optimized board layout, the materials, the progress
              photos, and the finish schedule. It stays legible from first idea
              to final coat.
            </p>
            <ul class="wk-hero-facts" aria-label="Workshop availability">
              <li>Web app</li>
              <li>{NATIVE_STATUS_LABELS[wkNative.status]}</li>
              <li>Seven complete starter builds</li>
            </ul>
            <p class="wk-release-note">
              The native release is withdrawn while product rework continues.
              There is no public App Store listing, TestFlight acquisition link,
              or announced price. The web workspace and the current private build
              are shown here as separate, dated evidence.
            </p>
            <p class="wk-delivery-note">
              <strong>Web delivery:</strong> Workshop is an online, account-backed
              workspace. It is not an installable or offline PWA, and the web page
              does not promise background reminders. The native app is a separate
              client with its own release state.
            </p>
            <div class="wk-actions">
              <a class="wk-action primary" href="#inside-workshop">Explore real screens</a>
              <a class="wk-action secondary" href="/workshop/privacy">Read the privacy policy</a>
            </div>
          </div>

          <WorkshopShowcase variant="web" eager />
        </div>
      </header>

      <section class="wk-section" id="the-native-app">
        <div class="wk-wrap wk-proof-grid">
          <div class="wk-section-copy">
            <h2>The shop record finally fits the shop.</h2>
            <p>
              These are fresh Simulator captures from the current SwiftUI build
              running in read-only demo mode—not product sketches or stale App
              Store cards. iPhone keeps the next action close to your thumb. iPad
              opens separate Projects and Shaper Hub workspaces.
            </p>
            <dl class="wk-proof-points">
              <div>
                <dt>Start full</dt>
                <dd>New accounts open to seven complete builds with original plan art, real parts, materials, costs, and instructions.</dd>
              </div>
              <div>
                <dt>Work anywhere</dt>
                <dd>The cut list follows you to the Lock Screen; the shopping list follows you down the aisle; the project record waits on every device.</dd>
              </div>
              <div>
                <dt>Own the record</dt>
                <dd>Sign in with Apple or Microsoft, export a portable JSON project summary, or permanently delete the account from inside the app.</dd>
              </div>
            </dl>
          </div>
          <WorkshopShowcase />
        </div>
      </section>

      <section class="wk-section">
        <div class="wk-wrap">
          <div class="wk-section-head">
            <h2>One record from plan to finish.</h2>
            <p>
              The project stays editable at every stage; generated structure
              never replaces the maker&rsquo;s judgment.
            </p>
          </div>
          <ol class="wk-journey">
            {
              journey.map((step) => (
                <li>
                  <div class="wk-step-head">
                    <h3>{step.title}</h3>
                    <span>{step.state}</span>
                  </div>
                  <p>{step.body}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <section class="wk-section">
        <div class="wk-wrap">
          <div class="wk-section-head">
            <h2>More than a notes app with sawdust on it.</h2>
            <p>
              Workshop earns the structure it adds: one mechanism turns source
              material into an editable project, and another turns measured parts
              into stock layouts you can act on.
            </p>
          </div>

          <div class="wk-mechanisms">
            <article class="wk-mechanism">
              <div class="wk-mechanism-copy">
                <h3>Paste a link, get a project.</h3>
                <p>
                  Drop in any plan page and the app reads it, then hands back a
                  real project: every part, every dimension, the wood types and
                  the materials. Nothing is decided for you — it arrives
                  pre-filled and every field stays editable.
                </p>
              </div>
              <picture class="wk-mechanism-media">
                <source
                  media="(max-width: 430px)"
                  srcset="/apps/workshop/ipad-project-detail-focus.webp"
                />
                <img
                  src="/apps/workshop/ipad-project-detail.webp"
                  alt="Workshop read-only demo on iPad showing the Hand Tool Storage Cabinet project detail, materials, tools, and build notes"
                  width="1548"
                  height="2064"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            </article>

            <article class="wk-mechanism reverse">
              <div class="wk-mechanism-copy">
                <h3>A cut list that becomes a cutting plan.</h3>
                <p>
                  A real board-layout optimiser packs your parts onto the stock
                  you actually have, accounting for kerf and stock dimensions. It
                  tells you how many boards to buy and exactly what it will leave
                  over — the same algorithm on the web and in your hand.
                </p>
              </div>
              <img
                src="/apps/workshop/iphone-projects.webp"
                alt="Workshop read-only demo on iPhone showing the Projects context, active cabinet plan, parts count, and next action"
                width="906"
                height="1970"
                loading="lazy"
                decoding="async"
              />
            </article>
          </div>
        </div>
      </section>

      <section class="wk-section" id="inside-workshop">
        <div class="wk-wrap">
          <div class="wk-section-head">
            <h2>The workspace changes with the job.</h2>
            <p>
              Plan at the desk, carry the project to the bench, and take one
              consolidated list to the store. These fresh iOS 26.5 Simulator
              captures come from the current read-only demo build; Projects and
              Shaper Hub remain separate contexts.
            </p>
          </div>

          <div class="wk-screen-grid">
            <figure>
              <img
                src="/apps/workshop/iphone-shopping.webp"
                alt="Workshop read-only demo on iPhone showing one shopping list grouped by project with quantities and estimated costs"
                width="906"
                height="1970"
                loading="lazy"
                decoding="async"
              />
              <figcaption>
                <strong>One supply run</strong>
                <span>Every active build rolls into one checkable shopping list.</span>
              </figcaption>
            </figure>
            <figure>
              <img
                src="/apps/workshop/iphone-tables.webp"
                alt="Workshop read-only demo on iPhone showing the unit converter and millimeter-to-inch reference table"
                width="906"
                height="1970"
                loading="lazy"
                decoding="async"
              />
              <figcaption>
                <strong>Measure twice, type less</strong>
                <span>Millimeters, decimal inches, and shop fractions stay live at the bench.</span>
              </figcaption>
            </figure>
            <figure class="wide">
              <picture class="wk-screen-picture">
                <source
                  media="(max-width: 720px)"
                  srcset="/apps/workshop/ipad-shaper-focus.webp"
                />
                <img
                  src="/apps/workshop/ipad-shaper.webp"
                  alt="Workshop read-only demo on iPad showing the separate Shaper Hub context, Shaper-only search, and CNC project library"
                  width="1548"
                  height="2064"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
              <figcaption>
                <strong>Projects and Shaper stay separate</strong>
                <span>iPad gives CNC work its own context, search, and project library instead of mixing it into the Projects dashboard.</span>
              </figcaption>
            </figure>
          </div>
        </div>
      </section>

      <section class="wk-section">
        <div class="wk-wrap">
          <div class="wk-section-head">
            <h2>What a project holds.</h2>
            <p>
              The same record crosses the web and native apps without pretending
              every surface has the same job.
            </p>
          </div>
          <div
            class="wk-table-wrap"
            role="region"
            aria-label="Workshop capability table"
            tabindex="0"
          >
            <table class="wk-manifest">
              <thead>
                <tr>
                  <th scope="col">Section</th>
                  <th scope="col">Detail</th>
                  <th scope="col">Where</th>
                </tr>
              </thead>
              <tbody>
                {
                  manifest.map((item) => (
                    <tr>
                      <td>{item.row}</td>
                      <td>{item.detail}</td>
                      <td>{item.where}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="wk-native-section">
        <div class="wk-wrap">
          <div class="wk-native-head">
            <div>
              <h2>The plan leaves the desk.</h2>
              <p>{wkNative.intro}</p>
            </div>
            <div class="wk-native-actions">
              <p class="wk-native-status">
                {NATIVE_STATUS_LABELS[wkNative.status]} · no public acquisition link
              </p>
              <a class="wk-text-link" href="/ios#workshop">More about the native apps</a>
            </div>
          </div>

          <div class="wk-native-grid">
            {
              wkNative.highlights.map((highlight) => (
                <article>
                  <div>
                    <h3>{highlight.title}</h3>
                    <p>{highlight.body}</p>
                  </div>
                </article>
              ))
            }
          </div>

          <details class="wk-tech">
            <summary>Native implementation details</summary>
            <p>{wkNative.tech.join(' · ')}</p>
          </details>
        </div>
      </section>
    </main>

    <footer class="wk-footer">
      <div class="wk-wrap wk-footer-inner">
        <img src="/apps/workshop.png" alt="Workshop icon" width="82" height="82" />
        <div>
          <h2>The record outlives the build.</h2>
          <p>
            One workspace for every dimension, offcut, photograph, and coat of
            finish — still legible years after the sawdust is swept up.
          </p>
          <div class="wk-actions">
            <a class="wk-action primary" href="#inside-workshop">Review current captures</a>
            <a class="wk-action secondary" href={`mailto:${COMPANY.email}?subject=Workshop`}>Contact Nintek</a>
          </div>
          <p class="wk-legal">
            <a href={wkApp.supportPath}>Workshop Support</a>
            · <a href={wkApp.privacyPath}>Privacy</a>
            · <a href={wkApp.termsPath}>Terms</a>
            · <a href={`mailto:${COMPANY.email}`}>Contact Nintek</a>
          </p>
        </div>
      </div>
    </footer>
  </div>
</BaseLayout>
