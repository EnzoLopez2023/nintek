---
import DataLifecycleTable from '../../components/DataLifecycleTable.astro';
import LegalLayout from '../../layouts/LegalLayout.astro';
import { getApp, COMPANY } from '../../data/apps';

const app = getApp('workshop')!;
const effectiveDate = 'August 31, 2026';
const sections = [
  { href: '#scope', label: 'Scope and identity' },
  { href: '#data', label: 'Data processed' },
  { href: '#storage', label: 'Storage and browser data' },
  { href: '#analysis', label: 'Optional URL analysis' },
  { href: '#lifecycle', label: 'Export, deletion, and retention' },
  { href: '#providers', label: 'Providers and sharing' },
  { href: '#contact', label: 'Contact' },
];
const lifecycleRows = [
  {
    data: 'Workshop account identity',
    location: 'The web workspace uses Microsoft sign-in. Existing Apple-backed identities remain isolated from Microsoft-backed Workshop accounts unless a future linking feature explicitly joins them.',
    portability: 'The project-summary export includes no provider credential or complete account profile. Apple and Microsoft provide controls for their own accounts.',
    deletion: 'Account deletion from Workshop Settings removes the current Microsoft-backed identity and data. It does not delete the Microsoft account or a separate existing Apple-backed identity.',
  },
  {
    data: 'Projects, parts, lists, logs, and other structured content',
    location: 'A private per-user SQLite database hosted on Microsoft Azure.',
    portability: 'Settings can download a JSON project-list summary. It omits project detail tables, account state, and uploads and has no import path, so it is not a complete backup.',
    deletion: 'Deleting content removes it from the active account according to the feature. Deleting the account purges the selected per-user database after the service confirms the request.',
  },
  {
    data: 'Photos and uploaded files',
    location: 'Account-scoped upload storage on the Azure-hosted service, separate from the per-user SQLite database.',
    portability: 'The JSON project summary does not include uploads. Keep original files separately if you need an independent copy.',
    deletion: 'Account deletion removes the selected account’s uploads. Historical recovery bundles can retain copies until their scheduled retention expires.',
  },
  {
    data: 'Recovery bundles',
    location: 'Checksummed bundles contain database and upload state. The service keeps seven local daily bundles and publishes protected off-host daily and monthly recovery copies.',
    portability: 'These are operator disaster-recovery artifacts, not user-downloadable account backups.',
    deletion: 'Local copies retain seven bundles. Off-host daily copies use a 30-day window, monthly copies a 366-day window, plus 14-day soft delete. A restore requires manual deletion reconciliation before reopening.',
  },
  {
    data: 'Optional URL-analysis input and output',
    location: 'The requested URL and extracted project material are sent to Anthropic only when you ask Workshop to analyze a project page; the editable result is stored in the selected account if you save it.',
    portability: 'Saved result data follows the project-summary limits above; the source website remains independent.',
    deletion: 'Delete the saved Workshop content or selected account. Anthropic and the source site may retain provider-side records under their own terms.',
  },
  {
    data: 'Browser session data and support mail',
    location: 'Authentication and session data used by the browser and service, plus Nintek’s mailbox if you contact support.',
    portability: 'Session data is not a project backup. You control any support message you send.',
    deletion: 'Account deletion clears the current Workshop workspace after server confirmation. Support mail may be retained for response, security, or legal needs.',
  },
];
---

<LegalLayout
  app={app}
  title={`${app.name} Privacy Policy — ${COMPANY.name}`}
  description="How Workshop handles Microsoft sign-in, existing separate provider-backed identities, per-user Azure databases, uploads, optional Anthropic URL analysis, exports, backups, and account deletion."
  path="/workshop/privacy"
  page="privacy"
  heading="Workshop Privacy Policy"
  documentMeta={`Effective ${effectiveDate} · Last reviewed ${effectiveDate}`}
  summary="Workshop is a private, account-backed woodworking project companion. Its supported client is the online web workspace. Web sign-in uses Microsoft, and existing Apple-backed accounts remain separate."
  sections={sections}
  evidenceNote="Reviewed against the current Workshop web service and recovery runbook on August 31, 2026."
  theme="workshop"
>
  <section id="scope" class="legal-section">
    <h2>Scope and account identity</h2>
    <p>
      This policy explains how {COMPANY.name} (“we”, “us”) handles information in
      the {app.name} web workspace. Workshop is a single-user project companion
      for planning and documenting woodworking and Shaper projects.
    </p>
    <p class="legal-callout">
      The web workspace signs in with Microsoft. Any existing Apple-backed
      Workshop identity remains separate, even when both providers use the same
      email address. Their databases, uploads, exports, and deletion scopes are
      not automatically linked or merged.
    </p>
    <p>
      Workshop does not use third-party advertising, advertising identifiers, or
      cross-app tracking. It processes account, project, file, optional analysis,
      and operational data needed to provide and secure the service.
    </p>
  </section>

  <section id="data" class="legal-section">
    <h2>Information Workshop processes</h2>
    <ul>
      <li>
        <strong>Account information.</strong> A stable provider identifier and the
        basic profile fields Microsoft makes available, such as name and email.
        Existing Apple-backed identities may retain a private relay address and
        encrypted authorization data needed for account revocation.
      </li>
      <li>
        <strong>Project information.</strong> Projects, Shaper projects,
        templates, parts, dimensions, cut plans, stock, materials, shopping lists,
        instructions, costs, progress, build logs, finish records, notes, and
        related settings.
      </li>
      <li>
        <strong>Files.</strong> Project photos, drawings, selected images, and
        other account uploads.
      </li>
      <li>
        <strong>Imported source material.</strong> A URL and the page content
        fetched for analysis when you ask Workshop to turn a project page into an
        editable draft.
      </li>
      <li>
        <strong>Operations.</strong> Request timing, errors, account-lifecycle
        checkpoints, backup manifests, and security records needed to run, restore,
        troubleshoot, and protect the service.
      </li>
    </ul>
  </section>

  <section id="storage" class="legal-section">
    <h2>Server storage and browser data</h2>
    <p>
      Each Workshop account has a private per-user SQLite database. Photos and
      other uploads are kept in account-scoped upload storage. The service runs on
      Microsoft Azure and uses HTTPS in transit. Access is limited to service and
      support operations that require it.
    </p>
    <p>
      Workshop is online-only for account data. A loaded browser page can calculate
      unit conversions locally, but projects, edits, uploads, shopping, logs,
      analysis, and deletion require a live connection. Workshop is not an
      installable or offline PWA, and browser session data is not an independent
      backup.
    </p>
  </section>

  <section id="analysis" class="legal-section">
    <h2>Optional project URL analysis</h2>
    <p>
      Workshop contacts a project URL only when you ask it to analyze that page.
      The server rejects private and loopback network destinations, retrieves the
      public page, removes page markup, and sends the relevant source text to
      Anthropic to produce a structured draft. If the analysis provider is not
      configured or available, the feature returns an error rather than inventing
      a successful result.
    </p>
    <p>
      Review dimensions, materials, safety instructions, and generated details
      against the source before using them in a physical build. Automated project
      extraction is not engineering or safety advice.
    </p>
  </section>

  <section id="lifecycle" class="legal-section">
    <h2>Export, deletion, backups, and retention</h2>
    <p>
      Workshop’s downloadable JSON is a project-list summary, not a complete
      account archive: it omits detail tables, authentication state, and uploads
      and cannot be imported as a restore. Operator recovery bundles are separate
      and exist to recover the service, not to provide a user export.
    </p>
    <p>
      In the web workspace, open Settings, then Account, to permanently delete the
      current Microsoft-backed Workshop workspace. Deletion removes Workshop data
      without deleting the Microsoft account. Any existing Apple-backed workspace
      remains separate; deleting one provider-backed workspace does not delete the
      other. Deletion advances through resumable checkpoints and does not report
      success until provider, database, media, and filesystem cleanup completes. If
      a step fails, some cleanup may already have happened; retry deletion from
      Settings, and contact support if it still cannot complete.
    </p>
    <p>
      The service retains seven local daily recovery bundles. Protected off-host
      daily copies use a 30-day lifecycle and monthly copies a 366-day lifecycle,
      with 14-day soft delete. Restoring a point from before an account deletion
      can resurrect files, so the recovery runbook requires a human operator to
      reconcile later deletions before reopening. That reconciliation is not an
      automated restore feature.
    </p>
    <DataLifecycleTable
      caption="Workshop data lifecycle and account-control boundaries"
      rows={lifecycleRows}
    />
  </section>

  <section id="providers" class="legal-section">
    <h2>Providers, sharing, and account boundaries</h2>
    <p>
      We do not sell personal information. Microsoft provides Azure hosting and
      Microsoft identity. Apple provides authorization and revocation services for
      existing Apple-backed identities. Anthropic processes selected URL-analysis
      inputs. A source website receives an ordinary server request when you ask
      Workshop to analyze it. Each provider handles its part under its own terms
      and legal obligations.
    </p>
    <p>
      Deleting Workshop cannot delete the underlying Apple or Microsoft account,
      provider security records, or source-site logs. Information may also be
      disclosed where required by law or reasonably needed to protect the service.
    </p>
  </section>

  <section id="contact" class="legal-section">
    <h2>Children, changes, and contact</h2>
    <p>
      Workshop is intended for a general adult audience and is not directed to
      children. We do not knowingly create Workshop accounts for children.
    </p>
    <p>
      We may update this policy when the product, providers, release state, or data
      practices change. The dates at the top identify this version.
    </p>
    <p>
      Privacy and data questions can be sent to
      <a href={`mailto:${COMPANY.privacyEmail}`}>{COMPANY.privacyEmail}</a>.
      Product help is available on <a href="/workshop/support">Workshop
      Support</a>. Use of Workshop is subject to the
      <a href="/terms">Nintek Terms of Use</a>.
    </p>
  </section>
</LegalLayout>
