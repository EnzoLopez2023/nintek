---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NintekBack from '../../components/NintekBack.astro';
import '../../styles/tabloom-landing.css';

/* Current Tabloom capabilities, including the archive and bounded offline reader. */
const FEATURES = [
  {
    emoji: '📷',
    title: 'Inkbox',
    desc: 'Snap a photo of your handwritten notes. AI reads the handwriting and files a clean typed page instantly.',
    color: '#2d4a7a',
  },
  {
    emoji: '✍️',
    title: 'Rich Block Editor',
    desc: 'Headings, checklists, callouts, tables, images — every block you need. Keyboard-first with a slash menu.',
    color: '#3f6f4a',
  },
  {
    emoji: '🤖',
    title: 'Ask Your Notes',
    desc: 'Semantic AI search across every page. Ask a question, get an answer grounded in your own writing.',
    color: '#6a7fd6',
  },
  {
    emoji: '📚',
    title: 'Smart Notebooks',
    desc: 'Organize everything into notebooks. Drag to reorder, share with collaborators, keep private.',
    color: '#c08856',
  },
  {
    emoji: '🏷️',
    title: 'Tags & Discovery',
    desc: 'Cross-notebook tagging with color coding. Filter across everything with a single click.',
    color: '#8a6fc7',
  },
  {
    emoji: '🔗',
    title: 'Link Inbox',
    desc: 'Save URLs with titles and snippets auto-fetched. Your reading list, research, clipped articles.',
    color: '#4a9e8f',
  },
  {
    emoji: '📜',
    title: 'Version History',
    desc: 'Every edit is tracked. Restore any previous version of any page with a single click.',
    color: '#c45e5e',
  },
  {
    emoji: '🗄️',
    title: 'Archive & Restore',
    desc: 'Archive pages or whole notebook trees, review them in one place, and restore only what your role allows.',
    color: '#60708d',
  },
  {
    emoji: '📥',
    title: 'Offline Reading',
    desc: 'Explicitly download selected notebooks or recent pages into identity-scoped IndexedDB for bounded, read-only use.',
    color: '#3156d3',
  },
];

/* ── Detail strip (auth/identity copy reworded; no auth words) ── */
const DETAILS = [
  { icon: '🔒', title: 'Private by default', desc: 'Secure single sign-on with your existing identity — no new password to remember.' },
  { icon: '📱', title: 'Installable reader', desc: 'Responsive on mobile, tablet, and desktop, with explicit read-only offline downloads in the PWA.' },
  { icon: '⚡', title: 'Instant save', desc: 'Every keystroke synced. A status pill tells you exactly when.' },
  { icon: '🌙', title: 'Dark mode', desc: "A warm dark theme that's easy on the eyes for late-night writing." },
];

---

<BaseLayout
  bare
  noindex
  path="/tabloom"
  title="Tabloom — A notebook that thinks with you."
  description="A calm editorial workspace with nested notebooks, archive and restore, bounded offline reading, rich blocks, tags, and AI-assisted retrieval."
  socialImage="/apps/tabloom.png"
  socialImageAlt="Tabloom app icon"
>
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    slot="head"
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  />
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Newsreader:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&display=swap"
  />

  <div class="landing-root">
    {/* ── Background orbs ── */}
    <div class="landing-orbs" aria-hidden="true">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="orb orb-3"></div>
    </div>

    {/* ── Nav (brand only) ── */}
    <nav class="landing-nav">
      <NintekBack />
      <div class="landing-nav-brand">
        <img src="/apps/tabloom.svg" alt="" width="22" height="22" />
        <span>Tabloom</span>
      </div>
    </nav>

    {/* ── Hero ── */}
    <section class="landing-hero">
      <div class="landing-hero-left">
        <div class="landing-hero-badge">
          <span class="hero-badge-dot"></span>
          Archive, restore, and read selected notebooks offline
        </div>

        <h1 class="landing-h1">
          The notebook that
          <br />
          <em class="landing-h1-accent">thinks with you.</em>
        </h1>

        <p class="landing-sub">
          Capture fast, find later. A calm editorial workspace with rich blocks,
          archive and restore, bounded offline reading, smart tagging, and
          AI-assisted retrieval.
        </p>
      </div>

      <div class="landing-hero-right">
        <div class="mockup-wrap">
          <figure class="product-shot product-shot-hero">
            <picture>
              <source
                srcset="/apps/tabloom/editor-navigation-960.webp 960w, /apps/tabloom/editor-navigation.webp 1876w"
                sizes="(max-width: 960px) min(480px, 92vw), 48vw"
                type="image/webp"
              />
              <img
                src="/apps/tabloom/editor-navigation.webp"
                alt="Current Tabloom page editor with private notebook content obscured"
                width="1876"
                height="970"
                decoding="async"
              />
            </picture>
            <figcaption>Real current capture · private content obscured</figcaption>
          </figure>
        </div>
      </div>
    </section>

    {/* ── Scroll indicator ── */}
    <div class="scroll-hint">↓</div>

    {/* ── Features ── */}
    <section class="landing-features">
      <div class="section-header">
        <h2 class="section-h2">Everything you need to think clearly.</h2>
        <p class="section-sub">
          Built around the way ideas actually work — quick capture, deep
          reading, and fast retrieval.
        </p>
      </div>

      <div class="features-grid">
        {FEATURES.map((f) => (
          <div class="feature-card">
            <div class="feature-emoji-wrap" style={`background: ${f.color}18;`}>
              <span class="feature-emoji">{f.emoji}</span>
            </div>
            <h3 class="feature-title">{f.title}</h3>
            <p class="feature-desc">{f.desc}</p>
          </div>
        ))}
      </div>
    </section>

    {/* ── Inkbox highlight ── */}
    <section class="landing-inkbox-section">
      <div class="inkbox-section-inner">
        <div class="inkbox-section-left">
          <div class="inkbox-pill">📷 New — Inkbox</div>
          <h2 class="inkbox-section-h2">
            Paper notes,
            <br />
            instantly <em>digital.</em>
          </h2>
          <p class="inkbox-section-p">
            Snap a photo of any handwritten page. Tabloom reads the handwriting
            with Claude AI, generates a smart title, and files a clean typed page
            in your Inkbox notebook — with the original scan and a PDF transcript
            attached.
          </p>
          <ul class="inkbox-bullets">
            <li><span class="inkbox-bullet-dot"></span>Works on any phone — just tap the camera icon</li>
            <li><span class="inkbox-bullet-dot"></span>Handles cursive, messy, and mixed handwriting</li>
            <li><span class="inkbox-bullet-dot"></span>Auto date-tagged and full-text searchable</li>
            <li><span class="inkbox-bullet-dot"></span>PDF transcript generated automatically</li>
          </ul>
        </div>

        <div class="inkbox-section-right">
          <figure class="product-shot product-shot-dark">
            <picture>
              <source
                srcset="/apps/tabloom/page-editor-960.webp 960w, /apps/tabloom/page-editor.webp 1876w"
                sizes="(max-width: 768px) 92vw, 48vw"
                type="image/webp"
              />
              <img
                src="/apps/tabloom/page-editor.webp"
                alt="Current Tabloom editor with private notebook and page content obscured"
                width="1876"
                height="970"
                loading="lazy"
                decoding="async"
              />
            </picture>
            <figcaption>Real current capture · private content obscured</figcaption>
          </figure>
        </div>
      </div>
    </section>

    {/* ── AI highlight ── */}
    <section class="landing-ai-section">
      <div class="ai-section-inner">
        <div class="ai-section-left">
          <div class="ai-pill">✨ AI-Powered</div>
          <h2 class="ai-section-h2">
            Your notes have a memory.
            <br />
            Now they can <em>answer</em>.
          </h2>
          <p class="ai-section-p">
            Ask your notes anything in plain English. Tabloom uses semantic
            embeddings to find the most relevant pages and streams a grounded
            answer — not a generic LLM response, but your own thinking, surfaced.
          </p>
          <ul class="ai-bullets">
            <li>
              <span class="ai-bullet-dot"></span>
              Semantic search over every page you've written
            </li>
            <li>
              <span class="ai-bullet-dot"></span>
              AI summarize, rewrite, expand or shorten any selection
            </li>
            <li>
              <span class="ai-bullet-dot"></span>
              Auto-suggest tags and notebooks as you write
            </li>
          </ul>
        </div>

        <div class="ai-section-right">
          <figure class="product-shot">
            <picture>
              <source
                srcset="/apps/tabloom/editor-navigation-960.webp 960w, /apps/tabloom/editor-navigation.webp 1876w"
                sizes="(max-width: 960px) 92vw, 48vw"
                type="image/webp"
              />
              <img
                src="/apps/tabloom/editor-navigation.webp"
                alt="Current Tabloom page editor with private notebook content obscured"
                width="1876"
                height="970"
                loading="lazy"
                decoding="async"
              />
            </picture>
            <figcaption>Real current capture · private content obscured</figcaption>
          </figure>
        </div>
      </div>
    </section>

    {/* ── Detail strip ── */}
    <section class="landing-details">
      {DETAILS.map((item) => (
        <div class="detail-item">
          <span class="detail-icon">{item.icon}</span>
          <div>
            <strong>{item.title}</strong>
            <p>{item.desc}</p>
          </div>
        </div>
      ))}
    </section>

    {/* ── Bottom (auth removed) ── */}
    <section class="landing-bottom-cta">
      <div>
        <img class="bottom-cta-mark" src="/apps/tabloom.svg" alt="" width="52" height="52" />
        <h2 class="bottom-cta-h2">A workspace that grows with you.</h2>
        <p class="bottom-cta-sub">
          Everything you capture — typed, scanned, clipped, archived, or
          explicitly downloaded for offline reading — organized and ready when
          you are.
        </p>
      </div>
    </section>

    {/* ── Privacy line ── */}
    <p class="landing-privacy-line">
      Questions about your data? Read the
      <a href="/tabloom/privacy">Tabloom Privacy Policy</a>.
    </p>
  </div>
</BaseLayout>
