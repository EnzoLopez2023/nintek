---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhoneMock from '../components/PhoneMock.astro';
import TabletMock from '../components/TabletMock.astro';
import WorkshopShowcase from '../components/WorkshopShowcase.astro';
import Icon from '../components/Icon.astro';
import CairnPhone from '../components/mocks/ios/Cairn.astro';
import ShopKeepPhone from '../components/mocks/ios/ShopKeep.astro';
import WorkshopPhone from '../components/mocks/ios/Workshop.astro';
import CortexPhone from '../components/mocks/ios/Cortex.astro';
import TarePhone from '../components/mocks/ios/Tare.astro';
import SortiePhone from '../components/mocks/ios/Sortie.astro';
import SalvoPad from '../components/mocks/ios/Salvo.astro';
import {
  COMPANY,
  ECOSYSTEM,
  NATIVE_STATUS_LABELS,
  nativeApps,
  nextNativeApp,
} from '../data/apps';
import type { IconKey } from '../data/apps';
import '../styles/ios.css';

const phones: Record<string, any> = {
  cairn: CairnPhone,
  shopkeep: ShopKeepPhone,
  workshop: WorkshopPhone,
  cortex: CortexPhone,
  tare: TarePhone,
  sortie: SortiePhone,
};

const tablets: Record<string, any> = {
  salvo: SalvoPad,
};

const tones: Record<string, 'light' | 'dark' | 'navy' | 'enamel'> = {
  cairn: 'navy',
  shopkeep: 'light',
  cortex: 'dark',
  tare: 'enamel',
  sortie: 'dark',
};

const publicStoreCount = 0;
const watchAppCount = nativeApps.filter((app) => app.native?.watch).length;
const evidenceLabels: Record<string, string> = {
  cairn: 'Synthetic UI study',
  shopkeep: 'Synthetic UI study',
  tare: 'Synthetic UI study',
  cortex: 'Release-build capture',
  sortie: 'Pre-release capture',
};

/** Why the ports are worth doing at all. Each of these is something at least one
 *  of the shipping apps actually does. */
const thesis: { icon: IconKey; title: string; body: string }[] = [
  {
    icon: 'widget',
    title: 'The app before you open it',
    body:
      'Several put something useful on your Home Screen — a study streak, tools that need attention, a build in progress, or a game you were halfway through. Some go further and let you act without opening the full app.',
  },
  {
    icon: 'lock',
    title: 'Live on the Lock Screen',
    body:
      'A timed exam counts down in the Dynamic Island. A cut list sits on your Lock Screen so you can tick off parts at the saw. Live Activities are the difference between an app you check and an app that keeps up with you.',
  },
  {
    icon: 'scan',
    title: 'A camera beats a keyboard',
    body:
      'VisionKit reads a barcode off a box, a QR label off a drawer, or a fraction off a tape measure. Every one of those is a form field you no longer have to fill in with sawdust on your hands.',
  },
  {
    icon: 'gauge',
    title: 'Compute that moved on device',
    body:
      'The cut-plan optimiser and the spaced-repetition scheduler were ported to Swift and unit-tested against the originals. What used to be a server round trip now happens instantly, offline, in your hand.',
  },
  {
    icon: 'sparkle',
    title: 'Siri, Spotlight and Shortcuts',
    body:
      'Ask for a study session, jump straight to the scanner, pull up a project by name from system search, or wire any of it into a Shortcut. The apps became part of the system instead of sitting behind a browser tab.',
  },
  {
    icon: 'ruler',
    title: 'iPad, designed rather than stretched',
    body:
      'Cairn moves its navigation into the title bar on iPad, resolves its card grids to two columns, and holds a measured line length on reading surfaces instead of running the full width of the display. Column minimums are tuned per size class, down to the 11-inch iPad in portrait — the size that quietly collapses to one column if you guess.',
  },
  {
    icon: 'cloud',
    title: 'Less infrastructure, not more',
    body:
      'Cairn, Cortex, Sortie and Salvo keep their core experience off Nintek servers. The two Godot campaigns save on device; Game Center stays optional. Fewer moving parts is a feature, not a compromise.',
  },
  {
    icon: 'book',
    title: 'Each product has its own platform relationship',
    body:
      'Cairn and the web app have separate progress stores. ShopKeep shares its backend across web and native. Tare’s browser product is retired, while production web remains only as the native app’s consent-gated AI relay. The status belongs to each product, not to a blanket “web versus native” promise.',
  },
];
---

<BaseLayout
  title={`Native on iOS — ${COMPANY.name}`}
  description="Seven Nintek products have native iOS builds at different release stages. None currently has a public App Store listing."
  path="/ios"
  boardFonts
  socialImage="/bg.png"
  socialImageAlt="Abstract copper Nintek circuit motif"
>
  <div class="ios-page">
  {/* ── Hero ── */}
  <section class="ih">
    <div class="container">
      <div class="ih-grid">
        <div class="ih-text reveal">
          <span class="eyebrow ih-eyebrow">
            <span class="eyebrow-dot"></span>
            A new chapter
          </span>
          <h1 class="ih-title">
            The apps are
            <span class="em">going native.</span>
          </h1>
          <p class="ih-lede">
            {COMPANY.name} started as web apps, and they are still here. But
            {` ${nativeApps.length} `}products now have real native builds for
            iPhone or iPad — SwiftUI utilities, a SwiftUI game hub, and two
            standalone Godot strategy games.
          </p>
          <p class="ih-lede">
            <strong>None has a public App Store listing today.</strong> Cortex is
            in TestFlight; Cairn&rsquo;s submitted release is blocked after review;
            Tare and ShopKeep remain private pre-release builds; Workshop is
            withdrawn for rework; and Sortie and Salvo remain in development.
          </p>
          <div class="ih-stats">
            <div class="ih-stat">
              <span class="ih-stat-num">{nativeApps.length}</span>
              <span class="ih-stat-cap">native projects</span>
            </div>
            <div class="ih-stat">
              <span class="ih-stat-num">{publicStoreCount}</span>
              <span class="ih-stat-cap">public store listings</span>
            </div>
            <div class="ih-stat">
              <span class="ih-stat-num">{watchAppCount}</span>
              <span class="ih-stat-cap">Apple Watch app</span>
            </div>
          </div>
          <div class="ih-jump">
            {
              nativeApps.map((app) => (
                <a class="ih-jump-item" href={`#${app.slug}`}>
                  <img
                    src={`/apps/${app.slug}.png`}
                    alt=""
                    width="26"
                    height="26"
                    loading="lazy"
                  />
                  {app.name}
                </a>
              ))
            }
          </div>
        </div>

        <div class="ih-phones reveal" aria-hidden="true">
          <div class="ih-phone back">
            <PhoneMock tone="light">
              <ShopKeepPhone />
            </PhoneMock>
          </div>
          <div class="ih-phone front">
            <PhoneMock tone="dark">
              <CairnPhone />
            </PhoneMock>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ── Why native ── */}
  <section class="isec container">
    <div class="isec-head reveal">
      <span class="eyebrow">
        <span class="eyebrow-dot"></span>
        Why bother
      </span>
      <h2 class="isec-title">
        A browser tab can only do so much.
      </h2>
      <p class="isec-lede">
        None of these ports exist for the sake of having an app in the store.
        Each one earns its place by doing something the web version genuinely
        cannot.
      </p>
    </div>

    <div class="ithesis">
      {
        thesis.map((t) => (
          <div class="ithesis-card reveal">
            <span class="ithesis-icon">
              <Icon name={t.icon} size={19} />
            </span>
            <h3>{t.title}</h3>
            <p>{t.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  {/* ── NintekKit ── */}
  <section class="ikit">
    <div class="container">
      <div class="ikit-grid">
        <div class="ikit-text reveal">
          <span class="eyebrow ih-eyebrow">
            <span class="eyebrow-dot"></span>
            The foundation
          </span>
          <h2 class="ikit-title">
            The utility apps share
            <span class="em">{ECOSYSTEM.kit}.</span>
          </h2>
          <p class="ikit-lede">{ECOSYSTEM.kitSummary}</p>
          <p class="ikit-note">
            The first port taught the expensive lessons. The second one reused
            them. By the third, most of the plumbing already existed — which is
            the entire point of building an ecosystem instead of a pile of
            unrelated apps.
          </p>
        </div>

        <div class="ikit-points">
          {
            ECOSYSTEM.kitPoints.map((p) => (
              <div class="ikit-point reveal">
                <span class="ikit-point-icon">
                  <Icon name={p.icon} size={17} />
                </span>
                <div>
                  <h3>{p.title}</h3>
                  <p>{p.body}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <p class="ikit-caveat reveal">
        <span class="ikit-caveat-mark">Note</span>
        The games are the exceptions. Cortex is a self-contained SwiftUI hub;
        Sortie and Salvo are Godot exports. None use NintekKit or depend on a
        Nintek account or backend.
      </p>
    </div>
  </section>

  {/* ── Per-app deep dives ── */}
  <div class="iapps">
    {
      nativeApps.map((app, i) => {
        const Phone = phones[app.slug];
        const Tablet = tablets[app.slug];
        const native = app.native!;
        return (
          <section
            class={`iapp${i % 2 === 1 ? ' reverse' : ''}${app.slug === 'workshop' ? ' workshop-iapp' : ''}`}
            id={app.slug}
          >
            <div class="container">
              <div class="iapp-grid">
                <div class="iapp-text">
                  <div class="iapp-head reveal">
                    <img
                      src={`/apps/${app.slug}.png`}
                      alt=""
                      width="56"
                      height="56"
                      loading="lazy"
                    />
                    <div>
                      <h2 class="iapp-name">{app.name}</h2>
                      <span class="iapp-beta">
                        <span class="iapp-beta-dot" />
                        {NATIVE_STATUS_LABELS[native.status]}
                      </span>
                    </div>
                  </div>
                  <p class="iapp-thesis reveal">{native.thesis}</p>
                  <p class="iapp-intro reveal">{native.intro}</p>

                  <div class="iapp-feats">
                    {native.highlights.map((h) => (
                      <div class="iapp-feat reveal">
                        <span class="iapp-feat-icon">
                          <Icon name={h.icon} size={16} />
                        </span>
                        <div>
                          <h3>{h.title}</h3>
                          <p>{h.body}</p>
                        </div>
                      </div>
                    ))}
                  </div>

                  <div class="iapp-foot reveal">
                    {native.widgets && (
                      <div class="iapp-extra">
                        <p class="iapp-extra-cap">Widgets</p>
                        <div class="iapp-tech">
                          {native.widgets.map((w) => (
                            <span class="iapp-chip">{w.name}</span>
                          ))}
                        </div>
                      </div>
                    )}
                    {native.watch && (
                      <div class="iapp-extra">
                        <p class="iapp-extra-cap">Apple Watch · {native.watch.minOS}</p>
                        <p class="iapp-extra-body">{native.watch.thesis}</p>
                      </div>
                    )}
                    {app.sunset && (
                      <p class="iapp-sunset">
                        <span class="iapp-sunset-tag">{app.sunset.label}</span>
                        {app.sunset.body}
                      </p>
                    )}
                    <div class="iapp-tech">
                      {native.tech.map((t) => (
                        <span class="iapp-chip">{t}</span>
                      ))}
                    </div>
                    <p class="iapp-req">
                      {native.minOS} or later · {native.devices}
                      {app.hasPage && (
                        <>
                          {' · '}
                          <a href={`/${app.slug}`}>About {app.name}</a>
                        </>
                      )}
                      {app.privacyPath && (
                        <>
                          {' · '}
                          <a href={app.privacyPath}>Privacy</a>
                        </>
                      )}
                      {app.supportPath && (
                        <>
                          {' · '}
                          <a href={app.supportPath}>Support</a>
                        </>
                      )}
                      {' · '}
                      <a href={app.termsPath}>Terms</a>
                    </p>
                  </div>
                </div>

                <div class={`iapp-phone reveal${Tablet ? ' iapp-tablet' : ''}`}>
                  <div class="iapp-phone-sticky">
                    {
                      app.slug === 'workshop' ? (
                        <Phone />
                      ) : Tablet ? (
                        <TabletMock orientation="portrait" tone="navy" fullBleed>
                          <Tablet />
                        </TabletMock>
                      ) : (
                        <PhoneMock
                          tone={tones[app.slug] ?? 'dark'}
                          chip={evidenceLabels[app.slug]}
                          fullBleed={app.slug === 'cortex' || app.slug === 'sortie'}
                        >
                          <Phone />
                        </PhoneMock>
                      )
                    }
                  </div>
                </div>
              </div>

              {app.slug === 'workshop' && (
                <div class="ios-workshop-proof reveal">
                  <div class="ios-workshop-proof-copy">
                    <h3>One shop. Two purpose-built canvases.</h3>
                    <p>
                      The current SwiftUI build keeps active work close on iPhone.
                      iPad opens purpose-built Projects and Shaper Hub contexts
                      without simply stretching the phone interface or mixing
                      their libraries.
                    </p>
                    <div class="ios-proof-facts">
                      <span>7 complete starter builds</span>
                      <span>5 text sizes</span>
                      <span>Apple + Microsoft sign-in</span>
                    </div>
                    <p class="ios-proof-status">
                      Native release withdrawn for rework. No public App Store or
                      TestFlight acquisition link is available.
                    </p>
                  </div>
                  <WorkshopShowcase />
                </div>
              )}
            </div>
          </section>
        );
      })
    }
  </div>

  {/* ── What's next ── */}
  {
    nextNativeApp && (
      <section class="inext container">
        <div class="inext-card reveal">
          <img
            src={`/apps/${nextNativeApp.slug}.png`}
            alt=""
            width="60"
            height="60"
            loading="lazy"
          />
          <div>
            <span class="inext-eyebrow">
              <span class="inext-dot" />
              Up next
            </span>
            <h2>{nextNativeApp.name} is the next port.</h2>
            <p>{nextNativeApp.native!.intro}</p>
          </div>
        </div>
      </section>
    )
  }

  {/* ── Closing ── */}
  <section class="iend container">
    <div class="reveal">
      <h2>The web story differs by product.</h2>
      <p>
        Tare&rsquo;s browser product is retired and production web traffic is
        relay-only for optional native AI features. Workshop and Cairn remain
        online, account-backed web workspaces, not installable or offline PWAs.
        Workshop&rsquo;s native app is a separate client; CairnNative is a separate
        offline/private-iCloud product with no shared web data.
      </p>
      <p class="iend-links">
        <a href="/#apps">Browse the apps →</a>
        &ensp;·&ensp;
        <a href="/about#platform-policy">Read the platform policy</a>
        &ensp;·&ensp;
        <a href={`mailto:${COMPANY.email}`}>Get in touch</a>
      </p>
    </div>
  </section>
  </div>
</BaseLayout>
