---
import BaseLayout from '../layouts/BaseLayout.astro';
import { COMPANY, NATIVE_STATUS_LABELS, nativeApps } from '../data/apps';

const publicStoreCount = 0;
---

<BaseLayout
  title={`Native relationships — ${COMPANY.name}`}
  description="Four Nintek products reach Apple devices at private or blocked release stages; none currently has a public App Store listing."
  path="/ios"
  boardFonts
  socialImage="/bg.png"
  socialImageAlt="Abstract copper Nintek circuit motif"
>
  <!--
    THESIS: Native status is a product-by-product evidence ledger, never a blanket launch promise.
    OWN-WORLD: Nintek cream and walnut with copper rules; canonical icons carry product identity.
    STORY: See the exact four relationships, understand their boundaries, then inspect each product.
    FIRST VIEWPORT: The release boundary leads, followed by the four-product census.
    FORM: A vertical release ledger replaces device theater that cannot represent every evidence class.
  -->
  <article class="native-ledger container">
    <header class="native-hero reveal">
      <h1>Native is a relationship, not a release claim.</h1>
      <p>
        {nativeApps.length} products reach Apple devices, and {publicStoreCount} have a
        public App Store listing. Tare is internal TestFlight, ShopKeep has a private
        attached build, Cairn remains blocked after review, and Watchtower has a private
        companion whose legacy repository identifiers are implementation details.
      </p>
    </header>

    <div class="native-entries">
      {
        nativeApps.map((app) => {
          const status = app.native
            ? NATIVE_STATUS_LABELS[app.native.status]
            : app.iosLabel ?? 'Private iOS relationship';
          const detail = app.native?.intro ?? app.overview?.purpose ?? app.description;

          return (
            <section class="native-entry reveal" id={app.slug}>
              <img
                src={`/apps/${app.slug}.png`}
                alt={`${app.name} app icon`}
                width="1024"
                height="1024"
                loading="lazy"
                decoding="async"
              />
              <div>
                <div class="native-entry-head">
                  <h2>{app.name}</h2>
                  <span>{status}</span>
                </div>
                <p>{detail}</p>
                <nav aria-label={`${app.name} documents`}>
                  {app.hasPage && <a href={`/${app.slug}`}>Product</a>}
                  {app.privacyPath && <a href={app.privacyPath}>Privacy</a>}
                  {app.supportPath && <a href={app.supportPath}>Support</a>}
                  <a href={app.termsPath}>Terms</a>
                </nav>
              </div>
            </section>
          );
        })
      }
    </div>

    <section class="native-boundary reveal">
      <h2>What this page does not claim</h2>
      <p>
        It does not publish an acquisition link, price, territory, release date, or
        availability beyond the evidence stated above. Workshop’s native client remains
        archived and is intentionally absent. Hearth remains web-only in this registry;
        the private monitoring companion is marketed as Watchtower.
      </p>
    </section>
  </article>
</BaseLayout>

<style>
  .native-ledger {
    padding-top: clamp(4rem, 9vw, 7rem);
    padding-bottom: clamp(5rem, 10vw, 8rem);
  }

  .native-hero {
    max-width: 78ch;
  }

  .native-hero h1 {
    max-width: 12ch;
    margin: 0;
    color: var(--ink);
    font-size: clamp(2.6rem, 6vw, 4.2rem);
    line-height: 1.04;
    letter-spacing: -0.035em;
  }

  .native-hero p {
    max-width: 68ch;
    margin: 1.5rem 0 0;
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.72;
  }

  .native-entries {
    margin-top: clamp(4rem, 9vw, 7rem);
    border-top: 1px solid var(--border);
  }

  .native-entry {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
    padding: clamp(2rem, 5vw, 4rem) 0;
    border-bottom: 1px solid var(--border);
    scroll-margin-top: 7rem;
  }

  .native-entry > img {
    width: 100%;
    height: auto;
    border-radius: 22%;
    box-shadow: var(--shadow-card);
  }

  .native-entry-head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    align-items: baseline;
    justify-content: space-between;
  }

  .native-entry h2,
  .native-boundary h2 {
    margin: 0;
    color: var(--ink);
    font: 700 1.45rem/1.15 var(--font-brand);
    letter-spacing: -0.02em;
  }

  .native-entry-head span {
    color: var(--copper);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .native-entry p,
  .native-boundary p {
    max-width: 70ch;
    margin: 1rem 0 0;
    color: var(--ink-soft);
    line-height: 1.72;
  }

  .native-entry nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .native-entry a,
  .native-boundary a {
    color: var(--ink);
    font-weight: 700;
    text-underline-offset: 0.22em;
  }

  .native-entry a:focus-visible {
    outline: 3px solid var(--copper);
    outline-offset: 4px;
  }

  .native-boundary {
    max-width: 72ch;
    margin-top: clamp(4rem, 9vw, 7rem);
  }

  @media (max-width: 620px) {
    .native-entry {
      grid-template-columns: 5.5rem minmax(0, 1fr);
      gap: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .native-entry {
      scroll-behavior: auto;
    }
  }
</style>
