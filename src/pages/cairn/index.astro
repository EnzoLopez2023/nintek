---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandMark from '../../components/CairnMark.astro';
import NintekBack from '../../components/NintekBack.astro';
import Icon from '../../components/Icon.astro';
import PhoneMock from '../../components/PhoneMock.astro';
import TabletMock from '../../components/TabletMock.astro';
import CairnPhone from '../../components/mocks/ios/Cairn.astro';
import CairnPad from '../../components/mocks/ios/CairnPad.astro';
import { getApp } from '../../data/apps';
import '../../styles/cairn-landing.css';

const app = getApp('cairn')!;
const native = app.native!;

const tickerCodes = [
  'AZ-104', 'AZ-305', 'AZ-400', 'AZ-500', 'AZ-700', 'AZ-140', 'AZ-800',
  'AI-102', 'AI-901', 'DP-300', 'DP-600', 'DP-700', 'DP-900', 'SC-100',
  'SC-200', 'SC-300', 'SC-401', 'SC-900', 'PL-300', 'PL-400', 'PL-900',
  'MS-102', 'MS-700', 'MD-102', 'MB-230', 'MB-310', 'MB-330', 'MB-500',
  'MB-800', 'MB-820', 'GH-100', 'GH-200', 'GH-300', 'GH-500',
];

/* Courses are iOS-only by design: they are free curricula, not certifications,
   so they have no pass score, no timed paper and no weighted domains. */
const courses = [
  { name: 'AI for Beginners', lessons: 24 },
  { name: 'Generative AI for Beginners', lessons: 21 },
  { name: 'Machine Learning for Beginners', lessons: 27 },
  { name: 'Data Science for Beginners', lessons: 20 },
  { name: 'Web Development for Beginners', lessons: 25 },
  { name: 'AI Agents for Beginners', lessons: 18 },
  { name: 'IoT for Beginners', lessons: 24 },
  { name: 'MCP for Beginners', lessons: 60 },
];

const demo = {
  domain: 'Domain 1 · Responsible AI',
  prompt: 'Which of the following are Microsoft Responsible AI principles?',
  options: ['Fairness', 'Privacy and Security', 'Transparency', 'Maximum throughput'],
  correct: [0, 1, 2],
  explanation:
    'The six Microsoft Responsible AI principles are Fairness, Reliability and Safety, Privacy and Security, Inclusiveness, Transparency, and Accountability. “Maximum throughput” is a performance metric, not a principle.',
};
---

<BaseLayout
  title={`${app.name} — Your Microsoft certification study companion`}
  description={app.description}
  path={`/${app.slug}`}
  noindex={true}
  bare={true}
  cairnFonts={true}
  themeColor="#edf2f8"
>
  <div class="lp">
    {/* ── Background atmosphere ── */}
    <div class="lp__bg" aria-hidden="true">
      <div class="lp__bg-grain"></div>
      <div class="lp__bg-orb lp__bg-orb--a"></div>
      <div class="lp__bg-orb lp__bg-orb--b"></div>
      <div class="lp__bg-orb lp__bg-orb--c"></div>
    </div>

    {/* ── Nav (brand only — no sign-in) ── */}
    <header class="lp__nav">
      <NintekBack />
      <span class="lp__brand">
        <BrandMark />
        Cairn
      </span>
    </header>

    {/* ── Hero ── */}
    <section class="lp__hero">
      <div class="lp__container">
        <div class="lp__hero-grid">
          <div class="lp__hero-text">
            <span class="lp__eyebrow">A trail through Microsoft certifications</span>
            <h1 class="lp__h1">
              Place every stone.
              <br />
              <em>Reach the summit.</em>
            </h1>
            <p class="lp__hero-lede">
              Cairn is a focused study companion for 54 Microsoft exams — guided
              readings with analogies and diagrams, an adaptive drill engine that
              hunts your weak spots, and a timed sandbox that tells you, honestly,
              whether you&rsquo;re ready. The iOS app adds eight complete Microsoft
              curricula for learning the ground without chasing a certificate.
            </p>
            <div class="lp__cta-row">
              <span class="lp__cta-meta">
                <span class="lp__cta-meta-dot"></span>
                Progress synced across every device.
              </span>
            </div>
          </div>

          {/* The cairn */}
          <div class="lp__cairn-wrap" data-parallax data-speed="-0.05" aria-hidden="true">
            <div class="lp__cairn-glow"></div>
            <div class="lp__cairn">
              <div class="lp__stone lp__stone--1">AZ-104</div>
              <div class="lp__stone lp__stone--2">SC-900</div>
              <div class="lp__stone lp__stone--3">DP-700</div>
              <div class="lp__stone lp__stone--4">AZ-400</div>
              <div class="lp__stone lp__stone--5">AI-901</div>
            </div>

            {/* The datum the stack rests on, then the readout below it. */}
            <div class="lp__cairn-ground"></div>

            <div class="lp__capstone">
              <span class="lp__capstone-pulse"></span>
              READY · 82%
            </div>

            <div class="lp__cairn-caption">
              <span><strong>5 stones placed.</strong> More certifications waiting on the trail.</span>
            </div>
          </div>
        </div>
      </div>

      {/* The full registry, running the measure — 34 of the 54 tracks. */}
      <div class="lp__ticker" aria-hidden="true">
        <div class="lp__ticker-track">
          {[...tickerCodes, ...tickerCodes].map((code) => (
            <span>{code}<span class="lp__ticker-dot"> · </span></span>
          ))}
        </div>
      </div>
    </section>

    {/* ── Trust strip ── */}
    <section class="lp__trust">
      <div class="lp__container">
        <div class="lp__trust-grid">
          <div class="lp__trust-item">
            <div class="lp__trust-num"><em>54</em></div>
            <div class="lp__trust-label">Microsoft certification tracks, from Fundamentals to Applied Skills.</div>
          </div>
          <div class="lp__trust-item">
            <div class="lp__trust-num"><em>5,300+</em></div>
            <div class="lp__trust-label">Practice questions across domains — written, explained, scored.</div>
          </div>
          <div class="lp__trust-item">
            <div class="lp__trust-num lp__trust-num--word"><em>Adaptive</em></div>
            <div class="lp__trust-label">Drill engine surfaces the weakest subdomain on every session.</div>
          </div>
          <div class="lp__trust-item">
            <div class="lp__trust-num lp__trust-num--word"><em>Timed</em></div>
            <div class="lp__trust-label">Microsoft-style sandbox mirrors the real exam format, every type.</div>
          </div>
        </div>
      </div>
    </section>

    {/* ── Live demo ── */}
    <section class="lp__section">
      <div class="lp__container">
        <div class="lp__section-head">
          <span class="lp__section-eyebrow">A live look at practice</span>
          <h2 class="lp__section-title">Drill mode learns the question you almost got right.</h2>
          <p class="lp__section-sub">
            Every answer feeds the weak-spot engine. Get a Responsible AI question wrong
            and Responsible AI shows up more often tomorrow, weighted toward the things
            you guessed at rather than the things you knew cold.
          </p>
        </div>

        <div class="lp__demo-frame">
          <div class="lp__demo-chrome">
            <div class="lp__demo-tabs">
              <span>Study Guide</span>
              <span class="lp__demo-tab--active">Practice</span>
              <span>Flashcards</span>
              <span>Sandbox</span>
              <span>Diagnostic</span>
            </div>
            <span class="lp__demo-meta">AI-901 · Adaptive mode</span>
          </div>

          <div class="lp__demo-body">
            <div class="lp__demo-domain">
              <Icon name="star" size={13} />
              {demo.domain}
            </div>

            <h3 class="lp__demo-question">{demo.prompt}</h3>

            <div class="lp__demo-options">
              {demo.options.map((opt, i) => {
                const isCorrect = demo.correct.includes(i);
                return (
                  <div class={`lp__demo-opt${isCorrect ? ' lp__demo-opt--correct' : ''}`}>
                    <span class="lp__demo-opt-check">
                      {isCorrect && <Icon name="check" size={14} />}
                    </span>
                    {opt}
                  </div>
                );
              })}
            </div>

            <div class="lp__demo-explanation">{demo.explanation}</div>

            <div class="lp__demo-toast">
              <span class="lp__demo-toast-dot"></span>
              Responsible AI confidence ↑ · queued for review in 3 days
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ── Feature bento ── */}
    <section class="lp__section" style="padding-top: 0;">
      <div class="lp__container">
        <div class="lp__section-head">
          <span class="lp__section-eyebrow">What the app gives you</span>
          <h2 class="lp__section-title">Five surfaces. One outcome.</h2>
          <p class="lp__section-sub">
            Each cert track ships the same five tools, tuned to the exam&rsquo;s real
            domain weights and question formats.
          </p>
        </div>

        <div class="lp__bento">
          <div class="lp__bento-card lp__bento-card--guide">
            <div class="lp__bento-icon"><Icon name="book" size={22} /></div>
            <h3 class="lp__bento-title">A study guide written to stick.</h3>
            <p class="lp__bento-desc">
              Every concept gets an analogy, a Mermaid diagram, and an exam tip pointing
              at the way Microsoft tends to phrase it. Section quizzes prove you got it,
              then unlock the next stone.
            </p>
            <div class="lp__bento-illu">
              <div class="lp__bento-illu-row">
                <span class="lp__bento-illu-badge">Analogy</span>
                <span>Tokens are syllables, not whole words.</span>
              </div>
              <div class="lp__bento-illu-row">
                <span class="lp__bento-illu-badge">Exam tip</span>
                <span>Grounding vs. fine-tuning — trick wording.</span>
              </div>
              <div class="lp__bento-illu-row">
                <span class="lp__bento-illu-badge">Diagram</span>
                <span>How a retrieval-augmented chat call flows.</span>
              </div>
            </div>
          </div>

          <div class="lp__bento-card lp__bento-card--practice">
            <div class="lp__bento-icon"><Icon name="check" size={22} /></div>
            <h3 class="lp__bento-title">Practice that hunts weak spots.</h3>
            <p class="lp__bento-desc">
              Filter by domain, drill by confidence, or let adaptive mode pick the next
              question for you. Daily warm-up keeps the streak alive.
            </p>
          </div>

          <div class="lp__bento-card lp__bento-card--flashcards">
            <div class="lp__bento-icon"><Icon name="layers" size={22} /></div>
            <h3 class="lp__bento-title">Flashcards on a spacing schedule.</h3>
            <p class="lp__bento-desc">
              Concept cards graduate from new → learning → review on an SM-2-style
              interval. Cards you flunk land back in tomorrow&rsquo;s deck.
            </p>
          </div>

          <div class="lp__bento-card lp__bento-card--sandbox">
            <div class="lp__bento-icon"><Icon name="calendar" size={22} /></div>
            <h3 class="lp__bento-title">A sandbox that feels like exam day.</h3>
            <p class="lp__bento-desc">
              Timer, flagging, navigator, every Microsoft question type — case study,
              hot-area, drag-match, ordering. Scaled score at the end, just like the real one.
            </p>
          </div>

          <div class="lp__bento-card lp__bento-card--diagnostic">
            <div class="lp__bento-icon"><Icon name="gauge" size={22} /></div>
            <h3 class="lp__bento-title">A diagnostic that&rsquo;s honest.</h3>
            <p class="lp__bento-desc">
              Domain-weighted accuracy maps to an estimated scaled score against the 700
              pass line. No green checkmark until the numbers earn it.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ── Dashboard mockup ── */}
    <section class="lp__section" style="padding-top: 0;">
      <div class="lp__container">
        <div class="lp__section-head">
          <span class="lp__section-eyebrow">Your hub inside the app</span>
          <h2 class="lp__section-title">A dashboard that remembers where you stopped.</h2>
          <p class="lp__section-sub">
            Stat row up top, resume widget on the left, certification tiers on the
            right — one click puts you back in the section you left at 2 a.m.
          </p>
        </div>

        <div class="lp__mockup-wrap">
          <div class="lp__mockup">
            <div class="lp__mockup-chrome">
              <span class="lp__mockup-brand">
                <BrandMark size={16} />
                Cairn
              </span>
              <span class="lp__mockup-meta">Study sheet · 2026-08-05</span>
            </div>

            <div class="lp__mockup-body">
              <div class="lp__mockup-welcome">Good morning.</div>
              <div class="lp__mockup-hero">
                Your Microsoft certification <em>study companion.</em>
              </div>

              <div class="lp__mockup-stats">
                <div class="lp__mockup-stat">
                  <div class="lp__mockup-stat-label">Sections</div>
                  <div class="lp__mockup-stat-num">34</div>
                  <div class="lp__mockup-stat-meta">across 3 tracks</div>
                </div>
                <div class="lp__mockup-stat">
                  <div class="lp__mockup-stat-label">Practice Qs</div>
                  <div class="lp__mockup-stat-num">1,208</div>
                  <div class="lp__mockup-stat-meta">questions answered</div>
                </div>
                <div class="lp__mockup-stat lp__mockup-stat--accent">
                  <div class="lp__mockup-stat-label">Best score</div>
                  <div class="lp__mockup-stat-num">812</div>
                  <div class="lp__mockup-stat-meta">scaled, out of 1000</div>
                </div>
              </div>

              <p class="lp__mockup-h">Pick up here</p>
              <div class="lp__mockup-resume">
                <span class="lp__mockup-resume-label">Continue · 2 days ago</span>
                <div class="lp__mockup-resume-title">Generative AI &amp; Agents</div>
                <div class="lp__mockup-bar">
                  <span class="lp__mockup-bar-fill" style="width: 64%;"></span>
                </div>
                <div class="lp__mockup-resume-foot">
                  <span>AI-901 · Study guide · §5 · 64%</span>
                  <span>Resume →</span>
                </div>
              </div>

              <p class="lp__mockup-h" style="margin-top: 20px;">Certification tiers · 05</p>
              <div class="lp__mockup-tiers">
                <div class="lp__mockup-tier lp__mockup-tier--hi">
                  <div class="lp__mockup-tier-name">Fundamentals</div>
                  <div class="lp__mockup-tier-desc">Entry-level cloud, AI and data concepts.</div>
                  <div class="lp__mockup-tier-count">08 exams</div>
                  <div class="lp__mockup-tier-badge">2 in progress</div>
                </div>
                <div class="lp__mockup-tier">
                  <div class="lp__mockup-tier-name">Associate</div>
                  <div class="lp__mockup-tier-desc">Day-to-day operator and engineer credentials.</div>
                  <div class="lp__mockup-tier-count">26 exams</div>
                </div>
                <div class="lp__mockup-tier">
                  <div class="lp__mockup-tier-name">Applied Skills</div>
                  <div class="lp__mockup-tier-desc">Scenario-based, project-shaped credentials.</div>
                  <div class="lp__mockup-tier-count">10 exams</div>
                </div>
                <div class="lp__mockup-tier">
                  <div class="lp__mockup-tier-name">Specialty</div>
                  <div class="lp__mockup-tier-desc">Narrow, deep workloads like SAP and virtual desktop.</div>
                  <div class="lp__mockup-tier-count">06 exams</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ── Courses + iPad (iOS only) ── */}
    <section class="lp__section lp-cx" style="padding-top: 0;">
      <div class="lp__container">
        <div class="lp__section-head">
          <span class="lp__section-eyebrow">On iPhone and iPad only</span>
          <h2 class="lp__section-title">
            Eight complete curricula, for learning the ground.
          </h2>
          <p class="lp__section-sub">
            Not everyone is chasing a certificate. The iOS app carries Microsoft&rsquo;s
            free &ldquo;for Beginners&rdquo; courses in full — 219 lessons mirrored word
            for word, with every diagram, lab, notebook and quiz bundled in. There is no
            pass score and no timed paper here, and no link ever leaves the app to read
            the material.
          </p>
        </div>

        <div class="lp-cx__grid">
          <div class="lp-cx__pad">
            <TabletMock chip="iPad · two columns" live="iPad first">
              <CairnPad />
            </TabletMock>
          </div>

          <div class="lp-cx__side">
            <ul class="lp-cx__list">
              {
                courses.map((c) => (
                  <li>
                    <span class="lp-cx__name">{c.name}</span>
                    <span class="lp-cx__n">{c.lessons} lessons</span>
                  </li>
                ))
              }
            </ul>
            <p class="lp-cx__note">
              Every course is a faithful offline mirror of its Microsoft repository,
              redistributed under its own MIT licence with the notice intact.
            </p>
          </div>
        </div>

        <div class="lp-cx__pad-note">
          <h3>The iPad layout came first, not last.</h3>
          <p>
            On iPad, navigation moves into the title bar, card grids resolve to two
            columns, and reading surfaces hold a measured line length rather than running
            the full width of the display. Column widths are tuned per size class — the
            grid above is the shipping layout, and its minimum column width exists
            specifically so an 11-inch iPad in portrait still gets two columns.
          </p>
        </div>
      </div>
    </section>


    <section class="lp__native">
      <div class="lp__container">
        <div class="lp__native-grid">
          <div class="lp__native-text">
            <span class="lp__native-eyebrow">
              <span class="lp__native-dot"></span>
              Now on iPhone and iPad
            </span>
            <h2 class="lp__native-title">
              Cairn went native — and left the server behind.
            </h2>
            <p class="lp__native-sub">{native.intro}</p>
            <p class="lp__native-access">
              <strong>Free to download.</strong> All eight Courses and the complete
              AI-901 workspace are free. The optional
              <span>Full Exam Library · $14.99 once</span> purchase has no
              subscription, supports Family Sharing, and unlocks every other current
              and future exam.
            </p>

            <div class="lp__native-list">
              {
                native.highlights.map((h) => (
                  <div class="lp__native-item">
                    <span class="lp__native-icon">
                      <Icon name={h.icon} size={15} />
                    </span>
                    <div>
                      <strong>{h.title}</strong>
                      <span>{h.body}</span>
                    </div>
                  </div>
                ))
              }
            </div>

            <p class="lp__native-meta">
              <span class="lp__native-beta">TestFlight beta</span>
              {native.minOS} or later · {native.devices}
              &ensp;·&ensp;
              <a href="/ios#cairn">More about the native apps</a>
            </p>
          </div>

          <div class="lp__native-phone" aria-hidden="true">
            <PhoneMock tone="navy">
              <CairnPhone />
            </PhoneMock>
          </div>
        </div>
      </div>
    </section>

    {/* ── Finale + support links ── */}
    <section class="lp__finale">
      <div class="lp__container">
        <h2 class="lp__finale-h">Stack <em>your</em> first stone.</h2>
        <p class="lp__finale-sub">
          One place for every track, your progress carried with you. Built for the
          person studying alone at the kitchen table.
        </p>
        <p class="lp__footer-meta">
          Cairn · Built for working engineers studying at the kitchen table.
        </p>
        <p class="lp__privacy-line">
          Need help? Visit <a href="/cairn/support/">Cairn Support</a> or read the
          <a href="/cairn/privacy/">{app.name} Privacy Policy</a>.
        </p>
      </div>
    </section>
  </div>

</BaseLayout>

<style>
  /* ---- Courses + iPad ---- */
  .lp-cx__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    gap: 40px;
    align-items: start;
    margin-top: 34px;
  }
  .lp-cx__pad {
    min-width: 0;
  }
  .lp-cx__side {
    min-width: 0;
  }
  .lp-cx__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .lp-cx__list li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 11px 2px;
    border-bottom: 1px solid var(--line);
  }
  .lp-cx__name {
    font-weight: 600;
    color: var(--ink);
    font-size: 0.95rem;
  }
  .lp-cx__n {
    flex: none;
    font-size: 0.78rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .lp-cx__note {
    margin: 16px 0 0;
    font-size: 0.84rem;
    line-height: 1.55;
    color: var(--muted);
  }
  /* Framed with registration marks, the way the app frames a panel — not
     lifted with a shadow or tagged with a coloured side tab. */
  .lp-cx__pad-note {
    position: relative;
    margin-top: 40px;
    padding: 26px 28px;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--paper);
    box-shadow: var(--seat);
  }
  .lp-cx__pad-note::before,
  .lp-cx__pad-note::after {
    content: '';
    position: absolute;
    width: 11px;
    height: 11px;
    border: 1px solid var(--accent);
    opacity: 0.55;
  }
  .lp-cx__pad-note::before {
    top: 7px;
    left: 7px;
    border-width: 1px 0 0 1px;
  }
  .lp-cx__pad-note::after {
    right: 7px;
    bottom: 7px;
    border-width: 0 1px 1px 0;
  }
  .lp-cx__pad-note h3 {
    margin: 0 0 8px;
    font-family: var(--display);
    font-size: 1.12rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--ink);
  }
  .lp-cx__pad-note p {
    margin: 0;
    max-width: 78ch;
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--ink-soft);
  }

  @media (max-width: 900px) {
    .lp-cx__grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }
</style>
