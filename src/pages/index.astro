---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppPromo from '../components/AppPromo.astro';
import { apps, COMPANY } from '../data/apps';
---

<BaseLayout
  title={`${COMPANY.name} — ${COMPANY.tagline}`}
  description={`${COMPANY.name} builds small, thoughtful apps for learning, health, home, and play.`}
  path="/"
>
  <section class="hero container">
    <span class="eyebrow">
      <span class="eyebrow-dot"></span>
      An independent software studio
    </span>
    <h1>
      Small, thoughtful software
      <span class="em">for everyday life.</span>
    </h1>
    <p>
      {COMPANY.name} builds focused apps that each do one thing well — for
      learning, health, home, and play. Private by default, fast, and a pleasure
      to use.
    </p>
  </section>

  <div id="apps">
    {apps.map((app, i) => <AppPromo app={app} index={i} />)}
  </div>

  <section id="about" class="container" style="padding-top: 80px; padding-bottom: 120px;">
    <div class="reveal" style="max-width: 64ch;">
      <h2 class="promo-title" style="font-size: clamp(1.8rem, 4vw, 2.6rem);">
        About {COMPANY.name}
      </h2>
      <p class="muted">
        {COMPANY.name} is a one-person studio. Every app is designed to be
        private by default, fast, and pleasant to use — no clutter, no dark
        patterns. Have a question or some feedback?
        <a href={`mailto:${COMPANY.email}`}>Get in touch</a>.
      </p>
    </div>
  </section>
</BaseLayout>
