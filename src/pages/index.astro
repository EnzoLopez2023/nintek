---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppPromo from '../components/AppPromo.astro';
import NativeShowcase from '../components/NativeShowcase.astro';
import { apps, COMPANY } from '../data/apps';

const words = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten', 'eleven', 'twelve'];
const w = (n: number) => words[n] ?? String(n);
const webCount = apps.filter((a) => a.platforms.web).length;
const iosCount = apps.filter((a) => a.platforms.ios).length;
---

<BaseLayout
  title={`${COMPANY.name} — ${COMPANY.tagline}`}
  description={`${COMPANY.name} is an independent portfolio of focused apps for learning, health, home, making, reading, and operations.`}
  path="/"
  boardFonts
  socialImage="/bg.png"
  socialImageAlt="Abstract copper Nintek circuit motif"
>
  <section class="hero container" data-portfolio-home>
    <span class="eyebrow">
      <span class="eyebrow-dot"></span>
      An independent software studio
    </span>
    <h1>
      Small, thoughtful software
      <span class="em">for everyday life.</span>
    </h1>
    <p>
      {COMPANY.name} builds focused apps that each do one thing well — for
      learning, health, home, and operations. {w(apps.length)[0].toUpperCase() + w(apps.length).slice(1)}{' '}
      of them so far: {w(webCount)} with web products and {w(iosCount)} with
      native iOS relationships at clearly stated release stages. Tare also includes an
      Apple Watch app; no page implies public store availability without evidence.
    </p>
  </section>

  <NativeShowcase />

  <div id="apps">
    {apps.map((app, i) => <AppPromo app={app} index={i} />)}
  </div>

  <section id="about" class="container" style="padding-top: 80px; padding-bottom: 120px;">
    <div class="reveal" style="max-width: 64ch;">
      <h2 class="promo-title" style="font-size: clamp(1.8rem, 4vw, 2.6rem);">
        About {COMPANY.name}
      </h2>
      <p class="muted">
        I'm an SRE by trade and a maker by habit. These apps grew out of
        problems I was already living with — tracking a health journey, keeping
        a woodshop in order, staying certified at work, keeping systems visible,
        and running a home without losing the manual in a drawer somewhere. Each
        one started as a note, then a prototype, then something I couldn't stop
        using. {COMPANY.name} is where they live.
      </p>
      <p class="muted" style="margin-top: 1rem;">
        <a href="/about">Read the full story →</a>
        &ensp;·&ensp;
        <a href="/ios">The native iOS apps</a>
        &ensp;·&ensp;
        <a href={`mailto:${COMPANY.email}`}>Get in touch</a>
      </p>
    </div>
  </section>
</BaseLayout>
