---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NintekBack from '../../components/NintekBack.astro';
import WebReleaseVisual from '../../components/WebReleaseVisual.astro';
import { getApp } from '../../data/apps';
import '../../styles/pulsewire-landing.css';

const app = getApp('pulsewire')!;

const capabilities = [
  {
    title: 'Stories instead of duplicates',
    body:
      'Related reports are grouped into one developing story, so another source adds evidence and chronology instead of another repeated card.',
  },
  {
    title: 'Evidence stays close',
    body:
      'Source coverage, review state, chronology, and uncertainty remain visible. Unknown is presented as unknown rather than silently scored as neutral.',
  },
  {
    title: 'Saved means an explicit snapshot',
    body:
      'A Saved story can be downloaded into the installable PWA for bounded offline reading. It is an intentional copy, not an opaque cache of everything opened.',
  },
];

const architecture = [
  ['Sources', 'Evidence-linked coverage · count intentionally omitted'],
  ['Data', 'PostgreSQL · pgvector'],
  ['Identity', 'Microsoft Entra owner · 24-hour read-only demo'],
  ['AI', 'Azure AI briefs and embeddings'],
  ['Offline', 'Explicit Saved snapshots in the PWA'],
];
---

<BaseLayout
  bare
  noindex
  path="/pulsewire"
  title="PulseWire — Follow developing stories, not an endless feed."
  description="A private story-intelligence reader with a separate 24-hour read-only demo, evidence-linked stories, explainable ranking, and explicit offline Saved snapshots."
  themeColor="#f6f7fb"
  socialImage="/social/pulsewire.png"
  socialImageAlt="PulseWire dashboard showing a fictional regional energy story with source evidence"
  socialImageWidth={1200}
  socialImageHeight={630}
>
  <div class="pw-root">
    <header class="pw-header">
      <div class="pw-wrap pw-header__inner">
        <NintekBack />
        <a href="/pulsewire" class="pw-brand" aria-label="PulseWire home">
          <img src="/apps/pulsewire.png" alt="" width="40" height="40" />
          <span>PulseWire</span>
        </a>
        <span class="pw-private">Owner workspace · demo separate</span>
      </div>
    </header>

    <main>
      <section class="pw-hero">
        <div class="pw-wrap pw-hero__grid">
          <div class="pw-hero__copy">
            <h1>Follow developing stories, not an endless feed.</h1>
            <p>
              PulseWire is a story-intelligence layer over RSS sources. Its owner
              workspace is private and Entra-protected; a separate read-only demo
              shows the reading model without creating a personal account.
            </p>
            <dl class="pw-proof-strip">
              <div>
                <dt>Fictional</dt>
                <dd>release fixture</dd>
              </div>
              <div>
                <dt>Evidence</dt>
                <dd>source-linked coverage</dd>
              </div>
              <div>
                <dt>24h</dt>
                <dd>read-only demo session</dd>
              </div>
            </dl>
            <p class="pw-availability">
              This portfolio page does not publish the service entry point. The
              production owner workspace remains access-controlled; the live
              service currently offers a separate, non-personal read-only demo.
            </p>
          </div>

          <WebReleaseVisual product="pulsewire" eager />
        </div>
      </section>

      <section class="pw-section">
        <div class="pw-wrap pw-section__grid">
          <div class="pw-section__intro">
            <h2>A deliberate reading ritual, built around evidence.</h2>
            <p>
              The current product uses the Premium News Dashboard system: pearl
              canvas, white reading planes, fine rules, cobalt action, and
              evidence teal. The interface stays calm without hiding where a
              claim came from.
            </p>
          </div>
          <div class="pw-capabilities">
            {capabilities.map((capability) => (
              <article>
                <h3>{capability.title}</h3>
                <p>{capability.body}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="pw-system">
        <div class="pw-wrap pw-system__grid">
          <div>
            <h2>Private by access, explicit about storage.</h2>
            <p>
              Server data lives in PostgreSQL with pgvector. Microsoft Entra
              restricts the workspace to configured principals. Offline reading
              stores only Saved snapshots that were deliberately downloaded;
              it does not make the server-backed reader local-first.
            </p>
          </div>
          <dl class="pw-architecture">
            {architecture.map(([term, detail]) => (
              <div>
                <dt>{term}</dt>
                <dd>{detail}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    </main>

    <footer class="pw-foot">
      <div class="pw-wrap pw-foot__inner">
        <p>PulseWire · private owner workspace · separate read-only demo</p>
        <nav aria-label="PulseWire help and legal">
          <a href={app.supportPath}>Support</a>
          <a href={app.privacyPath}>Privacy</a>
          <a href={app.termsPath}>Terms</a>
        </nav>
      </div>
    </footer>
  </div>
</BaseLayout>
