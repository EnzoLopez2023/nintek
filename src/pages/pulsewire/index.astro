---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NintekBack from '../../components/NintekBack.astro';
import '../../styles/pulsewire-landing.css';

const capabilities = [
  {
    title: 'Stories instead of duplicates',
    body:
      'Related reports are grouped into one developing story, so another source adds evidence and chronology instead of another repeated card.',
  },
  {
    title: 'Evidence stays close',
    body:
      'Source coverage, review state, chronology, and uncertainty remain visible. Unknown is presented as unknown rather than silently scored as neutral.',
  },
  {
    title: 'Saved means an explicit snapshot',
    body:
      'A Saved story can be downloaded into the installable PWA for bounded offline reading. It is an intentional copy, not an opaque cache of everything opened.',
  },
];

const architecture = [
  ['Catalog', '317 unique feeds · 64 categories'],
  ['Data', 'PostgreSQL · pgvector'],
  ['Identity', 'Private Microsoft Entra sign-in'],
  ['AI', 'Azure AI briefs and embeddings'],
  ['Offline', 'Explicit Saved snapshots in the PWA'],
];
---

<BaseLayout
  bare
  noindex
  path="/pulsewire"
  title="PulseWire — Follow developing stories, not an endless feed."
  description="A private story-intelligence reader with a 317-feed catalogue, evidence-first story grouping, PostgreSQL and pgvector, and explicit offline Saved snapshots."
  themeColor="#f6f7fb"
  socialImage="/apps/pulsewire.png"
  socialImageAlt="PulseWire app icon"
>
  <div class="pw-root">
    <header class="pw-header">
      <div class="pw-wrap pw-header__inner">
        <NintekBack />
        <a href="/pulsewire" class="pw-brand" aria-label="PulseWire home">
          <img src="/apps/pulsewire.png" alt="" width="40" height="40" />
          <span>PulseWire</span>
        </a>
        <span class="pw-private">Private workspace</span>
      </div>
    </header>

    <main>
      <section class="pw-hero">
        <div class="pw-wrap pw-hero__grid">
          <div class="pw-hero__copy">
            <h1>Follow developing stories, not an endless feed.</h1>
            <p>
              PulseWire is a private, single-owner intelligence layer over RSS
              sources. It groups related reporting, shows what changed, and
              keeps source evidence near every brief.
            </p>
            <dl class="pw-proof-strip">
              <div>
                <dt>317</dt>
                <dd>unique feeds</dd>
              </div>
              <div>
                <dt>64</dt>
                <dd>catalog categories</dd>
              </div>
              <div>
                <dt>Private</dt>
                <dd>authenticated reader</dd>
              </div>
            </dl>
            <p class="pw-availability">
              This portfolio page is not a public reader or demo entry point.
              The production workspace remains access-controlled.
            </p>
          </div>

          <figure class="pw-dashboard">
            <div class="pw-dashboard__bar">
              <div>
                <strong>Today</strong>
                <span>Premium News Dashboard</span>
              </div>
              <span class="pw-dashboard__state">Private edition</span>
            </div>
            <div class="pw-dashboard__lead">
              <div class="pw-dashboard__meta">
                <span>DEVELOPING STORY</span>
                <span>6 REPORTS</span>
              </div>
              <h2>One story record, assembled from independent coverage.</h2>
              <p>
                The live product places a generated brief beside source evidence,
                chronology, and review state. No real headline or live link is
                reproduced in this marketing diagram.
              </p>
            </div>
            <div class="pw-dashboard__facts">
              <div><span>Coverage</span><strong>Sources remain inspectable</strong></div>
              <div><span>Chronology</span><strong>Changes stay ordered</strong></div>
              <div><span>Saved</span><strong>Snapshot available offline</strong></div>
            </div>
            <figcaption>Synthetic interface diagram · no live story data</figcaption>
          </figure>
        </div>
      </section>

      <section class="pw-section">
        <div class="pw-wrap pw-section__grid">
          <div class="pw-section__intro">
            <h2>A deliberate reading ritual, built around evidence.</h2>
            <p>
              The current product uses the Premium News Dashboard system: pearl
              canvas, white reading planes, fine rules, cobalt action, and
              evidence teal. The interface stays calm without hiding where a
              claim came from.
            </p>
          </div>
          <div class="pw-capabilities">
            {capabilities.map((capability) => (
              <article>
                <h3>{capability.title}</h3>
                <p>{capability.body}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="pw-system">
        <div class="pw-wrap pw-system__grid">
          <div>
            <h2>Private by access, explicit about storage.</h2>
            <p>
              Server data lives in PostgreSQL with pgvector. Microsoft Entra
              restricts the workspace to configured principals. Offline reading
              stores only Saved snapshots that were deliberately downloaded;
              it does not make the server-backed reader local-first.
            </p>
          </div>
          <dl class="pw-architecture">
            {architecture.map(([term, detail]) => (
              <div>
                <dt>{term}</dt>
                <dd>{detail}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    </main>

    <footer class="pw-foot">
      <div class="pw-wrap pw-foot__inner">
        <p>PulseWire · private story intelligence for selected sources</p>
        <a href="/pulsewire/privacy">Privacy policy</a>
      </div>
    </footer>
  </div>
</BaseLayout>
