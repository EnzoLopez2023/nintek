---
/* ── Tare landing page ─────────────────────────────────────────────────────
   This page sells the *native iOS app*, which is now the product. The React
   web app it grew out of is winding down, and the page says so out loud
   rather than quietly dropping it.

   Every claim here is checked against the shipped app in
   https://github.com/EnzoLopez2023/Tare-for-iOS. Where the app is careful,
   the copy is careful too: Apple Health sync is automatic only after explicit
   opt-in, the watch defers its writes to the phone, and the AI section explains
   exactly what does and doesn't leave the device.
   ───────────────────────────────────────────────────────────────────────── */
import BaseLayout from '../../layouts/BaseLayout.astro';
import NintekBack from '../../components/NintekBack.astro';
import Icon from '../../components/Icon.astro';
import PhoneMock from '../../components/PhoneMock.astro';
import TarePhone from '../../components/mocks/ios/Tare.astro';
import WatchMock from '../../components/WatchMock.astro';
import TareWatch from '../../components/mocks/watch/Tare.astro';
import TareWidgets from '../../components/mocks/widgets/Tare.astro';
import { getApp, NATIVE_STATUS_LABELS } from '../../data/apps';
import '../../styles/tare-landing.css';

const app = getApp('tare')!;
const native = app.native!;
const watch = native.watch!;
const widgets = native.widgets!;
const sunset = app.sunset!;

/* ── Trust strip — native facts, not the old server-side ones ── */
const trust = [
  { num: 'No', tail: 'account', lbl: 'No sign-up, no password, no server-side profile. Open it and start.' },
  { num: 'On', tail: 'device', lbl: 'Everything lives in a local store, mirrored only to your own iCloud.' },
  { num: 'Two-way', tail: 'Apple Health', lbl: 'Weight and glucose sync both directions. Steps and sleep read in.' },
  { num: 'AI', tail: 'off by default', lbl: 'Nine assisted features, every one behind a switch that starts off.' },
];

/* ── Ask Tare demo thread ── */
const demo = {
  question: 'How am I doing this week?',
  answer:
    "Your fasting glucose averaged 102 this week — your best stretch in 30 days. Weight is down 1.6 lb, holding the 2 lb/month pace. Sunday's injection lands right on schedule.",
  toast: 'A1C trajectory ↗ improving',
};

/* ── What Apple Health exchanges, exactly ── */
const healthRows = [
  { name: 'Weight',  dir: 'both',  note: 'Read in and written back' },
  { name: 'Glucose', dir: 'both',  note: 'Read in and written back' },
  { name: 'Steps',   dir: 'in',    note: 'Read only' },
  { name: 'Sleep',   dir: 'in',    note: 'Read only' },
];

/* ── Native platform features, grouped ── */
const platform = [
  {
    eyebrow: 'Live Activities',
    title: 'Dose day, on the Lock Screen',
    body: 'On the day a dose is due, a Live Activity counts it down on the Lock Screen and in the Dynamic Island — no app launch required.',
  },
  {
    eyebrow: 'Siri & Shortcuts',
    title: 'Three App Intents',
    body: '“Log my weight”, “Log my glucose”, and “When is my next dose?” run from Siri, Spotlight or a Shortcut.',
  },
  {
    eyebrow: 'Face ID',
    title: 'A lock on the door',
    body: 'Optional Face ID or passcode on launch, plus a cover over the app switcher preview so nothing shows in multitasking.',
  },
  {
    eyebrow: 'Notifications',
    title: 'Reminders that actually arrive',
    body: 'Four repeating kinds — dose, glucose, weight and the daily check-in — scheduled locally, so they fire with no network at all.',
  },
  {
    eyebrow: 'Camera & scanning',
    title: 'Photos and paperwork',
    body: 'Progress photos, meal photos for macro estimates, and VisionKit document scanning for lab reports.',
  },
  {
    eyebrow: 'Deep links',
    title: 'Straight to the right screen',
    body: 'Every widget, complication and notification opens the exact route it refers to through a tare:// link.',
  },
];

/* ── Wellbeing radar geometry (final visible state) ── */
const rcx = 60, rcy = 60, rmax = 52;
const radarAngles = [-90, 0, 90, 180].map((d) => (d * Math.PI) / 180);
const radarLabels = ['Mood', 'Energy', 'Hunger', 'Sleep'];
const radarValues = [0.78, 0.65, 0.48, 0.72];
const radarOuter = radarAngles.map((a) => [rcx + Math.cos(a) * rmax, rcy + Math.sin(a) * rmax]);
const radarInner = radarAngles.map((a, i) => {
  const r = rmax * radarValues[i];
  return [rcx + Math.cos(a) * r, rcy + Math.sin(a) * r];
});
const radarOuterD = `M ${radarOuter.map(([x, y]) => `${x},${y}`).join(' L ')} Z`;
const radarInnerD = `M ${radarInner.map(([x, y]) => `${x},${y}`).join(' L ')} Z`;

/* ── Journey mini-chart dots ── */
const chartDots = [[0, 118], [65, 99], [130, 70], [195, 46], [260, 28]];

/* ── 7-segment digit definitions for the weight scale (final reading 242.1) ── */
const SEG_RECTS = [
  { name: 'a', x: 4,  y: 0,  w: 16, h: 3 },
  { name: 'b', x: 21, y: 4,  w: 3,  h: 18 },
  { name: 'c', x: 21, y: 27, w: 3,  h: 18 },
  { name: 'd', x: 4,  y: 47, w: 16, h: 3 },
  { name: 'e', x: 1,  y: 27, w: 3,  h: 18 },
  { name: 'f', x: 1,  y: 4,  w: 3,  h: 18 },
  { name: 'g', x: 4,  y: 23, w: 16, h: 3 },
];
const SEG_MAP: Record<number, string> = {
  0: 'abcdef', 1: 'bc', 2: 'abdeg', 3: 'abcdg', 4: 'bcfg',
  5: 'acdfg', 6: 'acdefg', 7: 'abc', 8: 'abcdefg', 9: 'abcdfg',
};
const scaleChars = '242.1'.split('');

const vitals = [
  { lbl: 'HBA1C',    val: '6.1%',   color: 'var(--lp-meds-deep)' },
  { lbl: 'BP',       val: '118/76', color: 'var(--lp-brand-700)' },
  { lbl: 'WEIGHT',   val: '242 lb', color: 'var(--lp-wgt-deep)' },
  { lbl: 'A1C TRAJ', val: '↘ −0.4', color: 'var(--lp-act-deep)' },
];
---

<BaseLayout
  bare
  noindex
  path="/tare"
  title="Tare — Reset to baseline. Every week."
  description="A native iPhone, iPad and Apple Watch app for the GLP-1 journey — glucose, doses, weight and well-being, with two-way Apple Health sync, widgets, complications and no account at all."
  socialImage="/apps/tare.png"
  socialImageAlt="Tare app icon"
>
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  {/* Archivo is the app's own family — the bundled faces are static instances
      of this exact variable font, so the widths match what SwiftUI renders. */}
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,62..125,100..900;1,62..125,100..900&display=swap"
  />

  <div class="lp-root">
    {/* ── Background atmosphere ── */}
    <div class="lp-bg" aria-hidden="true">
      <div class="lp-bg__grain"></div>
      <div class="lp-bg__orb lp-bg__orb--a"></div>
      <div class="lp-bg__orb lp-bg__orb--b"></div>
      <div class="lp-bg__orb lp-bg__orb--c"></div>
    </div>

    <div class="lp-content">
      {/* ── Nav ── */}
      <nav class="lp-nav">
        <div class="lp-nav__inner">
          <NintekBack />
          <div class="lp-nav__brand">
            <span class="lp-nav__brand-mark lp-nav__brand-mark--icon">
              <img src="/apps/tare.png" alt="" width="40" height="40" loading="eager" decoding="async" />
            </span>
            <span>Tare</span>
          </div>
        </div>
      </nav>

      {/* ── Hero ── */}
      <section class="lp-hero lp-hero--native">
        <div class="lp-hero__copy">
          <p class="lp-eyebrow">
            <span class="lp-eyebrow__dot"></span>
            Now on iPhone, iPad and Apple&nbsp;Watch
          </p>
          <h1 class="lp-hero__title">
            Track your week. <em>Reset to baseline.</em>
          </h1>
          <p class="lp-hero__lede">
            Glucose, doses, weight and well-being in one calm instrument panel —
            built natively for iOS, synced through your own iCloud, and usable
            with <strong>no account at all</strong>.
          </p>

          <ul class="lp-hero__pills">
            <li>Two-way Apple Health</li>
            <li>Apple Watch app</li>
            <li>5 widgets + Live Activity</li>
            <li>Face ID lock</li>
          </ul>

          <p class="lp-hero__meta">
            <span class="lp-native__beta">{NATIVE_STATUS_LABELS[native.status]}</span>
            {native.minOS} or later &middot; {native.devices} &middot; No public
            App Store listing or announced price
          </p>
        </div>

        {/* Device cluster: the phone, with the watch tucked in front of it. */}
        <div class="lp-hero__devices">
          <div class="lp-hero__phone">
            <PhoneMock tone="enamel">
              <TarePhone />
            </PhoneMock>
          </div>
          <div class="lp-hero__watch" aria-hidden="true">
            <WatchMock width={186}>
              <TareWatch view="home" />
            </WatchMock>
          </div>
        </div>
      </section>

      {/* ── Sunset notice ── */}
      <section class="lp-sunset" aria-labelledby="lp-sunset-h">
        <div class="lp-sunset__inner">
          <span class="lp-sunset__badge">{sunset.label}</span>
          <div class="lp-sunset__text">
            <h2 class="lp-sunset__title" id="lp-sunset-h">{sunset.successor}</h2>
            <p>{sunset.body}</p>
          </div>
        </div>
      </section>

      {/* ── Trust strip ── */}
      <section class="lp-trust">
        <div class="lp-trust__inner">
          {trust.map((t) => (
            <div>
              <p class="lp-trust__item-num"><em>{t.num}</em> {t.tail}</p>
              <p class="lp-trust__item-lbl">{t.lbl}</p>
            </div>
          ))}
        </div>
      </section>

      {/* ── Apple Health ── */}
      <section class="lp-section" id="health">
        <div class="lp-section__head">
          <p class="lp-eyebrow">Apple Health</p>
          <h2 class="lp-section__title">
            It talks to the rest of your <em>health data</em>.
          </h2>
          <p class="lp-section__lede">
            Weight and glucose move in both directions, so a reading taken on a
            smart scale or a connected meter shows up in Tare — and anything you
            log in Tare shows up in Health. Steps and sleep are read in to give
            your check-ins context.
          </p>
        </div>

        <div class="lp-health">
          <div class="lp-health__table">
            {healthRows.map((r) => (
              <div class="lp-health__row">
                <span class="lp-health__name">{r.name}</span>
                <span class={`lp-health__arrow lp-health__arrow--${r.dir}`} aria-hidden="true">
                  {r.dir === 'both' ? '⇄' : '←'}
                </span>
                <span class="lp-health__note">{r.note}</span>
              </div>
            ))}
          </div>

          <div class="lp-health__notes">
            <div class="lp-note">
              <p class="lp-note__title">What you typed always wins</p>
              <p>
                If a reading exists in both places, the value you entered in Tare
                is the one kept. Imported samples never overwrite your own.
              </p>
            </div>
            <div class="lp-note">
              <p class="lp-note__title">Automatic after you opt in</p>
              <p>
                New Health data is imported whenever you open or return to Tare.
                <em>Sync now</em> remains available, and the setting can be turned
                off at any time.
              </p>
            </div>
          </div>
        </div>
      </section>

      {/* ── Widgets ── */}
      <section class="lp-section lp-section--tight" id="widgets">
        <div class="lp-section__head">
          <p class="lp-eyebrow">Widgets &amp; Live Activities</p>
          <h2 class="lp-section__title">
            Most days, you never <em>open the app</em>.
          </h2>
          <p class="lp-section__lede">
            Five widgets across the Home Screen, the Lock Screen and StandBy —
            plus a Live Activity that counts down dose day in the Dynamic
            Island. Each one opens straight to the screen it&rsquo;s about.
          </p>
        </div>

        <div class="lp-wsec">
          <div class="lp-wsec__stage">
            <p class="lp-wsec__cap">Home Screen</p>
            <TareWidgets kind="home" />
          </div>

          <div class="lp-wsec__aside">
            <div class="lp-wsec__lock">
              <p class="lp-wsec__cap">Lock Screen &amp; StandBy</p>
              <TareWidgets kind="lock" />
            </div>
            <TareWidgets kind="island" />
          </div>
        </div>

        <div class="lp-wgrid">
          {widgets.map((w) => (
            <article class="lp-wgrid__item">
              <h3>{w.name}</h3>
              <p>{w.body}</p>
              <ul class="lp-wgrid__sizes">
                {w.sizes.map((s) => <li>{s}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </section>

      {/* ── Apple Watch ── */}
      <section class="lp-watch" id="watch">
        <div class="lp-watch__grid">
          <div class="lp-watch__devices" aria-hidden="true">
            <WatchMock width={214}>
              <TareWatch view="home" />
            </WatchMock>
            <WatchMock width={186}>
              <TareWatch view="log" />
            </WatchMock>
          </div>

          <div class="lp-watch__text">
            <p class="lp-eyebrow">Apple Watch</p>
            <h2 class="lp-section__title">{watch.thesis}</h2>

            <div class="lp-watch__list">
              {watch.points.map((p) => (
                <div class="lp-watch__item">
                  <span class="lp-watch__tick" aria-hidden="true"></span>
                  <span>{p}</span>
                </div>
              ))}
            </div>

            <div class="lp-watch__comps">
              <p class="lp-watch__comps-cap">Complications</p>
              {watch.complications.map((c) => (
                <div class="lp-watch__comp">
                  <strong>{c.name}</strong>
                  <span>{c.families}</span>
                </div>
              ))}
            </div>

            <p class="lp-watch__meta">{watch.minOS} or later</p>
          </div>
        </div>
      </section>

      {/* ── AI ── */}
      <section class="lp-section" id="ai">
        <div class="lp-section__head">
          <p class="lp-eyebrow">Assisted, not automated</p>
          <h2 class="lp-section__title">
            Nine AI features. All of them <em>start switched off</em>.
          </h2>
          <p class="lp-section__lede">
            Ask a question in plain language and the answer is grounded in your
            own readings. Turn the consent switch off and the app makes no
            network requests at all — every screen still works.
          </p>
        </div>

        <div class="lp-demo">
          <div class="lp-demo__panel">
            <div class="lp-demo__panel-head">
              <span>Ask Tare</span>
              <span class="lp-demo__panel-tag">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2v4"></path><path d="M16 2v4"></path><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M3 10h18"></path></svg>
                Illustrative data · 30 days
              </span>
            </div>

            <div class="lp-thread">
              <div class="lp-bubble lp-bubble--user">{demo.question}</div>
              <div class="lp-bubble lp-bubble--ai">{demo.answer}</div>
              <div class="lp-toast">
                <svg class="lp-toast__icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .962 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.962 0z"></path><path d="M20 3v4"></path><path d="M22 5h-4"></path><path d="M4 17v2"></path><path d="M5 18H3"></path></svg>
                {demo.toast}
              </div>
            </div>
          </div>

          <div class="lp-demo__side">
            <div class="lp-demo__step lp-demo__step--active">
              <span class="lp-demo__step-bullet">1</span>
              <div>
                <p class="lp-demo__step-title">You turn it on, once</p>
                <p class="lp-demo__step-body">
                  A single consent switch, off out of the box. Nothing is sent
                  before you flip it, and flipping it back stops everything.
                </p>
              </div>
            </div>
            <div class="lp-demo__step">
              <span class="lp-demo__step-bullet">2</span>
              <div>
                <p class="lp-demo__step-title">Your database stays put</p>
                <p class="lp-demo__step-body">
                  For data questions the assistant writes a query and your phone
                  runs it locally. Only the small answer it needs travels — never
                  the database, and never a bulk export.
                </p>
              </div>
            </div>
            <div class="lp-demo__step">
              <span class="lp-demo__step-bullet">3</span>
              <div>
                <p class="lp-demo__step-title">No account to attach it to</p>
                <p class="lp-demo__step-body">
                  Requests are authorised by App&nbsp;Attest — proof the app is
                  genuine, not proof of who you are. The relay keeps nothing.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* ── Features bento ── */}
      <section class="lp-section lp-section--tight" id="features">
        <div class="lp-section__head">
          <p class="lp-eyebrow">Everything Tare tracks</p>
          <h2 class="lp-section__title">
            Six surfaces, one calm <em>workspace</em>.
          </h2>
        </div>

        <div class="lp-bento">
          {/* Journey & Insights — tall */}
          <article class="lp-card lp-card--feature-tall">
            <div class="lp-card__scene lp-scene--neut">
              <svg class="lp-mini-chart" viewBox="0 0 260 150" aria-hidden="true">
                {[36, 70, 104].map((y) => (
                  <line x1="0" y1={y} x2="260" y2={y} stroke="rgba(120, 137, 148, 0.22)"></line>
                ))}
                <path class="lp-mini-chart__area" d="M 0,118 C 50,108 90,90 130,70 C 170,52 210,38 260,28 L 260,142 L 0,142 Z"></path>
                <path class="lp-mini-chart__line" d="M 0,118 C 50,108 90,90 130,70 C 170,52 210,38 260,28"></path>
                {chartDots.map(([cx, cy], i) => (
                  <circle class="lp-mini-chart__dot" cx={cx} cy={cy} r={i === 4 ? 5.5 : 3.5}></circle>
                ))}
              </svg>
            </div>
            <div class="lp-card__body">
              <p class="lp-card__eyebrow" style="color: var(--lp-brand-700);">Journey &amp; Insights</p>
              <h3 class="lp-card__title">A clear view of the whole arc</h3>
              <p>
                Days since diagnosis, weeks on medication, estimated A1C, and a
                30-day weight and glucose trend — every chart drawn by hand so it
                keeps the app&rsquo;s own line weights and colours.
              </p>
            </div>
          </article>

          {/* Blood glucose */}
          <article class="lp-card lp-card--feature">
            <div class="lp-card__scene lp-scene--glu">
              <svg width="44" height="60" viewBox="0 0 44 60" aria-hidden="true">
                <defs>
                  <linearGradient id="lp-drop-r" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#a6d5e1"></stop>
                    <stop offset="100%" stop-color="#0a5d72"></stop>
                  </linearGradient>
                </defs>
                <path d="M22 4 C 8 22, 4 38, 22 56 C 40 38, 36 22, 22 4 Z" fill="url(#lp-drop-r)"></path>
                <ellipse cx="16" cy="22" rx="5" ry="3" fill="rgba(255,255,255,0.55)"></ellipse>
              </svg>
            </div>
            <div class="lp-card__body">
              <p class="lp-card__eyebrow" style="color: var(--lp-glu-deep);">Blood glucose</p>
              <h3 class="lp-card__title">Readings, ranges, weekly trends</h3>
              <p>
                Log fasting, post-meal or random readings — or let Apple Health
                bring them in. Bands are named, not just coloured.
              </p>
            </div>
          </article>

          {/* GLP-1 medication */}
          <article class="lp-card lp-card--feature">
            <div class="lp-card__scene lp-scene--meds">
              <svg width="120" height="48" viewBox="0 0 200 80" aria-hidden="true">
                <rect x="0" y="0" width="100" height="80" rx="40" fill="#ebe5fb"></rect>
                <rect x="100" y="0" width="100" height="80" rx="40" fill="#8b79e0"></rect>
                <ellipse cx="40" cy="20" rx="22" ry="6" fill="rgba(255,255,255,0.5)"></ellipse>
                <ellipse cx="140" cy="20" rx="22" ry="6" fill="rgba(255,255,255,0.22)"></ellipse>
              </svg>
            </div>
            <div class="lp-card__body">
              <p class="lp-card__eyebrow" style="color: var(--lp-meds-deep);">GLP-1 medication</p>
              <h3 class="lp-card__title">Doses, half-life, site rotation</h3>
              <p>
                Track injections by date and site, watch the half-life decay
                curve, and get a reminder the day the next one is due.
              </p>
            </div>
          </article>

          {/* Weight & body */}
          <article class="lp-card lp-card--feature">
            <div class="lp-card__scene lp-scene--wgt">
              <div class="lp-scene-scale">
                <div class="lp-scale__display">
                  {scaleChars.map((c) =>
                    c === '.' ? (
                      <span class="lp-scale__dot" aria-hidden="true"></span>
                    ) : (
                      <svg class="lp-scale__digit" width="26" height="52" viewBox="0 0 25 50" aria-hidden="true">
                        {SEG_RECTS.map((s) => (
                          <rect
                            x={s.x}
                            y={s.y}
                            width={s.w}
                            height={s.h}
                            rx={Math.min(s.w, s.h) / 2}
                            class={(SEG_MAP[Number(c)] ?? '').includes(s.name) ? 'lp-scale__seg-on' : 'lp-scale__seg-off'}
                          ></rect>
                        ))}
                      </svg>
                    )
                  )}
                  <span class="lp-scale__unit">lb</span>
                </div>
                <div class="lp-scale__platform" aria-hidden="true"></div>
              </div>
            </div>
            <div class="lp-card__body">
              <p class="lp-card__eyebrow" style="color: var(--lp-wgt-deep);">Weight &amp; body</p>
              <h3 class="lp-card__title">Step on. Settle in.</h3>
              <p>
                Daily weight, body measurements and progress photos in one place
                — or logged from the watch and picked up by the phone.
              </p>
            </div>
          </article>

          {/* Well-being — narrow */}
          <article class="lp-card lp-card--feature-narrow">
            <div class="lp-card__scene lp-scene--act">
              <svg class="lp-mini-radar" viewBox="0 0 120 120" aria-hidden="true">
                <circle cx={rcx} cy={rcy} r={rmax} fill="none" stroke="rgba(59, 98, 16, 0.18)"></circle>
                <circle cx={rcx} cy={rcy} r={rmax * 0.66} fill="none" stroke="rgba(59, 98, 16, 0.14)"></circle>
                <circle cx={rcx} cy={rcy} r={rmax * 0.33} fill="none" stroke="rgba(59, 98, 16, 0.10)"></circle>
                <path d={radarOuterD} fill="none" stroke="rgba(59, 98, 16, 0.20)"></path>
                <path d={radarInnerD} fill="rgba(127, 174, 68, 0.30)" stroke="#3b6210" stroke-width="1.6"></path>
                {radarOuter.map(([x, y], i) => (
                  <text
                    x={x + (i === 1 ? 4 : i === 3 ? -4 : 0)}
                    y={y + (i === 0 ? -4 : i === 2 ? 10 : 4)}
                    font-size="8"
                    font-weight="700"
                    fill="#3b6210"
                    text-anchor="middle"
                    style="letter-spacing: 0.06em;"
                  >{radarLabels[i]}</text>
                ))}
              </svg>
            </div>
            <div class="lp-card__body">
              <p class="lp-card__eyebrow" style="color: var(--lp-act-deep);">Well-being</p>
              <h3 class="lp-card__title">Mood, energy, hunger, sleep</h3>
              <p>
                A 10-second daily check-in — from the phone, or off the watch
                with a turn of the Digital Crown.
              </p>
            </div>
          </article>

          {/* Medical records — wide */}
          <article class="lp-card lp-card--feature-wide">
            <div class="lp-card__scene lp-scene--neut">
              <div class="lp-vitals">
                {vitals.map((v) => (
                  <div class="lp-vitals__cell">
                    <p class="lp-vitals__label" style={`color: ${v.color};`}>{v.lbl}</p>
                    <p class="lp-vitals__val">{v.val}</p>
                  </div>
                ))}
              </div>
            </div>
            <div class="lp-card__body">
              <p class="lp-card__eyebrow" style="color: var(--lp-wood-800);">Medical records</p>
              <h3 class="lp-card__title">Vitals, labs, diagnoses, meds — alongside your daily log</h3>
              <p>
                Keep HbA1c, BP, your active medication list and visit notes next
                to the readings you actually take — then hand your doctor a
                printed report generated on the phone.
              </p>
            </div>
          </article>
        </div>
      </section>

      {/* ── Platform ── */}
      <section class="lp-section lp-section--tight" id="platform">
        <div class="lp-section__head">
          <p class="lp-eyebrow">Built for the platform</p>
          <h2 class="lp-section__title">
            The parts you only get by going <em>native</em>.
          </h2>
        </div>

        <div class="lp-plat">
          {platform.map((p) => (
            <article class="lp-plat__item">
              <p class="lp-plat__eyebrow">{p.eyebrow}</p>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </article>
          ))}
        </div>
      </section>

      {/* ── Native highlights + backup ── */}
      <section class="lp-native">
        <div class="lp-native__grid">
          <div class="lp-native__phone" aria-hidden="true">
            <PhoneMock tone="enamel">
              <TarePhone />
            </PhoneMock>
          </div>

          <div class="lp-native__text">
            <span class="lp-native__eyebrow">
              <span class="lp-native__dot"></span>
              {native.thesis}
            </span>
            <h2 class="lp-native__title">
              The same history, with <em>no account at all.</em>
            </h2>
            <p class="lp-native__sub">{native.intro}</p>

            <div class="lp-native__list">
              {
                native.highlights.map((h) => (
                  <div class="lp-native__item">
                    <span class="lp-native__icon">
                      <Icon name={h.icon} size={15} />
                    </span>
                    <div>
                      <strong>{h.title}</strong>
                      <span>{h.body}</span>
                    </div>
                  </div>
                ))
              }
            </div>

            <ul class="lp-native__tech">
              {native.tech.map((t) => <li>{t}</li>)}
            </ul>

            <p class="lp-native__meta">
              <span class="lp-native__beta">{NATIVE_STATUS_LABELS[native.status]}</span>
              <span>{native.minOS} or later &middot; {native.devices}</span>
              <span>No public listing or announced price</span>
              <a href="/ios#tare">More about the native apps</a>
            </p>
          </div>
        </div>
      </section>

      {/* ── Finale + privacy line ── */}
      <section class="lp-finale">
        <h2 class="lp-finale__title">
          Ready to reset your <em>baseline?</em>
        </h2>
        <p class="lp-finale__lede">
          One calm space for glucose, doses, weight and well-being — on your
          iPhone, your iPad and your wrist, ready whenever you are.
        </p>
        <p class="lp-finale__foot">Tare &middot; Reset to baseline. Every week.</p>
        <p class="lp-finale__privacy">
          Questions about your data? Read the <a href="/tare/privacy">Tare Privacy Policy</a>.
        </p>
      </section>
    </div>
  </div>
</BaseLayout>
