---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/tare-landing.css';

/* ── Trust strip (identity copy reworded; no auth language) ── */
const trust = [
  { num: 'Per-user', tail: 'SQLite',   lbl: 'Your data, your own file — no shared multi-tenant database.' },
  { num: 'Daily',    tail: 'backups',  lbl: 'Server-level snapshots plus on-demand JSON export, any time.' },
  { num: 'Secure',   tail: 'identity', lbl: 'Verified identity on every request. No new password to remember.' },
  { num: 'Claude',   tail: 'insights', lbl: 'AI summaries grounded in your own readings, never trained on.' },
];

/* ── A week in Tare — rendered in its final, settled state ── */
const dayLabels = ['M', 'T', 'W', 'T', 'F', 'S', 'S'];
const dayNums = [21, 22, 23, 24, 25, 26, 27];

const demo = {
  question: 'How am I doing this week?',
  answer:
    "Your fasting glucose averaged 102 this week — your best stretch in 30 days. Weight is down 1.6 lb, holding the 2 lb/month pace. Sunday's injection lands right on schedule.",
  toast: 'A1C trajectory ↗ improving',
};

const demoSteps = [
  {
    n: 1,
    title: 'You log what happened',
    body: 'A glucose reading, an injection, a number on the scale. Tare fills your week one tap at a time.',
  },
  {
    n: 2,
    title: 'You ask anything',
    body: '"How am I doing?", "Should I change anything?", "Is my dose working?" — in plain language.',
  },
  {
    n: 3,
    title: 'Tare answers from your data',
    body: 'Claude looks at the readings you logged this week and writes a calm, specific summary — not a generic tip.',
  },
];

/* ── Wellbeing radar geometry (final visible state) ── */
const rcx = 60, rcy = 60, rmax = 52;
const radarAngles = [-90, 0, 90, 180].map((d) => (d * Math.PI) / 180);
const radarLabels = ['Mood', 'Energy', 'Hunger', 'Sleep'];
const radarValues = [0.78, 0.65, 0.48, 0.72];
const radarOuter = radarAngles.map((a) => [rcx + Math.cos(a) * rmax, rcy + Math.sin(a) * rmax]);
const radarInner = radarAngles.map((a, i) => {
  const r = rmax * radarValues[i];
  return [rcx + Math.cos(a) * r, rcy + Math.sin(a) * r];
});
const radarOuterD = `M ${radarOuter.map(([x, y]) => `${x},${y}`).join(' L ')} Z`;
const radarInnerD = `M ${radarInner.map(([x, y]) => `${x},${y}`).join(' L ')} Z`;

/* ── Journey mini-chart dots ── */
const chartDots = [[0, 118], [65, 99], [130, 70], [195, 46], [260, 28]];

/* ── 7-segment digit definitions for the weight scale (final reading 248.4) ── */
const SEG_RECTS = [
  { name: 'a', x: 4,  y: 0,  w: 16, h: 3 },
  { name: 'b', x: 21, y: 4,  w: 3,  h: 18 },
  { name: 'c', x: 21, y: 27, w: 3,  h: 18 },
  { name: 'd', x: 4,  y: 47, w: 16, h: 3 },
  { name: 'e', x: 1,  y: 27, w: 3,  h: 18 },
  { name: 'f', x: 1,  y: 4,  w: 3,  h: 18 },
  { name: 'g', x: 4,  y: 23, w: 16, h: 3 },
];
const SEG_MAP: Record<number, string> = {
  0: 'abcdef', 1: 'bc', 2: 'abdeg', 3: 'abcdg', 4: 'bcfg',
  5: 'acdfg', 6: 'acdefg', 7: 'abc', 8: 'abcdefg', 9: 'abcdfg',
};
const scaleChars = '248.4'.split('');

const vitals = [
  { lbl: 'HBA1C',    val: '6.1%',   color: '#7c3aed' },
  { lbl: 'BP',       val: '118/76', color: '#dc2626' },
  { lbl: 'WEIGHT',   val: '248 lb', color: '#d97706' },
  { lbl: 'A1C TRAJ', val: '↘ −0.4', color: '#16a34a' },
];
---

<BaseLayout
  bare
  noindex
  path="/tare"
  title="Tare — Reset to baseline. Every week."
  description="A warm, focused space for your GLP-1 journey — glucose, injections, weight, and well-being, with AI summaries grounded in your own data."
>
  <link
    slot="head"
    rel="preconnect"
    href="https://fonts.googleapis.com"
  />
  <link
    slot="head"
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  />
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Inter+Tight:ital,wght@0,600;0,700;1,700&display=swap"
  />

  <div class="lp-root">
    {/* ── Background atmosphere ── */}
    <div class="lp-bg" aria-hidden="true">
      <div class="lp-bg__grain"></div>
      <div class="lp-bg__orb lp-bg__orb--a"></div>
      <div class="lp-bg__orb lp-bg__orb--b"></div>
      <div class="lp-bg__orb lp-bg__orb--c"></div>
    </div>

    <div class="lp-content">
      {/* ── Nav (brand only) ── */}
      <nav class="lp-nav">
        <div class="lp-nav__inner">
          <div class="lp-nav__brand">
            <span class="lp-nav__brand-mark">
              <svg width="100%" height="100%" viewBox="0 0 40 40" aria-hidden="true">
                <defs>
                  <linearGradient id="lp-brand-glyph" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0%" stop-color="#e6a44d"></stop>
                    <stop offset="100%" stop-color="#b86c1e"></stop>
                  </linearGradient>
                </defs>
                <rect x="2" y="9" width="36" height="22" rx="11" fill="url(#lp-brand-glyph)"></rect>
                <rect x="2" y="9" width="18" height="22" rx="11" fill="#fdf8f1"></rect>
                <line x1="20" y1="11" x2="20" y2="29" stroke="#75421d" stroke-width="0.6" opacity="0.45"></line>
              </svg>
            </span>
            <span>Tare</span>
          </div>
        </div>
      </nav>

      {/* ── Hero ── */}
      <section class="lp-hero">
        <div class="lp-hero__copy">
          <p class="lp-eyebrow">GLP-1 &amp; Metabolic Health</p>
          <h1 class="lp-hero__title">
            Track your week. <em>Reset to baseline.</em>
          </h1>
          <p class="lp-hero__lede">
            Glucose, injections, weight, and well-being — one warm, focused
            space for everything you&rsquo;re working on. Your data lives in a
            database that&rsquo;s only yours.
          </p>
        </div>

        {/* Floating dashboard mockup */}
        <div class="lp-hero__mockup-wrap">
          <div class="lp-mockup">
            <div class="lp-mockup__bar">
              <span class="lp-mockup__dot"></span>
              <span class="lp-mockup__dot"></span>
              <span class="lp-mockup__dot"></span>
              <span class="lp-mockup__bar-label">Today's view</span>
            </div>

            <p class="lp-mockup__eyebrow">Thursday · May 27</p>
            <p class="lp-mockup__greet">Good morning</p>

            <div class="lp-mockup__journey">
              <div class="lp-mockup__chip" style="background: #fce4d8;">
                <p class="lp-mockup__chip-val" style="color: #9a3412;">312</p>
                <p class="lp-mockup__chip-label" style="color: #c2410c;">days · Dx</p>
              </div>
              <div class="lp-mockup__chip" style="background: #dde9d3;">
                <p class="lp-mockup__chip-val" style="color: #365314;">96</p>
                <p class="lp-mockup__chip-label" style="color: #4d7c0f;">days · Keto</p>
              </div>
              <div class="lp-mockup__chip" style="background: #fbeed8;">
                <p class="lp-mockup__chip-val" style="color: #92521b;">58</p>
                <p class="lp-mockup__chip-label" style="color: #b86c1e;">days · Mounjaro</p>
              </div>
            </div>

            <div class="lp-mockup__tiles">
              <div class="lp-mockup__tile" style="background: #fce4d8;">
                <div class="lp-mockup__tile-icon" style="color: #c2410c;">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m10.5 20.5 10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z"></path><path d="m8.5 8.5 7 7"></path></svg>
                </div>
                <p class="lp-mockup__tile-eyebrow" style="color: #9a3412;">NEXT DOSE</p>
                <p class="lp-mockup__tile-val">Sun 8:30</p>
                <p class="lp-mockup__tile-foot">Mounjaro · 7.5 mg</p>
              </div>
              <div class="lp-mockup__tile" style="background: #ede5f4;">
                <div class="lp-mockup__tile-icon" style="color: #6d28d9;">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"></path><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"></path><path d="M7 21h10"></path><path d="M12 3v18"></path><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"></path></svg>
                </div>
                <p class="lp-mockup__tile-eyebrow" style="color: #4c1d95;">WEIGHT</p>
                <p class="lp-mockup__tile-val">248.4</p>
                <p class="lp-mockup__tile-foot">lb · -1.6 this month</p>
              </div>
              <div class="lp-mockup__tile" style="background: #dceef7;">
                <div class="lp-mockup__tile-icon" style="color: #0c4a6e;">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 16.3c2.2 0 4-1.83 4-4.05 0-1.16-.57-2.26-1.71-3.19S7.29 4.24 7 2c-.29 2.24-1.14 4.13-2.29 5.06S3 11.1 3 12.25c0 2.22 1.8 4.05 4 4.05Z"></path><path d="M12.56 6.6A10.97 10.97 0 0 0 14 3.02c.5 2.5 2 4.9 4 6.5s3 3.5 3 5.5a6.98 6.98 0 0 1-11.91 4.97"></path></svg>
                </div>
                <p class="lp-mockup__tile-eyebrow" style="color: #0c4a6e;">GLUCOSE</p>
                <p class="lp-mockup__tile-val">108</p>
                <p class="lp-mockup__tile-foot">mg/dL · normal</p>
              </div>
              <div class="lp-mockup__tile" style="background: #dde9d3;">
                <div class="lp-mockup__tile-icon" style="color: #365314;">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"></path></svg>
                </div>
                <p class="lp-mockup__tile-eyebrow" style="color: #365314;">WELL-BEING</p>
                <p class="lp-mockup__tile-val">7</p>
                <p class="lp-mockup__tile-foot">mood · energy 6</p>
              </div>
            </div>

            <span class="lp-mockup__chip-float lp-mockup__chip-float--right">
              <span class="lp-pulse-dot"></span> Live · synced
            </span>
            <span class="lp-mockup__chip-float lp-mockup__chip-float--left">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--lp-brand-700)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .962 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.962 0z"></path><path d="M20 3v4"></path><path d="M22 5h-4"></path><path d="M4 17v2"></path><path d="M5 18H3"></path></svg>
              Insight ready
            </span>
          </div>
        </div>
      </section>

      {/* ── Trust strip ── */}
      <section class="lp-trust">
        <div class="lp-trust__inner">
          {trust.map((t) => (
            <div>
              <p class="lp-trust__item-num"><em>{t.num}</em> {t.tail}</p>
              <p class="lp-trust__item-lbl">{t.lbl}</p>
            </div>
          ))}
        </div>
      </section>

      {/* ── A week in Tare ── */}
      <section class="lp-section">
        <div class="lp-section__head">
          <p class="lp-eyebrow">A week in Tare</p>
          <h2 class="lp-section__title">
            Watch a week come <em>together</em>.
          </h2>
          <p class="lp-section__lede">
            Log what happened — a reading, a shot, a number on the scale — and
            your weekly story writes itself. Ask Tare how you&rsquo;re doing and
            the answer is grounded in your own data, not generic advice.
          </p>
        </div>

        <div class="lp-demo">
          <div class="lp-demo__panel">
            <div class="lp-demo__panel-head">
              <span>This week</span>
              <span class="lp-demo__panel-tag">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2v4"></path><path d="M16 2v4"></path><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M3 10h18"></path></svg>
                May 21–27
              </span>
            </div>

            <div class="lp-week">
              {dayLabels.map((d, i) => (
                <div class="lp-week__day">
                  <p class="lp-week__day-label">{d}</p>
                  <div class="lp-week__day-box lp-week__day-box--on">
                    <span class="lp-week__day-num">{dayNums[i]}</span>
                    <span class="lp-week__check" style="opacity: 1;">
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
                    </span>
                  </div>
                </div>
              ))}
            </div>

            <div class="lp-thread">
              <div class="lp-bubble lp-bubble--user">{demo.question}</div>
              <div class="lp-bubble lp-bubble--ai">{demo.answer}</div>
              <div class="lp-toast">
                <svg class="lp-toast__icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .962 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.962 0z"></path><path d="M20 3v4"></path><path d="M22 5h-4"></path><path d="M4 17v2"></path><path d="M5 18H3"></path></svg>
                {demo.toast}
              </div>
            </div>
          </div>

          <div class="lp-demo__side">
            {demoSteps.map((s, idx) => (
              <div class={`lp-demo__step${idx === 2 ? ' lp-demo__step--active' : ''}`}>
                <span class="lp-demo__step-bullet">{s.n}</span>
                <div>
                  <p class="lp-demo__step-title">{s.title}</p>
                  <p class="lp-demo__step-body">{s.body}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* ── Features bento ── */}
      <section class="lp-section" id="features" style="padding-top: 0;">
        <div class="lp-section__head">
          <p class="lp-eyebrow">Everything Tare tracks</p>
          <h2 class="lp-section__title">
            Six surfaces, one calm <em>workspace</em>.
          </h2>
        </div>

        <div class="lp-bento">
          {/* Journey & Insights — tall */}
          <article class="lp-card lp-card--feature-tall">
            <div class="lp-card__scene lp-scene--neut">
              <svg class="lp-mini-chart" viewBox="0 0 260 150" aria-hidden="true">
                {[36, 70, 104].map((y) => (
                  <line x1="0" y1={y} x2="260" y2={y} stroke="rgba(168, 128, 73, 0.18)"></line>
                ))}
                <path class="lp-mini-chart__area" d="M 0,118 C 50,108 90,90 130,70 C 170,52 210,38 260,28 L 260,142 L 0,142 Z"></path>
                <path class="lp-mini-chart__line" d="M 0,118 C 50,108 90,90 130,70 C 170,52 210,38 260,28"></path>
                {chartDots.map(([cx, cy], i) => (
                  <circle class="lp-mini-chart__dot" cx={cx} cy={cy} r={i === 4 ? 5.5 : 3.5}></circle>
                ))}
              </svg>
            </div>
            <div class="lp-card__body">
              <p class="lp-card__eyebrow" style="color: var(--lp-brand-700);">Journey &amp; Insights</p>
              <h3 class="lp-card__title">A clear view of the whole arc</h3>
              <p>
                Days since diagnosis, weeks on medication, estimated A1C, and a
                30-day weight + glucose trend — all stitched together so you can
                see what&rsquo;s actually working.
              </p>
            </div>
          </article>

          {/* Blood glucose */}
          <article class="lp-card lp-card--feature">
            <div class="lp-card__scene lp-scene--glu">
              <svg width="44" height="60" viewBox="0 0 44 60" aria-hidden="true">
                <defs>
                  <linearGradient id="lp-drop-r" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#a4cae9"></stop>
                    <stop offset="100%" stop-color="#3884c4"></stop>
                  </linearGradient>
                </defs>
                <path d="M22 4 C 8 22, 4 38, 22 56 C 40 38, 36 22, 22 4 Z" fill="url(#lp-drop-r)"></path>
                <ellipse cx="16" cy="22" rx="5" ry="3" fill="rgba(255,255,255,0.55)"></ellipse>
              </svg>
            </div>
            <div class="lp-card__body">
              <p class="lp-card__eyebrow" style="color: var(--lp-glu-deep);">Blood glucose</p>
              <h3 class="lp-card__title">Readings, ranges, weekly trends</h3>
              <p>
                Log fasting, post-meal, or random readings. See your range hold,
                and watch your typical day shift toward normal.
              </p>
            </div>
          </article>

          {/* GLP-1 medication */}
          <article class="lp-card lp-card--feature">
            <div class="lp-card__scene lp-scene--meds">
              <svg width="120" height="48" viewBox="0 0 200 80" aria-hidden="true">
                <defs>
                  <linearGradient id="lp-cap-rL" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0%" stop-color="#fff7ee"></stop>
                    <stop offset="100%" stop-color="#fce4d8"></stop>
                  </linearGradient>
                  <linearGradient id="lp-cap-rR" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0%" stop-color="#f59669"></stop>
                    <stop offset="100%" stop-color="#c2410c"></stop>
                  </linearGradient>
                </defs>
                <rect x="0" y="0" width="100" height="80" rx="40" fill="url(#lp-cap-rL)"></rect>
                <rect x="100" y="0" width="100" height="80" rx="40" fill="url(#lp-cap-rR)"></rect>
                <ellipse cx="40" cy="20" rx="22" ry="6" fill="rgba(255,255,255,0.5)"></ellipse>
                <ellipse cx="140" cy="20" rx="22" ry="6" fill="rgba(255,255,255,0.18)"></ellipse>
              </svg>
            </div>
            <div class="lp-card__body">
              <p class="lp-card__eyebrow" style="color: var(--lp-meds-deep);">GLP-1 medication</p>
              <h3 class="lp-card__title">Doses, half-life, site rotation</h3>
              <p>
                Track injections by date and site. See the half-life decay curve
                so the next dose is never a guess.
              </p>
            </div>
          </article>

          {/* Weight & body */}
          <article class="lp-card lp-card--feature">
            <div class="lp-card__scene lp-scene--wgt">
              <div class="lp-scene-scale">
                <div class="lp-scale__display">
                  {scaleChars.map((c) =>
                    c === '.' ? (
                      <span class="lp-scale__dot" aria-hidden="true"></span>
                    ) : (
                      <svg class="lp-scale__digit" width="26" height="52" viewBox="0 0 25 50" aria-hidden="true">
                        {SEG_RECTS.map((s) => (
                          <rect
                            x={s.x}
                            y={s.y}
                            width={s.w}
                            height={s.h}
                            rx={Math.min(s.w, s.h) / 2}
                            class={(SEG_MAP[Number(c)] ?? '').includes(s.name) ? 'lp-scale__seg-on' : 'lp-scale__seg-off'}
                          ></rect>
                        ))}
                      </svg>
                    )
                  )}
                  <span class="lp-scale__unit">lb</span>
                </div>
                <div class="lp-scale__platform" aria-hidden="true"></div>
              </div>
            </div>
            <div class="lp-card__body">
              <p class="lp-card__eyebrow" style="color: var(--lp-wgt-deep);">Weight &amp; body</p>
              <h3 class="lp-card__title">Step on. Settle in.</h3>
              <p>
                Daily weight, body measurements, and progress photos in one
                place. Each morning&rsquo;s reading lands a little lower.
              </p>
            </div>
          </article>

          {/* Well-being — narrow */}
          <article class="lp-card lp-card--feature-narrow">
            <div class="lp-card__scene lp-scene--act">
              <svg class="lp-mini-radar" viewBox="0 0 120 120" aria-hidden="true">
                <circle cx={rcx} cy={rcy} r={rmax} fill="none" stroke="rgba(54, 83, 20, 0.18)"></circle>
                <circle cx={rcx} cy={rcy} r={rmax * 0.66} fill="none" stroke="rgba(54, 83, 20, 0.14)"></circle>
                <circle cx={rcx} cy={rcy} r={rmax * 0.33} fill="none" stroke="rgba(54, 83, 20, 0.10)"></circle>
                <path d={radarOuterD} fill="none" stroke="rgba(54, 83, 20, 0.20)"></path>
                <path d={radarInnerD} fill="rgba(126, 167, 100, 0.30)" stroke="#365314" stroke-width="1.6"></path>
                {radarOuter.map(([x, y], i) => (
                  <text
                    x={x + (i === 1 ? 4 : i === 3 ? -4 : 0)}
                    y={y + (i === 0 ? -4 : i === 2 ? 10 : 4)}
                    font-size="8"
                    font-weight="700"
                    fill="#365314"
                    text-anchor="middle"
                    style="letter-spacing: 0.06em;"
                  >{radarLabels[i]}</text>
                ))}
              </svg>
            </div>
            <div class="lp-card__body">
              <p class="lp-card__eyebrow" style="color: var(--lp-act-deep);">Well-being</p>
              <h3 class="lp-card__title">Mood, energy, hunger, sleep</h3>
              <p>
                A 10-second daily check-in. The radar shows the shape of your week.
              </p>
            </div>
          </article>

          {/* Medical records — wide */}
          <article class="lp-card lp-card--feature-wide">
            <div class="lp-card__scene lp-scene--neut">
              <div class="lp-vitals">
                {vitals.map((v) => (
                  <div class="lp-vitals__cell">
                    <p class="lp-vitals__label" style={`color: ${v.color};`}>{v.lbl}</p>
                    <p class="lp-vitals__val">{v.val}</p>
                  </div>
                ))}
              </div>
            </div>
            <div class="lp-card__body">
              <p class="lp-card__eyebrow" style="color: var(--lp-wood-800);">Medical records</p>
              <h3 class="lp-card__title">Vitals, labs, diagnoses, meds — alongside your daily log</h3>
              <p>
                Keep HbA1c, BP, your active medication list, and visit notes next
                to the readings you actually take. No more flipping between portals.
              </p>
            </div>
          </article>
        </div>
      </section>

      {/* ── Finale + privacy line ── */}
      <section class="lp-finale">
        <h2 class="lp-finale__title">
          Ready to reset your <em>baseline?</em>
        </h2>
        <p class="lp-finale__lede">
          Your private workspace — one calm space for glucose, doses, weight,
          and well-being, ready whenever you are.
        </p>
        <p class="lp-finale__foot">Tare · Reset to baseline. Every week.</p>
        <p class="lp-finale__privacy">
          Questions about your data? Read the <a href="/tare/privacy">Tare Privacy Policy</a>.
        </p>
      </section>
    </div>
  </div>
</BaseLayout>
