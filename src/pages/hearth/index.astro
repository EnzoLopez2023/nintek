---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NintekBack from '../../components/NintekBack.astro';
import '../../styles/hearth-landing.css';

/* ── Drifting embers (rendered statically; CSS drift loop is guarded by
   prefers-reduced-motion). Ports the original Framer-Motion ember set. ── */
const embers = [
  { left: '8%',  top: '22%', delay: 0,   dur: 14 },
  { left: '85%', top: '14%', delay: 2.5, dur: 18 },
  { left: '70%', top: '70%', delay: 5,   dur: 16 },
  { left: '18%', top: '78%', delay: 1.4, dur: 20 },
  { left: '50%', top: '36%', delay: 7,   dur: 22 },
  { left: '92%', top: '52%', delay: 3.8, dur: 15 },
];

/* ── The "Right now in your home" feed — shown in its final, settled state.
   Each line is a real thing Hearth tracks; the last line carries the cursor.
   The spread is deliberate: two household lines, two growing-season lines,
   two infrastructure lines — the same range the app itself covers. ── */
const feed = [
  { key: 'Furnace filter',         val: 'last changed 11 weeks ago — due in ',  emp: '12 days',                    tone: 'amber' },
  { key: 'Lawn',                   val: 'mowed 6 days ago — fertilizer next ',  emp: 'Saturday',                   tone: 'good' },
  { key: 'Tomatoes',               val: 'transplanted 3 weeks ago — first pick ', emp: 'around June 14',           tone: 'good' },
  { key: 'Pool',                   val: 'free chlorine 1.8 ppm — ',             emp: 'under the 2–4 window',       tone: 'rust' },
  { key: 'UPS Tower',              val: 'on mains, 100% — ',                    emp: '47 min runtime',             tone: 'info' },
  { key: 'DS1821+',                val: '68% full — ',                          emp: 'about 14 months of headroom', tone: 'info' },
];
---

<BaseLayout
  bare
  noindex
  path="/hearth"
  title="Hearth — Your home, all in one place."
  description="A household hub that grew into a home operations centre — recipes, maintenance, the garden plan, the pool's water chemistry, and read-only monitoring for the UPS, network, cameras and NAS."
>
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,700;1,700&display=swap"
  />

  <div class="hl">
    {/* atmosphere */}
    <div class="hl-atmos" aria-hidden="true"></div>
    {embers.map((e) => (
      <div
        class="hl-ember"
        aria-hidden="true"
        style={`left:${e.left};top:${e.top};animation-duration:${e.dur}s;animation-delay:${e.delay}s;`}
      ></div>
    ))}

    {/* ── Nav (brand only) ── */}
    <nav class="hl-nav">
      <NintekBack />
      <div class="hl-nav-brand">
        <span class="hl-nav-mark">
          <svg viewBox="0 0 64 64" fill="none" aria-hidden="true">
            <svg x="-5.33" y="4" width="64" height="64" viewBox="0 0 24 24">
              <path
                d="M12 3c1.7 2.4 3.8 4 3.8 6.3 0 1.5-1.1 2.7-2.5 2.7-1.3 0-2.3-.9-2.3-2.2 0-.5.2-1 .5-1.4-1.6 1-2.5 2.7-2.5 4.6 0 2.9 2.3 5 5 5s5-2.3 5-5C19 8 15.5 5 12 3z"
                fill="#FFFFFF"
              ></path>
            </svg>
          </svg>
        </span>
        <span class="hl-nav-name">Hearth</span>
        <span class="hl-nav-tag">a place for the home you keep</span>
      </div>
    </nav>

    {/* ── Hero ── */}
    <section class="hl-hero">
      <div class="hl-container">
        <div class="hl-hero-grid">
          <div>
            <div class="hl-eyebrow">
              <span class="hl-eyebrow-dot"></span>
              A household hub
            </div>

            <h1 class="hl-hero-title">
              The home you keep — <em>kept warm</em>, in one place.
            </h1>

            <p class="hl-hero-sub">
              Hearth started with recipes and a filter-change log. It now
              plans the garden bed by bed, reads the pool&rsquo;s water tests,
              and quietly watches the UPS, the network, the cameras and the
              NAS. Twenty-seven views, one warm interface — a place for the
              records that keep a house running.
            </p>

            <div class="hl-cta-row">
              <a class="hl-btn-secondary" href="#hl-now-section">
                Take a look
              </a>
            </div>

            <p class="hl-cta-fine">
              Private to your household · per-user database · press{' '}
              <kbd>Ctrl</kbd> <kbd>K</kbd> to jump anywhere
            </p>
          </div>

          {/* ── Mockup: a stylized version of the real Dashboard ── */}
          <div class="hl-mockup-wrap">
            <div class="hl-mockup">
              <div class="hl-mock-topbar">
                <div class="hl-mock-topbar-left">
                  <span class="hl-mock-name">Hearth</span>
                  <span class="hl-mock-pill">v2.13.2</span>
                </div>
                <span class="hl-mock-greet">Welcome back, Enzo</span>
              </div>

              <div class="hl-mock-body">
                <h3 class="hl-mock-h1">Hearth</h3>
                <p class="hl-mock-tag">
                  The home you keep — kitchen, garden, pool and the systems
                  that keep the lights on.
                </p>

                <div class="hl-mock-eyebrow">Live Status</div>
                <div class="hl-mock-glance">
                  <div class="hl-mock-glance-card">
                    <div class="hl-mock-glance-label">Next task</div>
                    <div class="hl-mock-glance-val">Furnace filter</div>
                    <div class="hl-mock-glance-meta --rust">due in 12 days</div>
                  </div>
                  <div class="hl-mock-glance-card">
                    <div class="hl-mock-glance-label">UPS Tower</div>
                    <div class="hl-mock-glance-val">100%</div>
                    <div class="hl-mock-glance-meta --good">on mains · 47 min</div>
                  </div>
                  <div class="hl-mock-glance-card">
                    <div class="hl-mock-glance-label">Network</div>
                    <div class="hl-mock-glance-val">42</div>
                    <div class="hl-mock-glance-meta">clients online</div>
                  </div>
                </div>

                <div class="hl-mock-divider"></div>

                <div class="hl-mock-eyebrow">Quick Access</div>
                <div class="hl-mock-grid">
                  <div class="hl-mock-tile">
                    <div class="hl-mock-tile-icon">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M4 4h12a4 4 0 0 1 0 8h-2v8H8a4 4 0 0 1-4-4V4z"></path>
                        <line x1="8" y1="8" x2="12" y2="8"></line>
                        <line x1="8" y1="12" x2="12" y2="12"></line>
                        <line x1="8" y1="16" x2="11" y2="16"></line>
                      </svg>
                    </div>
                    <div class="hl-mock-tile-label">Recipe Manager</div>
                    <div class="hl-mock-tile-desc">Your recipe collection</div>
                  </div>
                  <div class="hl-mock-tile">
                    <div class="hl-mock-tile-icon">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M3 21l3-3 7-7-3-3-7 7-3 3z"></path>
                        <path d="M14 5l5 5"></path>
                        <path d="M17 2l5 5-4 4-5-5z"></path>
                      </svg>
                    </div>
                    <div class="hl-mock-tile-label">Home Maintenance</div>
                    <div class="hl-mock-tile-desc">Tasks &amp; warranties</div>
                  </div>
                  <div class="hl-mock-tile">
                    <div class="hl-mock-tile-icon">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 21v-8"></path>
                        <path d="M12 13c0-4 3-7 8-7 0 5-3 8-8 7z"></path>
                        <path d="M12 16c0-3-2.5-5.5-6-5.5 0 3.6 2.4 6 6 5.5z"></path>
                      </svg>
                    </div>
                    <div class="hl-mock-tile-label">Garden Planner</div>
                    <div class="hl-mock-tile-desc">Beds &amp; sowing calendar</div>
                  </div>
                  <div class="hl-mock-tile">
                    <div class="hl-mock-tile-icon">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="2" y="8" width="16" height="9" rx="2"></rect>
                        <path d="M22 11v3"></path>
                        <path d="M10 10.5 8 13h3l-2 2.5" stroke-width="1.6"></path>
                      </svg>
                    </div>
                    <div class="hl-mock-tile-label">Power Monitor</div>
                    <div class="hl-mock-tile-desc">Both UPS units</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ── Live "Right now" feed (final settled state) ── */}
    <section class="hl-now" id="hl-now-section">
      <div class="hl-container">
        <div class="hl-now-grid">
          <div class="hl-now-text">
            <div class="hl-eyebrow">
              <span class="hl-eyebrow-dot"></span>
              Right now
            </div>
            <h2>
              What Hearth knows about <em style="font-style: italic; color: var(--rust);">your home</em> today.
            </h2>
            <p>
              Filters that need changing. Lawn that needs mowing. Which bed
              the tomatoes went in and when they&rsquo;ll be ready. Whether the
              pool&rsquo;s chlorine drifted under range. How long the UPS would
              last if the power went now.
            </p>
            <p>
              Hearth keeps track so you don&rsquo;t have to remember — and so the
              state of your home is one calm screen away, in serif type,
              across every domain that touches it.
            </p>
          </div>

          <div class="hl-now-card">
            <div class="hl-now-windowdots">
              <span></span>
              <span></span>
              <span></span>
              <span class="hl-now-windowtitle">hearth · live feed</span>
            </div>

            {feed.map((line, i) => (
              <div class="hl-now-line">
                <span class={`hl-now-dot --${line.tone}`}></span>
                <span class="hl-now-text-line">
                  <span class="hl-now-key">{line.key}: </span>
                  <span class="hl-now-val">{line.val}</span>
                  <span class="hl-now-emp">{line.emp}</span>
                  {i === feed.length - 1 && <span class="hl-now-cursor"></span>}
                </span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* ── Features ── */}
    {/* ── The house ── */}
    <section class="hl-features">
      <div class="hl-container">
        <div class="hl-section-head">
          <div class="hl-eyebrow" style="justify-content: center;">
            <span class="hl-eyebrow-dot"></span>
            The house itself
          </div>
          <h2>Everything for the home you keep.</h2>
          <p>
            The domestic half of Hearth — the records that go stale if nobody
            writes them down. Log a quarterly filter change, plan the beds
            before the seed order, drop in the pool store&rsquo;s PDF and let it
            read itself, pull up tonight&rsquo;s mowing window.
          </p>
        </div>

        <div class="hl-feat-grid">
          <article class="hl-feat-card">
            <div class="hl-feat-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 4h12a4 4 0 0 1 0 8h-2v8H8a4 4 0 0 1-4-4V4z"></path>
                <line x1="8" y1="8" x2="12" y2="8"></line>
                <line x1="8" y1="12" x2="12" y2="12"></line>
                <line x1="8" y1="16" x2="11" y2="16"></line>
              </svg>
            </div>
            <h3 class="hl-feat-h3">Recipe Manager</h3>
            <p class="hl-feat-desc">
              Recipes with photos, scalable ingredients, AI nutrition analysis
              and lower-carb rewrites. The ingredient field autocompletes from
              whatever you have actually harvested out of the garden.
            </p>
            <div class="hl-feat-meta">
              <span class="hl-feat-tag">Nutrition AI</span>
              <span class="hl-feat-tag">Scaling</span>
              <span class="hl-feat-tag">Carb planner</span>
            </div>
          </article>

          <article class="hl-feat-card">
            <div class="hl-feat-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 21l3-3 7-7-3-3-7 7-3 3z"></path>
                <path d="M14 5l5 5"></path>
                <path d="M17 2l5 5-4 4-5-5z"></path>
              </svg>
            </div>
            <h3 class="hl-feat-h3">Home Maintenance</h3>
            <p class="hl-feat-desc">
              Every item in the house with its own service history — recurring
              tasks, warranty expiry, receipts, photos and what the upkeep has
              cost you so far.
            </p>
            <div class="hl-feat-meta">
              <span class="hl-feat-tag">Recurring tasks</span>
              <span class="hl-feat-tag">Warranties</span>
              <span class="hl-feat-tag">Costs</span>
            </div>
          </article>

          <article class="hl-feat-card hl-feat-card--new">
            <span class="hl-feat-new">New</span>
            <div class="hl-feat-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 21v-8"></path>
                <path d="M12 13c0-4 3-7 8-7 0 5-3 8-8 7z"></path>
                <path d="M12 16c0-3-2.5-5.5-6-5.5 0 3.6 2.4 6 6 5.5z"></path>
              </svg>
            </div>
            <h3 class="hl-feat-h3">Garden Planner</h3>
            <p class="hl-feat-desc">
              Lay out beds to scale and drag plants into them — positions are
              held in real inches, so it flags two plants crowding each other,
              anything overhanging a bed edge, and a family you already grew
              there in the last three seasons.
            </p>
            <div class="hl-feat-meta">
              <span class="hl-feat-tag">27 vegetables</span>
              <span class="hl-feat-tag">Rotation warnings</span>
              <span class="hl-feat-tag">Harvest analytics</span>
            </div>
          </article>

          <article class="hl-feat-card hl-feat-card--new">
            <span class="hl-feat-new">New</span>
            <div class="hl-feat-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3s5.5 6 5.5 9.5a5.5 5.5 0 0 1-11 0C6.5 9 12 3 12 3z"></path>
                <path d="M3 19c1.6 0 1.6 1.4 3.2 1.4S7.8 19 9.4 19s1.6 1.4 3.2 1.4S14.2 19 15.8 19s1.6 1.4 3.2 1.4"></path>
              </svg>
            </div>
            <h3 class="hl-feat-h3">Pool Maintenance</h3>
            <p class="hl-feat-desc">
              Drop in the water-test PDF from the pool store and Claude reads
              it — parameters, treatment steps, the analyst&rsquo;s handwriting and
              all. Or enter a Taylor K-2005 test by drop count and get dosing
              worked against the chemicals you actually keep in the shed.
            </p>
            <div class="hl-feat-meta">
              <span class="hl-feat-tag">AI-read reports</span>
              <span class="hl-feat-tag">Taylor K-2005</span>
              <span class="hl-feat-tag">Weather-correlated trends</span>
            </div>
          </article>

          <article class="hl-feat-card">
            <div class="hl-feat-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 21h14"></path>
                <path d="M7 21V11l5-7 5 7v10"></path>
                <path d="M10 21v-5h4v5"></path>
              </svg>
            </div>
            <h3 class="hl-feat-h3">Yard Maintenance</h3>
            <p class="hl-feat-desc">
              A lawn calendar that knows where you live. One ZIP sets the
              hardiness zone, the frost dates and the local pest pressure —
              and the garden borrows the same profile rather than asking twice.
            </p>
            <div class="hl-feat-meta">
              <span class="hl-feat-tag">Zone profile</span>
              <span class="hl-feat-tag">Frost dates</span>
              <span class="hl-feat-tag">Lawn diary</span>
            </div>
          </article>

          <article class="hl-feat-card hl-feat-card--wip">
            <span class="hl-feat-new hl-feat-new--wip">Taking shape</span>
            <div class="hl-feat-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 7l9-4 9 4-9 4-9-4z"></path>
                <path d="M3 12l9 4 9-4"></path>
                <path d="M3 17l9 4 9-4"></path>
              </svg>
            </div>
            <h3 class="hl-feat-h3">Home Inventory</h3>
            <p class="hl-feat-desc">
              What you own, where it lives and what it is worth — categories,
              nested locations, condition and replacement value. The database
              underneath is finished; the screens on top of it are still being
              built out.
            </p>
            <div class="hl-feat-meta">
              <span class="hl-feat-tag">Categories</span>
              <span class="hl-feat-tag">Locations</span>
              <span class="hl-feat-tag">In progress</span>
            </div>
          </article>
        </div>
      </div>
    </section>

    {/* ── Infrastructure ── */}
    <section class="hl-infra" id="hl-infra">
      <div class="hl-container">
        <div class="hl-infra-head">
          <div class="hl-eyebrow hl-eyebrow--dark">
            <span class="hl-eyebrow-dot"></span>
            The other half
          </div>
          <h2 class="hl-infra-title">
            And then it started watching <em>the house itself.</em>
          </h2>
          <p class="hl-infra-lede">
            A power cut took the network down while nobody was home, and it
            turned out nothing in the house could say what had happened or how
            close the batteries had come to empty. So Hearth grew a second
            half: three small agents on a machine in the office, reporting in
            on what the hardware is doing.
          </p>
        </div>

        <div class="hl-infra-grid">
          <article class="hl-infra-card">
            <h3>Power</h3>
            <p>
              Both UPS units over NUT — charge, load, runtime, input and output
              volts, temperature, and every raw variable the unit reports. It
              samples every fifteen seconds normally and drops to every thirty
              while running on battery, because an outage is exactly the part
              that was going unrecorded.
            </p>
            <div class="hl-infra-tags">
              <span>Outage timeline</span>
              <span>90 days</span>
            </div>
          </article>

          <article class="hl-infra-card">
            <h3>Power topology</h3>
            <p>
              A wiring diagram for the house: what is plugged into what, which
              outlets are battery-backed and which are only surge-protected,
              grouped into zones. Drag a cable to a different bank and the
              diagram follows. Exports to PNG, SVG or PDF.
            </p>
            <div class="hl-infra-tags">
              <span>Editable</span>
              <span>Live plug status</span>
            </div>
          </article>

          <article class="hl-infra-card">
            <h3>Network</h3>
            <p>
              Every UniFi device and client — port matrices with PoE state,
              throughput sparklines, top talkers, and an auto-drawn topology
              wired by real uplinks. A separate page reads the whole
              configuration, with WPA keys and RADIUS secrets stripped by the
              agent before they ever reach the database.
            </p>
            <div class="hl-infra-tags">
              <span>Topology</span>
              <span>Per-port detail</span>
            </div>
          </article>

          <article class="hl-infra-card">
            <h3>Cameras</h3>
            <p>
              UniFi Protect fleet health — which cameras are up, NVR drive
              temperatures and SMART state, contact and leak sensors, battery
              levels. An activity heatmap by camera and hour, and a recording
              forecast that regresses against real disk history to tell you
              when it will start overwriting.
            </p>
            <div class="hl-infra-tags">
              <span>Fleet uptime</span>
              <span>Storage forecast</span>
            </div>
          </article>

          <article class="hl-infra-card">
            <h3>Storage</h3>
            <p>
              Two Synology units — a DS1821+ and a DS1513+ — with volume fill
              rates, per-disk SMART and temperature, share growth over ninety
              days, and backup run history. It checks the boring things that
              only matter once: whether the NAS will restart when mains
              returns, and whether that bond really has both legs.
            </p>
            <div class="hl-infra-tags">
              <span>Fill-rate forecast</span>
              <span>Backup history</span>
            </div>
          </article>

          <article class="hl-infra-card">
            <h3>Addressing</h3>
            <p>
              A tracker for the long job of moving every device onto a planned
              static address — done a few at a time, over weeks. It knows the
              difference between an address that is genuinely pinned and one
              that merely happens to be right today on a lease that has not
              renewed yet.
            </p>
            <div class="hl-infra-tags">
              <span>Per-device state</span>
              <span>Resume cold</span>
            </div>
          </article>
        </div>

        <div class="hl-infra-notes">
          <div class="hl-infra-note">
            <h4>It watches. It does not touch.</h4>
            <p>
              Every monitoring page is read-only and says so in its own
              subtitle. There is no reboot button, no port toggle, no camera
              control. The agents make outbound calls only — nothing from
              outside reaches into the network.
            </p>
          </div>
          <div class="hl-infra-note">
            <h4>Except the one thing that should act.</h4>
            <p>
              A watchdog sits beside the UPS and will shut the machine down
              cleanly before the battery dies — but only on battery, only past
              a charge or runtime floor, and only after three consecutive
              readings agree. If mains returns while the countdown runs, it
              cancels itself.
            </p>
          </div>
          <div class="hl-infra-note">
            <h4>And it can reach your pocket.</h4>
            <p>
              When a subsystem changes state — the internet, the network, the
              power, the NAS, the cameras — Hearth pushes a notification. It
              fires on the change, not on the condition, so a long outage
              never turns into a stream of alerts.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ── The desk ── */}
    <section class="hl-features hl-features--desk">
      <div class="hl-container">
        <div class="hl-section-head">
          <div class="hl-eyebrow" style="justify-content: center;">
            <span class="hl-eyebrow-dot"></span>
            The desk in the corner
          </div>
          <h2>The rest of what accumulated.</h2>
          <p>
            A household hub is a convenient place to put things. Over time it
            collected the study material, the reference library, the media
            tooling and a small laboratory for comparing models against each
            other.
          </p>
        </div>

        <div class="hl-feat-grid">
          <article class="hl-feat-card">
            <div class="hl-feat-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3l1.6 3.4L17 8l-3.4 1.6L12 13l-1.6-3.4L7 8l3.4-1.6L12 3z"></path>
