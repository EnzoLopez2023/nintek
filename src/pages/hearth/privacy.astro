---
import DataLifecycleTable from '../../components/DataLifecycleTable.astro';
import LegalLayout from '../../layouts/LegalLayout.astro';
import { COMPANY, getApp } from '../../data/apps';

const app = getApp('hearth')!;
const effectiveDate = 'September 3, 2026';
const sections = [
  { href: '#scope', label: 'Scope' },
  { href: '#data', label: 'Data and providers' },
  { href: '#controls', label: 'Controls and limits' },
  { href: '#contact', label: 'Contact' },
];
const lifecycle = [
  {
    data: 'Account and household membership',
    location: 'Hearth-v2 resolves verified Microsoft Entra/OIDC identity to an app-local user and household membership.',
    portability: 'The audited source does not establish a public self-service account export.',
    deletion: 'Provider identity and app-local membership are separate. No public account-wide deletion or retention promise is established yet.',
  },
  {
    data: 'Household and property records',
    location: 'Maintenance, inventory, yard, garden, pool, recipe, and dashboard records are household-scoped in a migration-managed SQLite database.',
    portability: 'Keep independent originals of records or evidence that must survive outside Hearth.',
    deletion: 'Owned record APIs support deletion, but backup expiry and account-wide erasure are not represented as complete public controls.',
  },
  {
    data: 'Photos, documents, and reports',
    location: 'Authorized durable blob storage holds supported maintenance, warranty, receipt, inventory, and pool-report evidence.',
    portability: 'The audited source does not establish a complete public bulk-media export.',
    deletion: 'Unreferenced blob deletion is supported; storage-provider retention can continue under its own operational and legal rules.',
  },
  {
    data: 'Optional provider requests',
    location: 'Chosen recipe-AI, weather, or geocoding features send only the request needed to the configured provider.',
    portability: 'Review and save useful results into your own records; unsaved recipe drafts are not persisted by Hearth.',
    deletion: 'Provider logs and retention follow the selected provider’s terms. Optional providers are not startup requirements.',
  },
];
---

<LegalLayout
  app={app}
  title={`Hearth Privacy Policy — ${COMPANY.name}`}
  description="Current privacy boundaries for the private Hearth-v2 household and property fieldbook."
  path="/hearth/privacy"
  page="privacy"
  heading="Hearth Privacy Policy"
  documentMeta={`Effective ${effectiveDate} · Last reviewed ${effectiveDate}`}
  summary="This notice covers Hearth-v2, the current private household and property fieldbook. It does not describe the superseded Hearth monolith or the separate Prism, Watchtower, Lantern, Marquee, and ShapePilot products."
  sections={sections}
  evidenceNote="Scoped to Hearth-v2 source at 6c9a7922884c41813acd918b3fba395f8c447e9b. Public release, account-wide deletion, retention, and bulk-export controls are not claimed beyond that source."
>
  <section id="scope" class="legal-section">
    <h2>Scope and access</h2>
    <p>
      Hearth-v2 is a private household application. Protected APIs require a
      verified identity that resolves to an authorized household membership, and
      production fails closed when authentication is not configured. There is no
      public sign-up or acquisition route on this site.
    </p>
    <p>
      Development identity is a non-production testing facility and cannot be
      enabled in production. Hearth-v2 records are directly household-scoped or
      belong to a household-scoped parent.
    </p>
  </section>

  <section id="data" class="legal-section">
    <h2>Data and optional providers</h2>
    <p>
      Hearth processes the records you choose to keep for home maintenance,
      inventory, yard, garden, pool, recipes, costs, shopping context, and
      supporting photos or documents. Optional AI, weather, and geocoding
      providers are feature boundaries rather than startup dependencies.
    </p>
    <DataLifecycleTable caption="Hearth-v2 data lifecycle and current control boundaries" rows={lifecycle} />
  </section>

  <section id="controls" class="legal-section">
    <h2>Current controls and known limits</h2>
    <p>
      Hearth supports household-scoped record operations, strict validation, and
      authorized blob access. The audited source does not establish a public
      self-service account export, account-wide deletion flow, fixed retention
      schedule, or completed legacy-data cutover. This policy does not imply those
      controls exist.
    </p>
    <p>
      Legacy import is a separate, explicit operator action from a read-only
      snapshot. It is not a background migration, and the superseded runtime is
      not marketed here as the current product.
    </p>
  </section>

  <section id="contact" class="legal-section">
    <h2>Questions and requests</h2>
    <p>
      Privacy questions can be sent to
      <a href={`mailto:${COMPANY.privacyEmail}?subject=Hearth%20privacy`}>
        {COMPANY.privacyEmail}
      </a>.
      General product questions can be sent to
      <a href={`mailto:${COMPANY.email}?subject=Hearth`}>{COMPANY.email}</a>.
      Use of Hearth is subject to the <a href={app.termsPath}>Nintek Terms of Use</a>.
    </p>
  </section>
</LegalLayout>
