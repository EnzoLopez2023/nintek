---
import LegalLayout from '../../layouts/LegalLayout.astro';
import { COMPANY, getApp } from '../../data/apps';

const app = getApp('salvo')!;
const updatedDate = 'August 23, 2026';
const sections = [
  { href: '#availability', label: 'Availability' },
  { href: '#requirements', label: 'Requirements' },
  { href: '#local-progress', label: 'Local progress' },
  { href: '#troubleshooting', label: 'Troubleshooting' },
  { href: '#contact', label: 'Contact' },
];
---

<LegalLayout
  app={app}
  title={`${app.name} Support — ${COMPANY.name}`}
  description="Help with the unreleased Salvo iPad build, its 16 Age of Siege operations, local progress, offline behavior, and current release boundaries."
  path="/salvo/support"
  page="support"
  heading="Salvo Support"
  documentMeta={`Updated ${updatedDate} · Unreleased iPad build`}
  summary="Salvo version 1.0.0 build 4 is a private portrait-iPad candidate with 16 synchronized Age of Siege operations. It is not publicly released, and wider campaign content remains blocked."
  sections={sections}
  evidenceNote="Support guidance was reviewed against Salvo release source a73921c and immutable release-visual authority 3fb91b0 on August 23, 2026. Physical-iPad evidence is still pending."
>
  <section id="availability" class="legal-section">
    <h2>Current availability</h2>
    <p class="legal-callout">
      Build 4 is VALID and attached to an editable App Store version, but it
      remains PREPARE_FOR_SUBMISSION. There is no App Review submission, public
      TestFlight group, public App Store listing, authorized price, territory
      availability, or release date.
    </p>
    <p>
      The current executable contains 16 synchronized Age of Siege operations.
      The five-era framework and 1,000-map source draft are not complete public
      content claims; wider publication remains blocked pending pilot and blueprint
      approval.
    </p>
  </section>

  <section id="requirements" class="legal-section">
    <h2>Supported device and services</h2>
    <p>
      The current target is portrait-only iPad on iPadOS 15 or later, with an
      effective A12-class hardware floor. Salvo is local-first and works without a
      Nintek account or gameplay backend.
    </p>
    <p>
      Game Center is disabled and excluded from v1. The current build does not
      provide achievements, leaderboards, ranked scores, cloud saves, in-app
      purchases, or social submission.
    </p>
  </section>

  <section id="local-progress" class="legal-section">
    <h2>Local progress and reinstalling</h2>
    <p>
      Campaign progress, stars, settings, navigation state, and the highest
      completed endless wave are stored in a versioned JSON file inside the app
      container. Nintek has no server copy to restore.
    </p>
    <p>
      Do not delete or reinstall Salvo as an early troubleshooting step if the
      iPad may contain the only copy of progress you want to keep. Apple-managed
      device backups behave according to the Apple Account settings you control.
    </p>
  </section>

  <section id="troubleshooting" class="legal-section">
    <h2>Troubleshooting checklist</h2>
    <ol>
      <li>Confirm the device is a supported iPad running iPadOS 15 or later.</li>
      <li>Install the newest private build available through the authorized channel.</li>
      <li>Use portrait orientation and confirm the iPad has available storage.</li>
      <li>Restart the app and iPad before considering a reinstall.</li>
      <li>Record the build, operation, difficulty, last action, and visible error.</li>
    </ol>
  </section>

  <section id="contact" class="legal-section">
    <h2>Contact and legal documents</h2>
    <p>
      Email <a href={`mailto:${COMPANY.email}?subject=Salvo`}>{COMPANY.email}</a>
      with the iPad model, iPadOS version, Salvo build, affected operation, and
      steps already tried. Do not send Apple credentials or private account data.
    </p>
    <p>
      Read the <a href={app.privacyPath}>Salvo Privacy Policy</a> for local-data,
      backup, and no-collection boundaries. Use of Salvo is subject to the
      <a href={app.termsPath}>Nintek Terms of Use</a>.
    </p>
  </section>
</LegalLayout>
