---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NintekBack from '../../components/NintekBack.astro';
import BrandMark from '../../components/BrandMark.astro';
import { Image } from 'astro:assets';
import SalvoReleaseVisual from '../../components/SalvoReleaseVisual.astro';
import command from '../../assets/salvo/release/02-command.png';
import campaign from '../../assets/salvo/release/03-campaign.png';
import placement from '../../assets/salvo/release/04-placement.png';
import combat from '../../assets/salvo/release/05-combat.png';
import result from '../../assets/salvo/release/06-result.png';
import battlefield from '../../assets/salvo/battlefield.webp';
import towerSiege from '../../assets/salvo/tower-siege.webp';
import towerWastes from '../../assets/salvo/tower-wastes.webp';
import towerModern from '../../assets/salvo/tower-modern.webp';
import towerFuture from '../../assets/salvo/tower-future.webp';
import towerXeno from '../../assets/salvo/tower-xeno.webp';
import { getApp } from '../../data/apps';
import '../../styles/salvo-landing.css';

const app = getApp('salvo')!;

const eras = [
  {
    name: 'Siege',
    note: 'Castles and engines',
    tower: towerSiege,
  },
  {
    name: 'Wastes',
    note: 'Scrap and survival',
    tower: towerWastes,
  },
  {
    name: 'Modern',
    note: 'Combined arms',
    tower: towerModern,
  },
  {
    name: 'Future',
    note: 'Directed energy',
    tower: towerFuture,
  },
  {
    name: 'Xeno',
    note: 'Organic defense',
    tower: towerXeno,
  },
];

const pageTitle = 'Salvo - Unreleased tower defense for portrait iPad';
const description =
  'Salvo is an unreleased portrait-iPad tower-defense build with 16 synchronized Age of Siege operations; wider campaign content remains blocked.';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Salvo',
  applicationCategory: 'GameApplication',
  operatingSystem: 'iPadOS 15 or later',
  description,
  identifier: 'com.nintek.salvo',
  url: 'https://www.nintek.com/salvo',
};
---

<BaseLayout
  bare
  boardFonts
  path="/salvo"
  title={pageTitle}
  description={description}
  themeColor="#07101c"
  socialImage="/apps/salvo.png"
  socialImageAlt="Salvo app icon"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <!--
    THESIS: Salvo reads as a live campaign dossier, not a generic game grid; actual command screens and source art carry the proof while incomplete campaign scope stays visibly incomplete.
    OWN-WORLD: Command-night navy, ordnance amber, cool-white type, hard steel rules, painted battlefields, and era-specific tower art, with Nintek copper confined to the portfolio signature.
    STORY: Enter the current command surface, see the 16-operation Age of Siege campaign, distinguish the wider five-era framework from shipped content, then leave with exact privacy, device, and release facts.
    FIRST VIEWPORT: A broad command brief occupies the left while the automated release capture stands in a portrait iPad on the right, crossed once by a restrained amber instrument sweep.
    FORM: The sixth grounded structure, staged as a vertical field-command dispatch with real build evidence at every seam; seed 218250a5.
  -->
  <div class="sa-root">
    <header class="sa-nav">
      <div class="sa-shell sa-nav-inner">
        <div class="sa-nav-brand">
          <NintekBack />
          <a class="sa-wordmark" href="/salvo" aria-label="Salvo home">
            <img src="/apps/salvo.png" alt="" width="34" height="34" />
            <span>Salvo</span>
          </a>
        </div>
        <nav aria-label="Salvo">
          <a href="#command">Command</a>
          <a href="#eras">Campaign frame</a>
          <a href="#release">Release</a>
        </nav>
        <span class="sa-nav-state">In development</span>
      </div>
    </header>

    <main>
      <section
        class="sa-hero"
        style={`--sa-field: url(${battlefield.src});`}
        aria-labelledby="salvo-title"
      >
        <span class="sa-sweep" aria-hidden="true"></span>
        <div class="sa-shell sa-hero-grid">
          <div class="sa-hero-copy">
            <h1 id="salvo-title">
              One era playable.
              <span>A wider campaign waiting.</span>
            </h1>
            <p class="sa-hero-lede">
              Salvo is a portrait, touch-first tower-defense build for iPad. Its
              current executable contains 16 synchronized Age of Siege operations;
              the wider five-era campaign remains blocked on content approval.
            </p>
            <div class="sa-hero-actions">
              <a class="sa-button sa-button-primary" href="#command">
                Open the command brief
                <span aria-hidden="true">↓</span>
              </a>
              <a class="sa-button sa-button-secondary" href="#release">
                Check current status
              </a>
            </div>
            <p class="sa-hero-proof">
              Version 1.0.0 (4) <span aria-hidden="true">/</span>
              16 Age of Siege operations <span aria-hidden="true">/</span> unreleased
            </p>
          </div>

          <div class="sa-hero-device">
            <SalvoReleaseVisual eager />
          </div>
        </div>
      </section>

      <section id="command" class="sa-command" aria-labelledby="command-title">
        <div class="sa-shell sa-command-grid">
          <figure class="sa-capture sa-capture-command">
            <Image
              src={command}
              format="webp"
              widths={[420, 620, 820, 1032]}
              sizes="(max-width: 1000px) min(92vw, 520px), 42vw"
              alt="Salvo command screen with difficulty, campaign map, and endless mode controls"
              loading="lazy"
              decoding="async"
            />
            <figcaption>Automated release capture · not physical-device evidence</figcaption>
          </figure>
          <div class="sa-command-copy">
            <h2 id="command-title">The decision comes before the spectacle.</h2>
            <p>
              Salvo's command surface makes the next tactical choice legible:
              current operation, campaign progress, difficulty, campaign route,
              and a separate endless mode. The player always knows what will start
              before the battlefield opens.
            </p>
            <dl class="sa-brief-lines">
              <div>
                <dt>Difficulty</dt>
                <dd>Easy, Normal, and Hard are explicit choices.</dd>
              </div>
              <div>
                <dt>Campaign</dt>
                <dd>Progress moves through authored operations and era pages.</dd>
              </div>
              <div>
                <dt>Endurance</dt>
                <dd>A separate run records its highest completed wave on the device.</dd>
              </div>
              <div>
                <dt>Online service</dt>
                <dd>None. Game Center is disabled and excluded from v1.</dd>
              </div>
            </dl>
          </div>
        </div>
      </section>

      <section class="sa-campaign" aria-labelledby="campaign-title">
        <div class="sa-shell sa-campaign-grid">
          <div class="sa-campaign-copy">
            <h2 id="campaign-title">The campaign is real. It is not finished.</h2>
            <p>
              The current executable source contains 16 synchronized Age of Siege
              operations. A five-era framework exists, but the remaining campaign
              content is blocked pending pilot and blueprint approval.
            </p>
            <dl class="sa-campaign-ledger">
              <div><dt>Playable now</dt><dd>16 synchronized operations</dd></div>
              <div><dt>Campaign frame</dt><dd>5 military eras</dd></div>
              <div><dt>Current opening</dt><dd>Age of Siege</dd></div>
              <div><dt>Release claim</dt><dd>Pre-release, not content-complete</dd></div>
            </dl>
          </div>
          <figure class="sa-capture sa-capture-campaign">
            <Image
              src={campaign}
              format="webp"
              widths={[420, 620, 820, 1032]}
              sizes="(max-width: 1000px) min(92vw, 520px), 42vw"
              alt="Current Salvo campaign screen showing five era tabs and a ten-operation route"
              loading="lazy"
              decoding="async"
            />
            <figcaption>Automated release capture · not physical-device evidence</figcaption>
          </figure>
        </div>
      </section>

      <section class="sa-battle-proof" aria-labelledby="battle-proof-title">
        <div class="sa-shell">
          <div class="sa-eras-head">
            <h2 id="battle-proof-title">Place. Fight. Read the result.</h2>
            <p>
              Three manifest-backed candidates complete the current release
              sequence. They were rendered by the automated iPad capture harness;
              none is presented as a physical-device screenshot.
            </p>
          </div>
          <div class="sa-battle-proof-grid">
            {
              [
                { image: placement, title: 'Placement', alt: 'Salvo placement capture with the tactical grid and tower controls' },
                { image: combat, title: 'Combat', alt: 'Salvo combat capture with a running Age of Siege operation' },
                { image: result, title: 'Result', alt: 'Salvo result capture after an Age of Siege operation' },
              ].map((shot) => (
                <figure class="sa-capture">
                  <Image
                    src={shot.image}
                    format="webp"
                    widths={[360, 520, 720]}
                    sizes="(max-width: 700px) 92vw, 31vw"
                    alt={shot.alt}
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption>{shot.title} · automated release capture</figcaption>
                </figure>
              ))
            }
          </div>
        </div>
      </section>

      <section
        id="eras"
        class="sa-eras"
        style={`--sa-battlefield: url(${battlefield.src});`}
        aria-labelledby="eras-title"
      >
        <div class="sa-shell">
          <div class="sa-eras-head">
            <h2 id="eras-title">Five identities define the unfinished campaign.</h2>
            <p>
              Current source art establishes Siege, Wastes, Modern, Future, and
              Xeno as the intended visual sequence. Only Age of Siege is currently
              playable; the remaining era art is direction, not shipped content.
            </p>
          </div>
          <figure class="sa-era-line">
            <ol>
              {
                eras.map((era, index) => (
                  <li style={`--era-order: ${index}`}>
                    <span>{String(index + 1).padStart(2, '0')}</span>
                    <img
                      src={era.tower.src}
                      alt=""
                      width={era.tower.width}
                      height={era.tower.height}
                      loading="lazy"
                    />
                    <strong>{era.name}</strong>
                    <small>{era.note}</small>
                  </li>
                ))
              }
            </ol>
            <figcaption>
              Source-art composition · not gameplay and not a claim that five eras
              are playable.
            </figcaption>
          </figure>
        </div>
      </section>

      <section class="sa-orders" aria-labelledby="orders-title">
        <div class="sa-shell">
          <h2 id="orders-title">What the current build asks you to do.</h2>
          <ol class="sa-order-list">
            <li>
              <span>Place</span>
              <div>
                <h3>Commit a tower to the board.</h3>
                <p>
                  Placement snaps to the tactical grid with range and occupied
                  cells visible before confirmation.
                </p>
              </div>
            </li>
            <li>
              <span>Read</span>
              <div>
                <h3>See the wave before it reaches the fort.</h3>
                <p>
                  The command bar keeps lives, money, wave, speed, and sound state
                  in view while the battlefield remains dominant.
                </p>
              </div>
            </li>
            <li>
              <span>Adapt</span>
              <div>
                <h3>Upgrade, retarget, or sell without leaving battle.</h3>
                <p>
                  Contextual controls stay around the selected tower so tactical
                  decisions do not become a separate settings screen.
                </p>
              </div>
            </li>
            <li>
              <span>Secure</span>
              <div>
                <h3>Commit the local result first.</h3>
                <p>
                  Stars, progress, settings, and the highest endless wave remain
                  in the on-device save.
                </p>
              </div>
            </li>
          </ol>
        </div>
      </section>

      <section class="sa-local" aria-labelledby="local-title">
        <div class="sa-shell sa-local-grid">
          <div class="sa-local-copy">
            <h2 id="local-title">Your defense does not depend on a service.</h2>
            <p>
              Salvo is designed to remain fully playable offline. It has no custom
              account, cloud save, in-app purchase, or Nintek backend.
            </p>
          </div>
          <dl class="sa-local-ledger">
            <div>
              <dt>Local save</dt>
              <dd>Progress, stars, endless records, settings, and navigation.</dd>
            </div>
            <div>
              <dt>Online services</dt>
              <dd>No Game Center, account, cloud save, or Nintek backend in v1.</dd>
            </div>
            <div>
              <dt>Custom account</dt>
              <dd>None.</dd>
            </div>
            <div>
              <dt>Tracking</dt>
              <dd>The current iOS privacy manifest declares no tracking.</dd>
            </div>
          </dl>
        </div>
      </section>

      <section id="release" class="sa-release" aria-labelledby="release-title">
        <div class="sa-shell sa-release-grid">
          <div>
            <h2 id="release-title">A valid attached build, still blocked from release.</h2>
            <p>
              Version 1.0.0 build 4 is VALID and attached to an editable App Store
              version, but it remains PREPARE_FOR_SUBMISSION. No App Review
              submission, public TestFlight group, or public release exists.
            </p>
            <p>
              Campaign publication is separately blocked pending pilot and
              blueprint approval. Price, territories, and availability are not
              authorized for publication.
            </p>
          </div>
          <dl class="sa-release-brief">
            <div><dt>Current target</dt><dd>iPad only</dd></div>
            <div><dt>Orientation</dt><dd>Portrait</dd></div>
            <div><dt>Minimum OS</dt><dd>iPadOS 15</dd></div>
            <div><dt>Bundle ID</dt><dd><code>com.nintek.salvo</code></dd></div>
            <div><dt>Playable content</dt><dd>16 Age of Siege operations</dd></div>
            <div><dt>Public store link</dt><dd>Not available yet</dd></div>
            <div><dt>Physical-device proof</dt><dd>Still pending</dd></div>
          </dl>
        </div>
        <div class="sa-shell sa-release-actions">
          <a class="sa-button sa-button-primary" href="/ios#salvo">See Salvo in the iOS collection</a>
          <a class="sa-text-link" href="mailto:hello@nintek.com?subject=Salvo">Ask Nintek about Salvo</a>
        </div>
      </section>
    </main>

    <footer class="sa-footer">
      <div class="sa-shell">
        <a href="/" class="sa-footer-brand">
          <BrandMark size={20} />
          Nintek
        </a>
        <p>Salvo / portrait iPad tower defense / in development</p>
        <nav aria-label="Footer">
          <a href="/">All apps</a>
          <a href="/ios">iOS</a>
          <a href="/about">About</a>
          <a href={app.privacyPath}>Privacy</a>
          <a href={app.supportPath}>Support</a>
          <a href={app.termsPath}>Terms</a>
        </nav>
      </div>
    </footer>
  </div>
</BaseLayout>
