---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getApp, getRetiredApp } from '../../data/apps';

const app = getRetiredApp('puzzlebox')!;
const successor = getApp(app.successorSlug)!;
---

<BaseLayout
  title={`${app.name} has retired — ${successor.name}`}
  description={`${app.name} has been retired and superseded by ${successor.name}, Nintek's native games hub for iPhone.`}
  path={`/${app.slug}`}
  noindex
>
  <section class="retirement container">
    <div class="retirement-main">
      <h1>{app.name} has been retired.</h1>
      <p class="retirement-lead">
        <a href={`/${successor.slug}`}>{successor.name}</a> superseded {app.name}
        as Nintek's active games hub. It carries the idea forward as eight native
        games for iPhone, with optional Game Center and no Nintek backend.
      </p>
      <a class="retirement-action" href={`/${successor.slug}`}>
        Explore {successor.name}
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <aside class="retirement-history" aria-labelledby="puzzlebox-history">
      <h2 id="puzzlebox-history">Where Puzzlebox fits</h2>
      <p>
        Puzzlebox was Nintek's browser arcade: a collection of word, number,
        logic, and strategy games in one place. This page remains as a signpost
        for people following an old link.
      </p>
      <a href={`/${app.slug}/privacy`}>Read the archived privacy policy</a>
    </aside>
  </section>
</BaseLayout>

<style>
  .retirement {
    min-height: calc(100svh - 250px);
    padding-top: clamp(5rem, 12vw, 9rem);
    padding-bottom: clamp(5rem, 10vw, 8rem);
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(17rem, 0.75fr);
    gap: clamp(3rem, 8vw, 7rem);
    align-items: end;
  }

  .retirement-main {
    max-width: 48rem;
  }

  h1 {
    max-width: 10ch;
    margin-bottom: 1.5rem;
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.96;
  }

  .retirement-lead {
    max-width: 65ch;
    margin: 0;
    color: var(--ink-soft);
    font-size: clamp(1.08rem, 2vw, 1.3rem);
    line-height: 1.65;
  }

  .retirement-lead a {
    color: var(--ink);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--copper);
    text-underline-offset: 0.2em;
  }

  .retirement-action {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 2rem;
    padding: 0.85rem 1.1rem;
    border-radius: var(--r-sm);
    background: var(--ink);
    color: var(--paper);
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 10px 24px -14px rgba(28, 15, 7, 0.72);
    transition:
      background 0.18s var(--ease),
      transform 0.18s var(--ease),
      box-shadow 0.18s var(--ease);
  }

  .retirement-action:hover {
    background: var(--accent-deep);
    text-decoration: none;
    transform: translateY(-1px);
    box-shadow: 0 14px 28px -14px rgba(28, 15, 7, 0.72);
  }

  .retirement-action span {
    transition: transform 0.18s var(--ease);
  }

  .retirement-action:hover span {
    transform: translateX(0.2rem);
  }

  .retirement-history {
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-strong);
  }

  .retirement-history h2 {
    margin-bottom: 0.8rem;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }

  .retirement-history p {
    margin: 0 0 1rem;
    color: var(--ink-soft);
    line-height: 1.7;
  }

  .retirement-history a {
    color: var(--ink);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--copper-edge);
    text-underline-offset: 0.2em;
  }

  @media (max-width: 760px) {
    .retirement {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .retirement-action,
    .retirement-action span {
      transition: none;
    }
  }
</style>
