---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NintekBack from '../../components/NintekBack.astro';
import '../../styles/shopkeep-landing.css';

/* ── Receipt → inventory demo, rendered in its final "Filed" state ── */
const receipt = {
  store: 'ROCKLER WOODWORKING',
  addr: '4365 Willow Dr · Medina, MN',
  date: '03/14/2026',
  items: [
    { line: 'BENCH COOKIE SET 4PK', price: '35.99', tool: 'Bench Cookie Set',         category: 'Workholding', glyph: '🟠' },
    { line: 'FORSTNER BIT 16PC',    price: '89.99', tool: 'Forstner Bit Set (16 pc)', category: 'Drilling',    glyph: '🪛' },
    { line: 'DOMINO TENONS 8x40',   price: '24.99', tool: 'Domino Tenons 8×40 mm',    category: 'Joinery',     glyph: '🔩' },
  ],
  total: '150.97',
  from: 'Rockler',
};

/* ── PDF import visual, final state (all rows filed) ── */
const pdfItems = [
  { name: 'Festool RO 150 FEQ Sander', brand: 'Festool', price: '$389' },
  { name: 'Rotex Sanding Pad 150 mm',  brand: 'Festool', price: '$42'  },
  { name: 'Sys3 M 337 Systainer Case', brand: 'Festool', price: '$129' },
];

/* ── Dashboard mockup tiles ── */
const stats = [
  { label: 'Total Tools',     value: '247',     stroke: '#A0522D', bg: '#FEF3E8' },
  { label: 'Needs Attention', value: '3',       stroke: '#D97706', bg: '#FEF9C3' },
  { label: 'Checked Out',     value: '2',       stroke: '#6366F1', bg: '#EEF2FF' },
  { label: 'Total Value',     value: '$14,820', stroke: '#10B981', bg: '#D1FAE5' },
];
const recentTools = [
  { name: 'Festool TS 55 REQ',   meta: 'Track Saws · Festool',       badge: 'excellent', badgeClass: 'lp-badge-excellent', glyph: '🪚' },
  { name: 'Bessey K-Body Revo',  meta: 'Clamps · Bessey',            badge: 'good',      badgeClass: 'lp-badge-good',      glyph: '🗜️' },
  { name: 'Lie-Nielsen No. 4',   meta: 'Hand Planes · Lie-Nielsen',  badge: 'excellent', badgeClass: 'lp-badge-excellent', glyph: '🔨' },
];

const trust = [
  {
    title: 'Verified identity',
    desc: 'No new password to remember. Your verified work identity handles access — the same single account you already use every day.',
  },
  {
    title: 'Your shop, your database',
    desc: 'Each user gets a private SQLite file. Your inventory is isolated from everyone else — by design, not by policy.',
  },
  {
    title: 'Powered by Claude',
    desc: 'Receipt parsing, natural-language search, and tool enrichment all run on Anthropic’s frontier model.',
  },
  {
    title: 'Activity log, always',
    desc: 'Every action — every AI call, every checkout, every edit — is recorded. Nothing happens silently in your shop.',
  },
];
---

<BaseLayout
  bare
  noindex
  path="/shopkeep"
  title="ShopKeep — Right where you left it."
  description="The catalog for your workshop. Snap a receipt and your tools file themselves, label every drawer, track every checkout, and stop searching for the chisel you swear was right here."
>
  <div class="lp-root">
    {/* ── Background decor ── */}
    <div class="lp-bg" aria-hidden="true">
      <div class="lp-bg-orb lp-bg-orb-1"></div>
      <div class="lp-bg-orb lp-bg-orb-2"></div>
      <div class="lp-bg-orb lp-bg-orb-3"></div>
      <div class="lp-bg-grain"></div>
    </div>

    {/* ── Top nav (brand only) ── */}
    <nav class="lp-nav">
      <div class="lp-nav-inner">
        <NintekBack />
        <div class="lp-nav-brand">
          <span class="lp-nav-mark">
            <svg width="32" height="32" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <defs>
                <linearGradient id="bm-bg-nav" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#E89549"></stop>
                  <stop offset="1" stop-color="#7A3D12"></stop>
                </linearGradient>
                <radialGradient id="bm-top-nav" cx="50%" cy="-15%" r="85%">
                  <stop offset="0" stop-color="#fff" stop-opacity="0.55"></stop>
                  <stop offset="0.55" stop-color="#fff" stop-opacity="0"></stop>
                </radialGradient>
                <linearGradient id="bm-inner-nav" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#fff" stop-opacity="0.18"></stop>
                  <stop offset="0.06" stop-color="#fff" stop-opacity="0"></stop>
                </linearGradient>
              </defs>
              <rect width="64" height="64" rx="18" fill="url(#bm-bg-nav)"></rect>
              <rect width="64" height="64" rx="18" fill="url(#bm-top-nav)"></rect>
              <rect x="0.5" y="0.5" width="63" height="63" rx="17.5" fill="url(#bm-inner-nav)" stroke="#fff" stroke-opacity="0.18" stroke-width="0.6"></rect>
              <g transform="translate(8 8)" fill="none" stroke="#ffffff" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M29.4 12.6a2 2 0 0 0 0 2.8l3.2 3.2a2 2 0 0 0 2.8 0l7.54-7.54a12 12 0 0 1-15.88 15.88l-13.82 13.82a4.24 4.24 0 0 1-6-6l13.82-13.82a12 12 0 0 1 15.88-15.88l-7.52 7.52z"></path>
              </g>
            </svg>
          </span>
          <span class="lp-nav-name">ShopKeep</span>
          <span class="lp-nav-tag">Workshop Inventory</span>
        </div>
      </div>
    </nav>

    {/* ── Hero ── */}
    <section class="lp-hero">
      <div class="lp-container">
        <div class="lp-hero-grid">
          {/* Copy column */}
          <div>
            <div class="lp-hero-eyebrow">
              <span class="lp-hero-eyebrow-dot"></span>
              For makers, woodworkers &amp; serious shops
            </div>
            <h1 class="lp-hero-title">
              <span style="display: block;">Every tool. Every drawer.</span>
              <span style="display: block;"><span class="lp-hero-title-em">Right where you left it.</span></span>
            </h1>
            <p class="lp-hero-sub">
              ShopKeep is the catalog for your workshop. Snap a receipt and your
              tools file themselves. Ask plain-English questions and get real answers.
              Label every drawer, track every checkout, and stop searching for the
              chisel you swear was right here.
            </p>
          </div>

          {/* Mockup column */}
          <div class="lp-mockup-wrap">
            <div class="lp-mockup-ambient"></div>
            <div class="lp-mockup">
              <div class="lp-mockup-head">
                <div>
                  <h3 class="lp-mockup-h1">Workshop Dashboard</h3>
                  <div class="lp-mockup-h-sub">Overview of your tool collection</div>
                </div>
                <div class="lp-mockup-dots">
                  <span class="lp-mockup-dot"></span>
                  <span class="lp-mockup-dot"></span>
                  <span class="lp-mockup-dot"></span>
                </div>
              </div>

              <div class="lp-stat-row">
                {stats.map((s) => (
                  <div class="lp-stat">
                    <div class="lp-stat-icon" style={`background-color: ${s.bg};`}>
                      {s.label === 'Total Tools' && (
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={s.stroke} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m7.5 4.27 9 5.15"></path><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path><path d="M3.3 7 12 12l8.7-5"></path><path d="M12 22V12"></path></svg>
                      )}
                      {s.label === 'Needs Attention' && (
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={s.stroke} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg>
                      )}
                      {s.label === 'Checked Out' && (
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={s.stroke} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><polyline points="16 11 18 13 22 9"></polyline></svg>
                      )}
                      {s.label === 'Total Value' && (
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={s.stroke} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" x2="12" y1="2" y2="22"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                      )}
                    </div>
                    <div class="lp-stat-label">{s.label}</div>
                    <div class="lp-stat-value">{s.value}</div>
                  </div>
                ))}
              </div>

              <div class="lp-mockup-row-label">Recently Added</div>

              <div class="lp-toolcards">
                {recentTools.map((t) => (
                  <div class="lp-toolcard">
                    <div class="lp-toolcard-img">
                      <span class="lp-toolcard-glyph">{t.glyph}</span>
                      <span class={`lp-toolcard-badge ${t.badgeClass}`}>{t.badge}</span>
                    </div>
                    <div class="lp-toolcard-body">
                      <div class="lp-toolcard-name">{t.name}</div>
                      <div class="lp-toolcard-meta">{t.meta}</div>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <div class="lp-mockup-chip">
              <span class="lp-mockup-chip-icon">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#A0522D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .962 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.962 0z"></path><path d="M20 3v4"></path><path d="M22 5h-4"></path><path d="M4 17v2"></path><path d="M5 18H3"></path></svg>
              </span>
              Receipt imported · 3 tools added
            </div>
            <div class="lp-mockup-chip-2">
              <span class="lp-mockup-chip-2-dot"></span>
              Live
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ── Receipt → inventory demo (final "Filed" state) ── */}
    <section class="lp-demo">
      <div class="lp-container">
        <div class="lp-section-head">
          <div class="lp-section-eyebrow">The receipt trick</div>
          <h2 class="lp-section-title">Snap a receipt. Get an inventory.</h2>
          <p class="lp-section-sub">
            Drop in any tool receipt — Rockler, Woodpeckers, the orange-store
            blur of a Sunday morning. ShopKeep reads it, categorizes each line,
            and files it in your shop. No typing. No copy-pasting SKUs.
          </p>
        </div>

        <div class="lp-demo-stage">
          {/* Receipt */}
          <div class="lp-receipt-wrap">
            <div class="lp-receipt">
              <div class="lp-receipt-head">
                <div class="lp-receipt-brand">{receipt.store}</div>
                <div class="lp-receipt-addr">{receipt.addr}</div>
                <div class="lp-receipt-date">{receipt.date}</div>
              </div>

              <div class="lp-receipt-rows">
                {receipt.items.map((it) => (
                  <div class="lp-receipt-row">
                    <span class="lp-receipt-row-name">{it.line}</span>
                    <span class="lp-receipt-row-price">${it.price}</span>
                  </div>
                ))}
              </div>

              <div class="lp-receipt-sep"></div>
              <div class="lp-receipt-total">
                <span>TOTAL</span>
                <span>${receipt.total}</span>
              </div>
              <div class="lp-receipt-foot">— THANK YOU —</div>
            </div>
          </div>

          {/* Output side */}
          <div class="lp-demo-output">
            <div class="lp-demo-output-head">
              <span class="lp-demo-arrow">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .962 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.962 0z"></path><path d="M20 3v4"></path><path d="M22 5h-4"></path><path d="M4 17v2"></path><path d="M5 18H3"></path></svg>
                Filed
              </span>
              <span class="lp-demo-output-title">Tools added to your shop</span>
            </div>

            <div class="lp-demo-tools">
              {receipt.items.map((it) => (
                <div class="lp-demo-tool">
                  <div class="lp-demo-tool-icon">{it.glyph}</div>
                  <div class="lp-demo-tool-body">
                    <div class="lp-demo-tool-name">{it.tool}</div>
                    <div class="lp-demo-tool-meta">
                      <span class="lp-demo-tool-cat">{it.category}</span>
                      <span>from {receipt.from}</span>
                    </div>
                  </div>
                  <div class="lp-demo-tool-price">${it.price}</div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ── Features bento ── */}
    <section class="lp-features">
      <div class="lp-container">
        <div class="lp-section-head">
          <div class="lp-section-eyebrow">The whole bench</div>
          <h2 class="lp-section-title">Built for the way you actually work.</h2>
          <p class="lp-section-sub">
            Not a feature dump. A small set of tools that pull their weight in
            a real shop — the ones you&rsquo;ll reach for week after week.
          </p>
        </div>

        <div class="lp-bento">
          {/* 1 — AI search */}
          <article class="lp-card lp-bento-1">
            <div class="lp-card-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .962 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.962 0z"></path><path d="M20 3v4"></path><path d="M22 5h-4"></path><path d="M4 17v2"></path><path d="M5 18H3"></path></svg>
            </div>
            <h3 class="lp-card-title">Ask your shop a question.</h3>
            <p class="lp-card-desc">
              Plain English. No filters, no SQL. Claude reads your inventory
              and gives you an honest answer, then shows the tools.
            </p>
            <div class="lp-card-ai-visual">
              <div class="lp-card-ai-prompt">
                <span class="lp-card-ai-promptcaret">&rsaquo;</span>
                <span>which sanders need new pads?</span>
              </div>
              <div class="lp-card-ai-answer">
                <span class="lp-card-ai-answer-caret">&checkmark;</span>
                <span>
                  Two sanders are flagged: the Festool ETS 150 and the Mirka
                  DEROS — both moved to &ldquo;needs repair&rdquo; after your
                  last project.
                </span>
              </div>
            </div>
          </article>

          {/* 2 — QR scan → set location (final "saved" state) */}
          <article class="lp-card lp-bento-2">
            <div class="lp-card-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="5" height="5" x="3" y="3" rx="1"></rect><rect width="5" height="5" x="16" y="3" rx="1"></rect><rect width="5" height="5" x="3" y="16" rx="1"></rect><path d="M21 16h-3a2 2 0 0 0-2 2v3"></path><path d="M21 21v.01"></path><path d="M12 7v3a2 2 0 0 1-2 2H7"></path><path d="M3 12h.01"></path><path d="M12 3h.01"></path><path d="M12 16v.01"></path><path d="M16 12h1"></path><path d="M21 12v.01"></path><path d="M12 21v-1"></path></svg>
            </div>
            <h3 class="lp-card-title">Scan to place. Instantly.</h3>
            <p class="lp-card-desc">
              Print a QR label for any bin, cabinet, or drawer. From a tool&rsquo;s
              page, tap <em>Set Location</em> and scan — the location field
              updates on the spot. No typing.
            </p>
            <div class="lp-qr-scan-demo">
              <div class="lp-qr-scan-frame">
                <div class="lp-qr-scan-code" aria-hidden="true"></div>
                <div class="lp-qr-corner lp-qr-corner-tl"></div>
                <div class="lp-qr-corner lp-qr-corner-tr"></div>
                <div class="lp-qr-corner lp-qr-corner-bl"></div>
                <div class="lp-qr-corner lp-qr-corner-br"></div>

                <div class="lp-qr-scan-ok">
                  <div class="lp-qr-scan-ok-circle">&checkmark;</div>
                </div>

                <div class="lp-qr-scan-chip">
                  <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path><circle cx="12" cy="10" r="3"></circle></svg>
                  Cabinet A · Drawer 2
                </div>
              </div>

              <div class="lp-qr-location-row">
                <span class="lp-qr-location-label-text">Location</span>
                <span class="lp-qr-location-val lp-qr-location-set">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="var(--lp-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path><circle cx="12" cy="10" r="3"></circle></svg>
                  Cabinet A · Drawer 2
                  <span class="lp-qr-saved-pill">Saved</span>
                </span>
              </div>
            </div>
          </article>

          {/* 3 — PDF invoice import (final state) */}
          <article class="lp-card lp-bento-6">
            <div class="lp-card-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M10 9H8"></path><path d="M16 13H8"></path><path d="M16 17H8"></path></svg>
            </div>
            <h3 class="lp-card-title">PDF invoices? Done.</h3>
            <p class="lp-card-desc">
              Drop in a digital invoice from Festool, Rockler, or anywhere.
              ShopKeep reads each line item, detects the brand, picks a photo,
              and files it — no SKU hunting required.
            </p>
            <div class="lp-pdf-visual">
              <div class="lp-pdf-visual-header">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--lp-walnut-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M10 9H8"></path><path d="M16 13H8"></path><path d="M16 17H8"></path></svg>
                <span class="lp-pdf-visual-filename">Festool_Invoice_2026.pdf</span>
                <span class="lp-pdf-visual-status">3 tools added</span>
              </div>
              <div class="lp-pdf-visual-rows">
                {pdfItems.map((item) => (
                  <div class="lp-pdf-visual-row">
                    <div class="lp-pdf-visual-check">&checkmark;</div>
                    <span class="lp-pdf-visual-name">{item.name}</span>
                    <span class="lp-pdf-visual-brand">{item.brand}</span>
                    <span class="lp-pdf-visual-price">{item.price}</span>
                  </div>
                ))}
              </div>
            </div>
          </article>

          {/* 4 — Document vault */}
          <article class="lp-card lp-bento-7">
            <div class="lp-card-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48"></path></svg>
            </div>
            <h3 class="lp-card-title">Manuals, warranties, receipts — on the tool.</h3>
            <p class="lp-card-desc">
              Attach any PDF directly to a tool&rsquo;s record. Export a photo-rich
              insurance dossier for your whole shop in one click.
            </p>
            <div class="lp-docvault-visual">
              <div class="lp-docvault-row">
                <div class="lp-docvault-icon-wrap lp-docvault-blue">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M10 9H8"></path><path d="M16 13H8"></path><path d="M16 17H8"></path></svg>
                </div>
                <span class="lp-docvault-name">ETS_150_Owners_Manual.pdf</span>
                <span class="lp-docvault-label lp-docvault-blue">Manual</span>
              </div>
              <div class="lp-docvault-row">
                <div class="lp-docvault-icon-wrap lp-docvault-green">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path></svg>
                </div>
