---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NintekBack from '../../components/NintekBack.astro';
import ShopKeepReleaseVisual from '../../components/ShopKeepReleaseVisual.astro';
import { getApp } from '../../data/apps';
import '../../styles/shopkeep-landing.css';

const app = getApp('shopkeep')!;

const capabilities = [
  {
    title: 'Inventory that carries its history',
    body:
      'Tools, categories, brands, locations, valuations, checkouts, maintenance, warranties, notes, and trash stay attached to the selected workspace.',
  },
  {
    title: 'Private media on the record',
    body:
      'Photos, manuals, receipts, and warranty documents remain account-scoped SQLite BLOBs served through authenticated, no-store responses.',
  },
  {
    title: 'Scan instead of type',
    body:
      'The native client can read QR and common retail barcode formats, then use the result for inventory search or location assignment.',
  },
  {
    title: 'Export before you leave',
    body:
      'Inventory CSV, location-label CSV, an insurance PDF dossier, and a downloadable SQLite backup cover different portability needs.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'ShopKeep for iOS',
  applicationCategory: 'ProductivityApplication',
  operatingSystem: 'iOS 17 or later, iPadOS 17 or later',
  description:
    'A private account-backed workshop inventory app with separate Apple and Microsoft workspaces, authenticated media, exports, and provider-scoped account deletion.',
  identifier: app.bundleId,
  url: 'https://www.nintek.com/shopkeep',
};
---

<BaseLayout
  bare
  noindex
  path="/shopkeep"
  title="ShopKeep — Every tool on the register."
  description="A private workshop inventory service with separate Apple and Microsoft workspaces, authenticated media, exports, and provider-scoped account deletion."
  themeColor="#f2f2f7"
  socialImage="/social/shopkeep.png"
  socialImageAlt="ShopKeep title and canonical blue-and-white tool-in-home icon on a machine-control register"
  socialImageWidth={1200}
  socialImageHeight={630}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <div class="sk-root">
    <header class="sk-nav">
      <div class="sk-shell sk-nav-inner">
        <NintekBack />
        <a class="sk-brand" href="/shopkeep" aria-label="ShopKeep home">
          <img src="/apps/shopkeep.png" alt="" width="38" height="38" />
          <span>ShopKeep</span>
        </a>
        <span class="sk-state">Private build</span>
      </div>
    </header>

    <main>
      <section class="sk-hero" aria-labelledby="shopkeep-title">
        <div class="sk-shell sk-hero-grid">
          <div class="sk-hero-copy">
            <p class="sk-status">Build 2.0.1 (35) · attached and valid</p>
            <h1 id="shopkeep-title">Every tool numbered. Every move accounted for.</h1>
            <p class="sk-lede">
              ShopKeep is a private, account-backed inventory for the whole
              workshop: tools, locations, documents, checkouts, maintenance, and
              value in one durable register.
            </p>
            <p class="sk-boundary">
              Build 35 is attached to an editable App Store version and has passed
              Apple validation. There is no App Review submission, public listing,
              public TestFlight link, authorized price, or release date.
            </p>
            <div class="sk-actions">
              <a class="sk-button sk-button-primary" href="#identity">Understand account ownership</a>
              <a class="sk-button sk-button-secondary" href={app.supportPath}>Open support</a>
            </div>
          </div>
          <ShopKeepReleaseVisual />
        </div>
      </section>

      <section class="sk-section" id="identity" aria-labelledby="identity-title">
        <div class="sk-shell sk-split">
          <div>
            <h2 id="identity-title">The provider is the workspace boundary.</h2>
            <p>
              Sign in with Apple or Microsoft. Each provider creates a separate
              ShopKeep workspace. Use the same provider to return to it; ShopKeep
              does not link or merge data across providers.
            </p>
          </div>
          <dl class="sk-ledger">
            <div>
              <dt>Apple workspace</dt>
              <dd>Separate inventory, media, exports, and deletion scope.</dd>
            </div>
            <div>
              <dt>Microsoft workspace</dt>
              <dd>Separate even when both providers expose the same email address.</dd>
            </div>
            <div>
              <dt>Provider account</dt>
              <dd>Never deleted by removing a ShopKeep workspace.</dd>
            </div>
          </dl>
        </div>
      </section>

      <section class="sk-section sk-section-muted" aria-labelledby="capabilities-title">
        <div class="sk-shell">
          <div class="sk-section-head">
            <h2 id="capabilities-title">A native inventory, not a themed mockup.</h2>
            <p>
              Build 35 uses semantic iOS surfaces, system typography, continuous
              containers, and one selectable interaction accent. The retired
              toolpath-arrow identity and the former machine-control interface are
              not presented as current app evidence.
            </p>
          </div>
          <div class="sk-capabilities">
            {
              capabilities.map((capability) => (
                <article>
                  <h3>{capability.title}</h3>
                  <p>{capability.body}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="sk-section sk-section-dark" aria-labelledby="deletion-title">
        <div class="sk-shell sk-split">
          <div>
            <h2 id="deletion-title">Deletion waits for the server.</h2>
            <p>
              Export first if you need a copy. In-app deletion asks the server to
              revoke and permanently remove only the selected provider-backed
              ShopKeep workspace. Local sessions and caches clear only after the
              server confirms success.
            </p>
          </div>
          <div class="sk-callout">
            <strong>What deletion does not do</strong>
            <p>
              It does not delete the underlying Apple or Microsoft account, merge
              provider workspaces, remove the other provider’s workspace, or restore
              deleted inventory when a later sign-in creates a fresh empty generation.
            </p>
          </div>
        </div>
      </section>

      <section class="sk-section" aria-labelledby="evidence-title">
        <div class="sk-shell sk-evidence">
          <div>
            <h2 id="evidence-title">Exact evidence, including the gap.</h2>
            <p>
              The canonical blue-and-white tool-in-home icon is byte-identical to
              the build 35 source. Fourteen release screenshots are recorded as
              deterministic Simulator UI with local synthetic fixtures, but their
              original bytes are intentionally untracked upstream. This page will
              not substitute retired art, a hand-built interface, or an
              Apple-recompressed rendition.
            </p>
          </div>
          <dl>
            <div><dt>Capture class</dt><dd>Simulator UI with local synthetic fixtures</dd></div>
            <div><dt>Physical-device proof</dt><dd>Still pending</dd></div>
            <div><dt>Public availability</dt><dd>Not authorized</dd></div>
          </dl>
        </div>
      </section>
    </main>

    <footer class="sk-footer">
      <div class="sk-shell sk-footer-inner">
        <p>ShopKeep for iOS · build 35 · private release evidence</p>
        <nav aria-label="ShopKeep help and legal">
          <a href={app.supportPath}>Support</a>
          <a href={app.privacyPath}>Privacy</a>
          <a href={app.termsPath}>Terms</a>
        </nav>
      </div>
    </footer>
  </div>
</BaseLayout>
