---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NintekBack from '../../components/NintekBack.astro';
import Icon from '../../components/Icon.astro';
import PhoneMock from '../../components/PhoneMock.astro';
import ShopKeepPhone from '../../components/mocks/ios/ShopKeep.astro';
import ShopKeepMark from '../../components/ShopKeepMark.astro';
import { getApp } from '../../data/apps';
import '../../styles/shopkeep-landing.css';

const skApp = getApp('shopkeep')!;
const skNative = skApp.native!;

/* ── LIB.01, the shop status readout ── */
const dro = [
  { label: 'Tools in library', fig: '134', cap: 'across 9 categories' },
  { label: 'Checked out', fig: '003', cap: 'on loan', tone: 'issued' },
  { label: 'In service', fig: '007', cap: 'maintenance open', tone: 'service' },
  { label: 'Library value', fig: '$48,621', cap: 'at purchase', tone: 'rest' },
];

/* ── The alarms panel: the first four of seven, as the head reports ── */
const alarms = [
  { state: 'missing', name: 'Overdue checkout', count: '01' },
  { state: 'repair', name: 'Maintenance overdue', count: '01' },
  { state: 'service', name: 'Maintenance due soon', count: '02' },
  { state: 'repair', name: 'Warranty expired', count: '01' },
];

/* ── A slice of LIB.02, so the register anatomy reads on the page ── */
const register = [
  { code: 'T-214', name: 'Festool TS 55 REQ', meta: 'Track Saws · Festool', wear: 4, move: 'rest', label: 'Available' },
  { code: 'T-163', name: 'Makita RT0701C', meta: 'Power Tools · Makita', wear: 1, move: 'service', label: 'Maintenance' },
];

/* ── Receipt → register demo, rendered in its final filed state ── */
const receipt = {
  store: 'ROCKLER WOODWORKING',
  addr: '4365 Willow Dr · Medina, MN',
  date: '03/14/2026',
  items: [
    { line: 'BENCH COOKIE SET 4PK', price: '35.99', code: 'T-135', tool: 'Bench Cookie Set',         category: 'Workholding' },
    { line: 'FORSTNER BIT 16PC',    price: '89.99', code: 'T-136', tool: 'Forstner Bit Set (16 pc)', category: 'Drilling' },
    { line: 'DOMINO TENONS 8x40',   price: '24.99', code: 'T-137', tool: 'Domino Tenons 8×40 mm',    category: 'Joinery' },
  ],
  total: '150.97',
  from: 'Rockler',
};

/* ── PDF import visual, final state (all rows filed) ── */
const pdfItems = [
  { name: 'Festool RO 150 FEQ Sander', brand: 'Festool', price: '$389' },
  { name: 'Rotex Sanding Pad 150 mm',  brand: 'Festool', price: '$42'  },
  { name: 'Sys3 M 337 Systainer Case', brand: 'Festool', price: '$129' },
];

const trust = [
  {
    title: 'Verified identity',
    desc: 'No new password to remember. Your verified work identity handles access — the same single account you already use every day.',
  },
  {
    title: 'Your shop, your database',
    desc: 'Each user gets a private SQLite file. Your register is isolated from everyone else — by design, not by policy.',
  },
  {
    title: 'Powered by Claude',
    desc: 'Receipt parsing, natural-language search, and tool enrichment all run on Anthropic’s frontier model.',
  },
  {
    title: 'Activity log, always',
    desc: 'Every action — every AI call, every checkout, every edit — is recorded. Nothing happens silently in your shop.',
  },
];
---

<BaseLayout
  bare
  noindex
  libraryFonts
  path="/shopkeep"
  title="ShopKeep — Every tool on the register."
  description="A tool library in the machinist’s sense: a numbered register of the whole shop, every tool carrying its own address, specs, location and wear state. One readout says what is out, what is in service, and what the shelf is worth."
>
  <div class="lp-root">
    {/* ── Top nav (brand only) ── */}
    <nav class="lp-nav">
      <div class="lp-nav-inner">
        <NintekBack />
        <div class="lp-nav-brand">
          <span class="lp-nav-mark"><ShopKeepMark size={30} /></span>
          <span class="lp-nav-name">ShopKeep</span>
          <span class="lp-nav-tag">Tool Library</span>
        </div>
      </div>
    </nav>

    {/* ── Hero ── */}
    <section class="lp-hero">
      <div class="lp-container">
        <div class="lp-hero-grid">
          {/* Copy column */}
          <div>
            <div class="lp-hero-eyebrow">
              <span class="lp-hero-eyebrow-mark"></span>
              Tool library · machine control for the shop
            </div>
            <h1 class="lp-hero-title">
              <span style="display: block;">{skApp.headline.lead}</span>
              <span style="display: block;"><span class="lp-hero-title-em">{skApp.headline.em}</span></span>
            </h1>
            <p class="lp-hero-sub">
              In CAM software a <em>tool library</em> is already a numbered database
              of tools with specs, offsets and wear state. ShopKeep is literally that
              object — so it is built as the machine control it is, not as a workshop
              scrapbook. Every tool gets an address. One readout carries the numbers.
              Status is drawn as the move a tool is making.
            </p>
          </div>

          {/* Mockup column — LIB.01 as it actually draws */}
          <div class="lp-mockup-wrap">
            <div class="lp-mockup">
              <div class="lp-mockup-head">
                <h3 class="lp-mockup-h1">{skApp.mockup!.title}</h3>
                <div class="lp-mockup-h-sub">134 tools on the register across 9 categories.</div>
                <div class="lp-rule">
                  <span class="lp-rule-index"></span>
                  <span class="lp-rule-line"></span>
                  <span class="lp-desig">LIB.01</span>
                </div>
              </div>

              {/* One readout per screen */}
              <div class="lp-dro">
                {dro.map((d) => (
                  <div class="lp-dro-cell">
                    <span class="lp-dro-label">{d.label}</span>
                    <span class={`lp-dro-fig${d.tone ? ` lp-dro-fig-${d.tone}` : ''}`}>{d.fig}</span>
                    <span class="lp-dro-cap">{d.cap}</span>
                  </div>
                ))}
              </div>

              <div class="lp-panel">
                <div class="lp-panel-head">
                  <span class="lp-panel-title">Alarms</span>
                  <span class="lp-panel-meta">07 Active</span>
                </div>
                {alarms.map((a) => (
                  <div class="lp-row">
                    <span class={`lp-swatch lp-swatch-${a.state}`}></span>
                    <div class="lp-row-names"><span class="lp-row-name">{a.name}</span></div>
                    <span class="lp-code">{a.count}</span>
                  </div>
                ))}
              </div>

              <div class="lp-panel">
                <div class="lp-panel-head">
                  <span class="lp-panel-title">Tool library</span>
                  <span class="lp-panel-meta">1–2 of 134</span>
                </div>
                {register.map((t) => (
                  <div class="lp-row">
                    <span class="lp-code">{t.code}</span>
                    <div class="lp-row-names">
                      <span class="lp-row-name">{t.name}</span>
                      <span class="lp-row-meta">{t.meta}</span>
                    </div>
                    <span class="lp-wear" aria-hidden="true">
                      {[0, 1, 2, 3].map((i) => (
                        <i class={i < t.wear ? `on ${t.move}` : ''}></i>
                      ))}
                    </span>
                    <span class={`lp-move lp-move-${t.move}`}>
                      <svg width="28" height="8" viewBox="0 0 28 8" fill="none" aria-hidden="true">
                        <line
                          x1="0" y1="4" x2="28" y2="4"
                          stroke="currentColor" stroke-width="2"
                          stroke-dasharray={t.move === 'service' ? '4 3.5' : undefined}
                        ></line>
                      </svg>
                      {t.label}
                    </span>
                  </div>
                ))}
              </div>
            </div>

            <div class="lp-mockup-chip">
              <span class="lp-mockup-chip-icon">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .962 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.962 0z"></path><path d="M20 3v4"></path><path d="M22 5h-4"></path><path d="M4 17v2"></path><path d="M5 18H3"></path></svg>
              </span>
              {skApp.mockup!.chip}
            </div>
            <div class="lp-mockup-chip-2">
              <span class="lp-mockup-chip-2-mark"></span>
              {skApp.mockup!.live}
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ── Receipt → register demo (final "Filed" state) ── */}
    <section class="lp-demo">
      <div class="lp-container">
        <div class="lp-section-head">
          <div class="lp-section-eyebrow">The receipt trick</div>
          <h2 class="lp-section-title">Snap a receipt. The register updates.</h2>
          <p class="lp-section-sub">
            Drop in any tool receipt. ShopKeep reads it, categorises each line,
            assigns the next register code, and files it. No typing. No
            copy-pasting SKUs.
          </p>
        </div>
        <div class="lp-rule lp-section-rule">
          <span class="lp-rule-index"></span>
          <span class="lp-rule-line"></span>
          <span class="lp-desig">LIB.02</span>
        </div>

        <div class="lp-demo-stage">
          {/* Receipt */}
          <div class="lp-receipt-wrap">
            <div class="lp-receipt">
              <div class="lp-receipt-head">
                <div class="lp-receipt-brand">{receipt.store}</div>
                <div class="lp-receipt-addr">{receipt.addr}</div>
                <div class="lp-receipt-date">{receipt.date}</div>
              </div>

              <div class="lp-receipt-rows">
                {receipt.items.map((it) => (
                  <div class="lp-receipt-row">
                    <span class="lp-receipt-row-name">{it.line}</span>
                    <span class="lp-receipt-row-price">${it.price}</span>
                  </div>
                ))}
              </div>

              <div class="lp-receipt-sep"></div>
              <div class="lp-receipt-total">
                <span>TOTAL</span>
                <span>${receipt.total}</span>
              </div>
              <div class="lp-receipt-foot">— THANK YOU —</div>
            </div>
          </div>

          {/* Output side */}
          <div class="lp-demo-output">
            <div class="lp-demo-output-head">
              <span class="lp-demo-arrow">Filed</span>
              <span class="lp-demo-output-title">Three new records on the register</span>
            </div>

            <div class="lp-panel">
              <div class="lp-panel-head">
                <span class="lp-panel-title">Tool library</span>
                <span class="lp-panel-meta">+03 Records</span>
              </div>
              {receipt.items.map((it) => (
                <div class="lp-row">
                  <span class="lp-code">{it.code}</span>
                  <div class="lp-row-names">
                    <span class="lp-row-name">{it.tool}</span>
                    <span class="lp-row-meta">
                      <span class="lp-demo-tool-cat">{it.category}</span>
                      &ensp;· from {receipt.from}
                    </span>
                  </div>
                  <span class="lp-demo-tool-price">${it.price}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ── Features bento ── */}
    <section class="lp-features">
      <div class="lp-container">
        <div class="lp-section-head">
          <div class="lp-section-eyebrow">The whole bench</div>
          <h2 class="lp-section-title">Built for the way you actually work.</h2>
          <p class="lp-section-sub">
            Not a feature dump. A small set of tools that pull their weight in
            a real shop — the ones you&rsquo;ll reach for week after week.
          </p>
        </div>
        <div class="lp-rule lp-section-rule">
          <span class="lp-rule-index"></span>
          <span class="lp-rule-line"></span>
          <span class="lp-desig">LIB.03</span>
        </div>

        <div class="lp-bento">
          {/* 1 — AI search */}
          <article class="lp-card lp-bento-1">
            <div class="lp-card-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .962 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.962 0z"></path><path d="M20 3v4"></path><path d="M22 5h-4"></path><path d="M4 17v2"></path><path d="M5 18H3"></path></svg>
            </div>
            <h3 class="lp-card-title">Ask the register a question.</h3>
            <p class="lp-card-desc">
              Plain English. No filters, no SQL. Claude reads your register
              and gives you an honest answer, then shows the tools.
            </p>
            <div class="lp-card-ai-visual">
              <div class="lp-card-ai-prompt">
                <span class="lp-card-ai-promptcaret">&rsaquo;</span>
                <span>which sanders need new pads?</span>
              </div>
              <div class="lp-card-ai-answer">
                <span class="lp-card-ai-answer-caret">&checkmark;</span>
                <span>
                  Two are flagged: T-042 Festool ETS 150 and T-088 Mirka DEROS
                  — both moved to needs&#8209;repair after your last project.
                </span>
              </div>
            </div>
          </article>

          {/* 2 — QR scan → set location (final "saved" state) */}
          <article class="lp-card lp-bento-2">
            <div class="lp-card-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="5" height="5" x="3" y="3" rx="1"></rect><rect width="5" height="5" x="16" y="3" rx="1"></rect><rect width="5" height="5" x="3" y="16" rx="1"></rect><path d="M21 16h-3a2 2 0 0 0-2 2v3"></path><path d="M21 21v.01"></path><path d="M12 7v3a2 2 0 0 1-2 2H7"></path><path d="M3 12h.01"></path><path d="M12 3h.01"></path><path d="M12 16v.01"></path><path d="M16 12h1"></path><path d="M21 12v.01"></path><path d="M12 21v-1"></path></svg>
            </div>
            <h3 class="lp-card-title">Scan to place. Instantly.</h3>
            <p class="lp-card-desc">
              Print a QR label for any bin, cabinet, or drawer. From a tool&rsquo;s
              record, tap <em>Set Location</em> and scan — the location field
              updates on the spot. No typing.
            </p>
            <div class="lp-qr-scan-demo">
              <div class="lp-qr-scan-frame">
                <svg class="lp-qr-scan-code" viewBox="0 0 25 25" fill="currentColor" aria-hidden="true" shape-rendering="crispEdges">
                  <path d="M0 0h7v7H0z M2 2h3v3H2z M18 0h7v7h-7z M20 2h3v3h-3z M0 18h7v7H0z M2 20h3v3H2z"></path>
                  <path d="M9 0h2v2H9z M13 0h2v3h-2z M9 4h2v2H9z M12 5h3v2h-3z M0 9h3v2H0z M4 9h2v2H4z M0 13h2v2H0z M4 12h3v2H4z M9 9h3v2H9z M13 10h2v3h-2z M9 13h2v3H9z M12 15h3v2h-3z M17 9h3v2h-3z M22 9h3v2h-3z M18 12h2v2h-2z M22 13h3v2h-3z M9 18h2v3H9z M13 18h2v2h-2z M9 23h3v2H9z M13 22h2v3h-2z M17 17h3v2h-3z M22 17h3v2h-3z M17 21h2v2h-2z M21 21h4v2h-4z"></path>
                </svg>
                <div class="lp-qr-corner lp-qr-corner-tl"></div>
                <div class="lp-qr-corner lp-qr-corner-tr"></div>
                <div class="lp-qr-corner lp-qr-corner-bl"></div>
                <div class="lp-qr-corner lp-qr-corner-br"></div>

                <div class="lp-qr-scan-ok">
                  <div class="lp-qr-scan-ok-mark">&checkmark;</div>
                </div>

                <div class="lp-qr-scan-chip">
                  <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path><circle cx="12" cy="10" r="3"></circle></svg>
                  Cabinet A · Drawer 2
                </div>
              </div>

              <div class="lp-qr-location-row">
                <span class="lp-qr-location-label-text">Location</span>
                <span class="lp-qr-location-val">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; color: var(--lp-accent);" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path><circle cx="12" cy="10" r="3"></circle></svg>
                  <span class="lp-qr-location-set">Cabinet A · Drawer 2</span>
                  <span class="lp-qr-saved-tag">Saved</span>
                </span>
              </div>
            </div>
          </article>

          {/* 3 — PDF invoice import (final state) */}
          <article class="lp-card lp-bento-6">
            <div class="lp-card-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M10 9H8"></path><path d="M16 13H8"></path><path d="M16 17H8"></path></svg>
            </div>
            <h3 class="lp-card-title">PDF invoices? Done.</h3>
            <p class="lp-card-desc">
              Drop in a digital invoice from Festool, Rockler, or anywhere.
              ShopKeep reads each line item, detects the brand, picks a photo,
              and files it — no SKU hunting required.
            </p>
            <div class="lp-pdf-visual">
              <div class="lp-pdf-visual-header">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M10 9H8"></path><path d="M16 13H8"></path><path d="M16 17H8"></path></svg>
                <span class="lp-pdf-visual-filename">Festool_Invoice_2026.pdf</span>
                <span class="lp-pdf-visual-status">+03 filed</span>
              </div>
              <div class="lp-pdf-visual-rows">
                {pdfItems.map((item) => (
                  <div class="lp-pdf-visual-row">
                    <span class="lp-pdf-visual-mark"></span>
                    <span class="lp-pdf-visual-name">{item.name}</span>
                    <span class="lp-pdf-visual-brand">{item.brand}</span>
                    <span class="lp-pdf-visual-price">{item.price}</span>
                  </div>
                ))}
              </div>
            </div>
          </article>

          {/* 4 — Documents on the record */}
          <article class="lp-card lp-bento-7">
            <div class="lp-card-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48"></path></svg>
            </div>
            <h3 class="lp-card-title">Manuals, warranties, receipts — on the record.</h3>
            <p class="lp-card-desc">
              Attach any PDF directly to a tool&rsquo;s record. Export a photo-rich
              insurance dossier for your whole shop in one click.
            </p>
            <div class="lp-docvault-visual">
              <div class="lp-docvault-row">
                <div class="lp-docvault-icon-wrap">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M10 9H8"></path><path d="M16 13H8"></path><path d="M16 17H8"></path></svg>
                </div>
                <span class="lp-docvault-name">ETS_150_Owners_Manual.pdf</span>
                <span class="lp-docvault-label">Manual</span>
              </div>
              <div class="lp-docvault-row">
                <div class="lp-docvault-icon-wrap">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path></svg>
                </div>
                <span class="lp-docvault-name">Warranty_Card_2026.pdf</span>
                <span class="lp-docvault-label">Warranty</span>
              </div>
              <div class="lp-docvault-row">
                <div class="lp-docvault-icon-wrap">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"></path><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"></path><path d="M12 17.5v-11"></path></svg>
                </div>
                <span class="lp-docvault-name">Rockler_Invoice_Mar.pdf</span>
                <span class="lp-docvault-label">Receipt</span>
              </div>
              <div class="lp-docvault-export-row">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path></svg>
                Insurance dossier — export PDF in one click
              </div>
            </div>
          </article>

          {/* 5 — Check out / in */}
          <article class="lp-card lp-bento-3">
            <div class="lp-card-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><polyline points="16 11 18 13 22 9"></polyline></svg>
            </div>
            <h3 class="lp-card-title">Who has it out.</h3>
            <p class="lp-card-desc">
              Check a tool out to a person, check it back in, read the whole loan
              history. A checked-out tool draws its move with an arrowhead; once
              it is overdue, the move goes dashed and turns to the alarm hue.
            </p>
          </article>

          {/* 6 — Maintenance + alerts */}
          <article class="lp-card lp-bento-4">
            <div class="lp-card-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"></rect><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><path d="M12 11h4"></path><path d="M12 16h4"></path><path d="M8 11h.01"></path><path d="M8 16h.01"></path></svg>
            </div>
            <h3 class="lp-card-title">Every repair, every alarm.</h3>
            <p class="lp-card-desc">
              Log maintenance, track warranty dates, set low-stock thresholds.
              The alarms panel counts what is unaccounted for, so nothing waits
              on you remembering it.
            </p>
          </article>

          {/* 7 — Reports */}
          <article class="lp-card lp-bento-5">
            <div class="lp-card-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" x2="18" y1="20" y2="10"></line><line x1="12" x2="12" y1="20" y2="4"></line><line x1="6" x2="6" y1="20" y2="14"></line></svg>
            </div>
            <h3 class="lp-card-title">What it is worth, and how it got there.</h3>
            <p class="lp-card-desc">
              Spend by year, by brand, by category, behind a real filter bar.
              Export to Excel, back up the database.
            </p>
            <div class="lp-small-stat">
              <span class="lp-small-stat-num">$48,621</span>
              across 134 tools
            </div>
          </article>
        </div>
      </div>
    </section>

    {/* ── Trust strip ── */}
    <section class="lp-trust">
      <div class="lp-container">
        <div class="lp-trust-grid">
          <div class="lp-trust-cell">
            <div class="lp-trust-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path></svg>
            </div>
            <div class="lp-trust-title">{trust[0].title}</div>
            <div class="lp-trust-desc">{trust[0].desc}</div>
          </div>
          <div class="lp-trust-cell">
            <div class="lp-trust-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            </div>
            <div class="lp-trust-title">{trust[1].title}</div>
            <div class="lp-trust-desc">{trust[1].desc}</div>
          </div>
          <div class="lp-trust-cell">
            <div class="lp-trust-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="16" height="16" x="4" y="4" rx="2"></rect><rect width="6" height="6" x="9" y="9" rx="1"></rect><path d="M15 2v2"></path><path d="M15 20v2"></path><path d="M2 15h2"></path><path d="M2 9h2"></path><path d="M20 15h2"></path><path d="M20 9h2"></path><path d="M9 2v2"></path><path d="M9 20v2"></path></svg>
            </div>
            <div class="lp-trust-title">{trust[2].title}</div>
            <div class="lp-trust-desc">{trust[2].desc}</div>
          </div>
          <div class="lp-trust-cell">
            <div class="lp-trust-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"></path></svg>
            </div>
            <div class="lp-trust-title">{trust[3].title}</div>
            <div class="lp-trust-desc">{trust[3].desc}</div>
          </div>
        </div>
      </div>
    </section>

    {/* ── Native iOS ── */}
    <section class="lp-native">
      <div class="lp-container">
        <div class="lp-native-grid">
          <div class="lp-native-phone" aria-hidden="true">
            <PhoneMock tone="light">
              <ShopKeepPhone />
            </PhoneMock>
          </div>

          <div class="lp-native-text">
            <span class="lp-native-eyebrow">
              <span class="lp-native-mark"></span>
              Now on iPhone and iPad
            </span>
            <h2 class="lp-native-title">{skNative.thesis}</h2>
            <p class="lp-native-sub">{skNative.intro}</p>

            <div class="lp-native-list">
              {
                skNative.highlights.map((h) => (
                  <div class="lp-native-item">
                    <span class="lp-native-icon">
                      <Icon name={h.icon} size={15} />
                    </span>
                    <div>
                      <strong>{h.title}</strong>
                      <span>{h.body}</span>
                    </div>
                  </div>
                ))
              }
            </div>

            <p class="lp-native-meta">
              <span class="lp-native-beta">TestFlight beta</span>
              {skNative.minOS} or later · {skNative.devices}
              &ensp;·&ensp;
              <a href="/ios#shopkeep">More about the native apps</a>
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ── Finale ── */}
    <section class="lp-cta-section">
      <div class="lp-cta-inner">
        <div class="lp-cta-mark"><ShopKeepMark size={60} /></div>
        <h2 class="lp-cta-title">Give the shop a register.</h2>
        <p class="lp-cta-sub">
          Every tool numbered, every drawer addressed, every move accounted
          for — and one readout that tells you where the shop stands.
        </p>
        <div class="lp-cta-foot">ShopKeep · Tool Library · LIB.01 — LIB.03</div>

        <p class="lp-privacy-note">
          Questions about your data? Read the
          <a href="/shopkeep/privacy">ShopKeep Privacy Policy</a>.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>
