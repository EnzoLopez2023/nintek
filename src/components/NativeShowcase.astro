---
import { nativeApps } from '../data/apps';

const blurbs: Record<string, string> = {
  cairn: 'Separate local-first study app; its rejected release is not public.',
  shopkeep: 'Build 35 is attached and valid; Apple and Microsoft workspaces stay separate.',
  tare: 'Build 31 is internal TestFlight for iPhone, iPad, and Apple Watch.',
  watchtower: 'Private iOS companion; legacy repository identifiers are not product naming.',
};
---

<section class="ns">
  <div class="container">
    <div class="ns-head reveal">
      <span class="eyebrow ns-eyebrow">
        <span class="eyebrow-dot"></span>
        Native relationships
      </span>
      <h2 class="ns-title">
        Four products reach <span class="em">Apple devices.</span>
      </h2>
      <p class="ns-lede">
        None has a public App Store listing. Tare is internal TestFlight, ShopKeep
        has a private attached build, Cairn remains blocked after review, and
        Watchtower has a private companion whose legacy identifiers stay behind
        the product name.
      </p>
    </div>

    <div class="ns-rail">
      {
        nativeApps.map((app) => (
          <a class="ns-card reveal" href={`/ios#${app.slug}`}>
            <div class="ns-icon-stage">
              <img
                src={`/apps/${app.slug}.png`}
                alt=""
                width="1024"
                height="1024"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="ns-card-foot">
              <div>
                <p class="ns-card-name">{app.name}</p>
                <p class="ns-card-blurb">{blurbs[app.slug]}</p>
              </div>
            </div>
          </a>
        ))
      }
    </div>

    <div class="ns-cta reveal">
      <a class="ns-btn" href="/ios">
        Read the native boundaries
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
