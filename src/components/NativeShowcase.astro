---
import PhoneMock from './PhoneMock.astro';
import CairnPhone from './mocks/ios/Cairn.astro';
import CortexPhone from './mocks/ios/Cortex.astro';
import SortiePhone from './mocks/ios/Sortie.astro';
import SalvoReleaseVisual from './SalvoReleaseVisual.astro';
import ShopKeepReleaseVisual from './ShopKeepReleaseVisual.astro';
import TareReleaseVisual from './TareReleaseVisual.astro';
import WorkshopShowcase from './WorkshopShowcase.astro';
import { nativeApps, nextNativeApp } from '../data/apps';

const phones: Record<string, any> = {
  cairn: CairnPhone,
  cortex: CortexPhone,
  sortie: SortiePhone,
};

const tones: Record<string, 'light' | 'dark' | 'navy' | 'enamel'> = {
  cairn: 'navy',
  cortex: 'dark',
  sortie: 'dark',
};

const blurbs: Record<string, string> = {
  cairn: 'Local study with private iCloud sync; the rejected release is not public.',
  shopkeep: 'Build 35 is attached and valid; Apple and Microsoft workspaces stay separate.',
  workshop: 'Build 13 is attached and valid in internal TestFlight, not public.',
  cortex: 'Build 21 is internal TestFlight; eight games, no Nintek backend.',
  tare: 'Build 31 is internal TestFlight, with real Simulator evidence across three device families.',
  sortie: 'Supply-line conquest across 1,500 levels, saved entirely on device.',
  salvo: 'Sixteen Age of Siege operations; wider campaign content remains blocked.',
};

const evidenceLabels: Record<string, string> = {
  cairn: 'Synthetic UI study',
  cortex: 'Release-build capture',
  sortie: 'Pre-release capture',
};
---

<section class="ns">
  <div class="container">
    <div class="ns-head reveal">
      <span class="eyebrow ns-eyebrow">
        <span class="eyebrow-dot"></span>
        The direction
      </span>
      <h2 class="ns-title">
        Nintek is going <span class="em">native.</span>
      </h2>
      <p class="ns-lede">
        {nativeApps.length} products now have native iOS builds in SwiftUI or Godot.
        None has a public App Store listing today: Tare, Workshop, Cortex, and
        Sortie are internal TestFlight builds; Cairn is blocked after review;
        ShopKeep has a private attached build; and Salvo remains unreleased.
      </p>
    </div>

    <div class="ns-rail">
      {
        nativeApps.map((app) => {
          const Phone = phones[app.slug];
          return (
            <a
              class={`ns-card reveal${app.slug === 'workshop' ? ' workshop-card' : ''}`}
              href={['cortex', 'sortie', 'salvo'].includes(app.slug) ? `/${app.slug}` : `/ios#${app.slug}`}
            >
              <div class={`ns-phone${app.slug === 'salvo' ? ' ns-tablet' : ''}`}>
                {
                  app.slug === 'workshop' ? (
                    <WorkshopShowcase />
                  ) : app.slug === 'tare' ? (
                    <TareReleaseVisual />
                  ) : app.slug === 'shopkeep' ? (
                    <ShopKeepReleaseVisual compact />
                  ) : app.slug === 'salvo' ? (
                    <SalvoReleaseVisual />
                  ) : (
                    <PhoneMock
                      tone={tones[app.slug] ?? 'dark'}
                      chip={evidenceLabels[app.slug]}
                      fullBleed={app.slug === 'cortex' || app.slug === 'sortie'}
                    >
                      <Phone />
                    </PhoneMock>
                  )
                }
              </div>
              <div class="ns-card-foot">
                <img
                  src={`/apps/${app.slug}.png`}
                  alt=""
                  width="34"
                  height="34"
                  loading="lazy"
                />
                <div>
                  <p class="ns-card-name">{app.name}</p>
                  <p class="ns-card-blurb">{blurbs[app.slug]}</p>
                </div>
              </div>
            </a>
          );
        })
      }
    </div>

    <div class="ns-cta reveal">
      <a class="ns-btn" href="/ios">
        See what the native apps do
        <span aria-hidden="true">→</span>
      </a>
      {
        nextNativeApp && (
          <span class="ns-next">
            <span class="ns-next-dot" />
            {nextNativeApp.name} is next.
          </span>
        )
      }
    </div>
  </div>
</section>
