---
import PhoneMock from './PhoneMock.astro';
import TabletMock from './TabletMock.astro';
import CairnPhone from './mocks/ios/Cairn.astro';
import ShopKeepPhone from './mocks/ios/ShopKeep.astro';
import WorkshopPhone from './mocks/ios/Workshop.astro';
import CortexPhone from './mocks/ios/Cortex.astro';
import TarePhone from './mocks/ios/Tare.astro';
import SortiePhone from './mocks/ios/Sortie.astro';
import SalvoPad from './mocks/ios/Salvo.astro';
import { nativeApps, nextNativeApp } from '../data/apps';

const phones: Record<string, any> = {
  cairn: CairnPhone,
  shopkeep: ShopKeepPhone,
  workshop: WorkshopPhone,
  cortex: CortexPhone,
  tare: TarePhone,
  sortie: SortiePhone,
};

const tablets: Record<string, any> = {
  salvo: SalvoPad,
};

const tones: Record<string, 'light' | 'dark' | 'navy' | 'enamel'> = {
  cairn: 'navy',
  shopkeep: 'light',
  cortex: 'dark',
  tare: 'enamel',
  sortie: 'dark',
};

const blurbs: Record<string, string> = {
  cairn: 'Local study with private iCloud sync; the rejected release is not public.',
  shopkeep: 'Apple or Microsoft sign-in, private media, and in-app account deletion.',
  workshop: 'Draft 2.2.1 (12) is internal TestFlight preparation, not a public release.',
  cortex: 'Eight native games, optional Game Center, no Nintek backend.',
  tare: 'Automatic Health imports, an Apple Watch app, and no account at all.',
  sortie: 'Supply-line conquest across 1,500 levels, saved entirely on device.',
  salvo: 'Portrait iPad tower defense, with 16 current operations and five eras ahead.',
};

const evidenceLabels: Record<string, string> = {
  cairn: 'Synthetic UI study',
  shopkeep: 'Synthetic UI study',
  tare: 'Synthetic UI study',
  cortex: 'Release-build capture',
  sortie: 'Pre-release capture',
};
---

<section class="ns">
  <div class="container">
    <div class="ns-head reveal">
      <span class="eyebrow ns-eyebrow">
        <span class="eyebrow-dot"></span>
        The direction
      </span>
      <h2 class="ns-title">
        Nintek is going <span class="em">native.</span>
      </h2>
      <p class="ns-lede">
        {nativeApps.length} products now have native iOS builds in SwiftUI or Godot.
        None has a public App Store listing today: Tare, Workshop, and Sortie are
        internal TestFlight drafts; Cairn is blocked after review; and the rest
        remain private pre-release or development builds.
      </p>
    </div>

    <div class="ns-rail">
      {
        nativeApps.map((app) => {
          const Phone = phones[app.slug];
          const Tablet = tablets[app.slug];
          return (
            <a
              class={`ns-card reveal${app.slug === 'workshop' ? ' workshop-card' : ''}`}
              href={['cortex', 'sortie', 'salvo'].includes(app.slug) ? `/${app.slug}` : `/ios#${app.slug}`}
            >
              <div class={`ns-phone${Tablet ? ' ns-tablet' : ''}`}>
                {
                  app.slug === 'workshop' ? (
                    <Phone />
                  ) : Tablet ? (
                    <TabletMock orientation="portrait" tone="navy" fullBleed>
                      <Tablet />
                    </TabletMock>
                  ) : (
                    <PhoneMock
                      tone={tones[app.slug] ?? 'dark'}
                      chip={evidenceLabels[app.slug]}
                      fullBleed={app.slug === 'cortex' || app.slug === 'sortie'}
                    >
                      <Phone />
                    </PhoneMock>
                  )
                }
              </div>
              <div class="ns-card-foot">
                <img
                  src={`/apps/${app.slug}.png`}
                  alt=""
                  width="34"
                  height="34"
                  loading="lazy"
                />
                <div>
                  <p class="ns-card-name">{app.name}</p>
                  <p class="ns-card-blurb">{blurbs[app.slug]}</p>
                </div>
              </div>
            </a>
          );
        })
      }
    </div>

    <div class="ns-cta reveal">
      <a class="ns-btn" href="/ios">
        See what the native apps do
        <span aria-hidden="true">→</span>
      </a>
      {
        nextNativeApp && (
          <span class="ns-next">
            <span class="ns-next-dot" />
            {nextNativeApp.name} is next.
          </span>
        )
      }
    </div>
  </div>
</section>
