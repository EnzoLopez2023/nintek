---
import PhoneMock from './PhoneMock.astro';
import CairnPhone from './mocks/ios/Cairn.astro';
import ShopKeepPhone from './mocks/ios/ShopKeep.astro';
import WorkshopPhone from './mocks/ios/Workshop.astro';
import CortexPhone from './mocks/ios/Cortex.astro';
import TarePhone from './mocks/ios/Tare.astro';
import { nativeApps, nextNativeApp } from '../data/apps';

const phones: Record<string, any> = {
  cairn: CairnPhone,
  shopkeep: ShopKeepPhone,
  workshop: WorkshopPhone,
  cortex: CortexPhone,
  tare: TarePhone,
};

const tones: Record<string, 'light' | 'dark' | 'navy' | 'enamel'> = {
  cairn: 'navy',
  shopkeep: 'light',
  workshop: 'dark',
  cortex: 'dark',
  tare: 'enamel',
};

const blurbs: Record<string, string> = {
  cairn: 'No account. No network. The whole exam library on your phone.',
  shopkeep: 'The register in your pocket, and the readout on your Home Screen.',
  workshop: 'Cut plans computed on device, cut list on your Lock Screen.',
  cortex: 'Eight native games, Game Center, zero backend calls.',
  tare: 'Widgets, an Apple Watch app and Apple Health \u2014 with no account at all.',
};
---

<section class="ns">
  <div class="container">
    <div class="ns-head reveal">
      <span class="eyebrow ns-eyebrow">
        <span class="eyebrow-dot"></span>
        The direction
      </span>
      <h2 class="ns-title">
        Nintek is going <span class="em">native.</span>
      </h2>
      <p class="ns-lede">
        The web apps aren&rsquo;t going anywhere &mdash; but five of them now have real
        SwiftUI counterparts on iPhone and iPad, sharing one Swift foundation and
        doing the things only a native app can. All five are in TestFlight beta.
      </p>
    </div>

    <div class="ns-rail">
      {
        nativeApps.map((app) => {
          const Phone = phones[app.slug];
          return (
            <a class="ns-card reveal" href={app.slug === 'cortex' ? '/cortex' : `/ios#${app.slug}`}>
              <div class="ns-phone">
                <PhoneMock tone={tones[app.slug] ?? 'dark'} fullBleed={app.slug === 'cortex'}>
                  <Phone />
                </PhoneMock>
              </div>
              <div class="ns-card-foot">
                <img
                  src={`/apps/${app.slug}.png`}
                  alt=""
                  width="34"
                  height="34"
                  loading="lazy"
                />
                <div>
                  <p class="ns-card-name">{app.name}</p>
                  <p class="ns-card-blurb">{blurbs[app.slug]}</p>
                </div>
              </div>
            </a>
          );
        })
      }
    </div>

    <div class="ns-cta reveal">
      <a class="ns-btn" href="/ios">
        See what the native apps do
        <span aria-hidden="true">→</span>
      </a>
      {
        nextNativeApp && (
          <span class="ns-next">
            <span class="ns-next-dot" />
            {nextNativeApp.name} is next.
          </span>
        )
      }
    </div>
  </div>
</section>
