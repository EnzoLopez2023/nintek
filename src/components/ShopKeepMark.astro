---
/**
 * ShopKeep mark — a machined plate carrying one toolpath: a cyan rapid down
 * into position, a green cut across, and the tool at its position.
 *
 * One-Drawing Rule: this geometry is the app's own, generated from
 * `scripts/icon.mjs` in the ShopKeep repo, which emits the favicon, the App
 * Store icon and AppIcon-1024.png as byte-identical files. Coordinates are on
 * the same 64-unit grid. Do not restyle it per theme — like a favicon, the
 * mark stays constant.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 64, class: className } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 64 64"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  aria-hidden="true"
>
  <rect width="64" height="64" rx="5" fill="#101A17"></rect>
  <g stroke-width="9" fill="none">
    <line x1="20" y1="13" x2="20" y2="44" stroke="#4FBAF0"></line>
    <line x1="15.5" y1="44" x2="38.5" y2="44" stroke="#3ED494"></line>
  </g>
  <path d="M37.5 36 L49 44 L37.5 52 Z" fill="#3ED494"></path>
</svg>
