---
import type { App } from '../data/apps';

interface Props {
  app: App;
}
const { app } = Astro.props;
// Per-app pages (/<slug>) are intentionally NOT linked from the public site —
// they exist for App Store listings + privacy URLs. Cards are showcases only.
---

<div class="app-card">
  <img class="icon" src={app.icon} alt={`${app.name} icon`} width="56" height="56" loading="lazy" />
  <div class="meta">
    <div class="name">
      {app.name}
      <span class="pill">{app.category}</span>
    </div>
    <div class="tag">{app.tagline}</div>
  </div>
</div>
