---
import { Image } from 'astro:assets';
import TabletMock from './TabletMock.astro';
import titleScreen from '../assets/salvo/release/01-title.png';

interface Props {
  eager?: boolean;
}

const { eager = false } = Astro.props;
---

<figure class="srv">
  <TabletMock orientation="portrait" tone="navy" fullBleed>
    <Image
      src={titleScreen}
      format="webp"
      widths={[420, 620, 820, 1032]}
      sizes="(max-width: 700px) 86vw, 420px"
      alt="Salvo title screen showing the Age of Siege campaign entry"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding="async"
    />
  </TabletMock>
  <figcaption>Automated iPad release capture · not physical-device evidence</figcaption>
</figure>

<style>
  .srv {
    width: min(100%, 430px);
    margin: 0 auto;
  }

  .srv :global(.pad-wrap) {
    width: 100%;
  }

  .srv figcaption {
    margin-top: 12px;
    color: var(--sa-bluegray, #9eb0bf);
    font-family: var(--sa-data, ui-monospace, monospace);
    font-size: 0.62rem;
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: 0.04em;
    text-align: center;
    text-transform: uppercase;
  }
</style>
