---
interface Props {
  ipadSrc?: string;
  iphoneSrc?: string;
  ipadAlt?: string;
  iphoneAlt?: string;
  eager?: boolean;
}

const {
  ipadSrc = '/apps/workshop/ipad-dashboard.png',
  iphoneSrc = '/apps/workshop/iphone-project.png',
  ipadAlt = 'Workshop dashboard showing active projects, Shaper projects, and project templates on iPad',
  iphoneAlt = 'Workshop project detail showing a technical plan, project status, estimated cost, wood, and tools on iPhone',
  eager = false,
} = Astro.props;
---

<div class="ws-proof">
  <div class="ws-proof-pad">
    <img
      src={ipadSrc}
      alt={ipadAlt}
      width="2064"
      height="2752"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  </div>
  <div class="ws-proof-phone">
    <img
      src={iphoneSrc}
      alt={iphoneAlt}
      width="1206"
      height="2622"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  </div>
</div>

<style>
  .ws-proof {
    position: relative;
    width: 100%;
    padding: 3% 8% 9% 0;
    isolation: isolate;
  }
  .ws-proof::before {
    content: '';
    position: absolute;
    inset: 9% 3% 2% 10%;
    z-index: -1;
    background:
      repeating-linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.035) 0 1px,
        transparent 1px 3px
      ),
      #1a2025;
    border: 1px solid #47535b;
    transform: translate(16px, 18px);
  }
  .ws-proof-pad,
  .ws-proof-phone {
    background: linear-gradient(145deg, #566269, #1a2025 46%, #39434a);
    border: 1px solid #6e7a78;
    box-shadow: 0 30px 70px -34px rgba(0, 0, 0, 0.78);
  }
  .ws-proof-pad {
    width: 78%;
    padding: 7px;
    border-radius: 24px;
  }
  .ws-proof-phone {
    position: absolute;
    right: 2%;
    bottom: 0;
    z-index: 2;
    width: 29%;
    padding: 5px;
    border-radius: 21px;
    transform: rotate(1.75deg);
  }
  .ws-proof img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .ws-proof-pad img {
    border-radius: 17px;
  }
  .ws-proof-phone img {
    border-radius: 16px;
  }

  @media (max-width: 700px) {
    .ws-proof {
      padding-right: 11%;
      padding-bottom: 12%;
    }
    .ws-proof-pad {
      width: 82%;
      border-radius: 18px;
      padding: 5px;
    }
    .ws-proof-pad img {
      border-radius: 12px;
    }
    .ws-proof-phone {
      width: 31%;
      border-radius: 16px;
      padding: 4px;
    }
    .ws-proof-phone img {
      border-radius: 12px;
    }
  }
</style>
