---
interface Props {
  eager?: boolean;
}

const { eager = false } = Astro.props;
const loading = eager ? 'eager' : 'lazy';
---

<figure class="ws-proof ws-proof-web">
  <div class="ws-browser-bar" aria-hidden="true">
    <span class="ws-browser-dots"><i></i><i></i><i></i></span>
    <span>Workshop · web workspace</span>
  </div>
  <img
    src="/apps/workshop/web-project.webp"
    alt="Current Workshop web app showing a walnut shelf plan with its next action, parts count, and stock"
    width="598"
    height="500"
    loading={loading}
    decoding="async"
  />
  <figcaption class="ws-proof-label">Current web capture</figcaption>
</figure>

<style>
  .ws-proof {
    --ws-recessed: #e0ebe7;
    --ws-surface: #fafcfb;
    --ws-muted: #58716b;
    --ws-divider: #c9dad5;
    --ws-divider-strong: #afc7c0;
    --ws-action: #125447;
    --ws-pencil: #356d85;

    position: relative;
    width: 100%;
    margin: 0;
    color: var(--ws-ink);
    isolation: isolate;
  }

  .ws-proof img {
    display: block;
    width: 100%;
    height: auto;
  }

  .ws-proof-label {
    margin: 0;
    padding: 8px 10px;
    color: var(--ws-muted);
    font-size: 0.68rem;
    font-weight: 650;
    line-height: 1.35;
  }

  .ws-proof-web {
    overflow: hidden;
    border: 1px solid var(--ws-divider-strong);
    border-radius: 24px;
    background: var(--ws-surface);
    box-shadow: 0 22px 48px -28px rgba(21, 51, 46, 0.42);
  }

  .ws-browser-bar {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr) 72px;
    min-height: 42px;
    align-items: center;
    padding: 0 14px;
    border-bottom: 1px solid var(--ws-divider);
    background: var(--ws-recessed);
    color: var(--ws-muted);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
    font-size: 0.72rem;
    text-align: center;
  }

  .ws-browser-dots {
    display: flex;
    gap: 6px;
  }

  .ws-browser-dots i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ws-divider-strong);
  }

  .ws-browser-dots i:nth-child(2) {
    background: var(--ws-pencil);
  }

  .ws-browser-dots i:nth-child(3) {
    background: var(--ws-action);
  }

  @media (max-width: 700px) {
    .ws-proof-web {
      border-radius: 18px;
    }

    .ws-browser-bar {
      grid-template-columns: 56px minmax(0, 1fr) 56px;
      min-height: 36px;
      padding-inline: 10px;
      font-size: 0.62rem;
    }
  }

  @media (prefers-color-scheme: dark) {
    .ws-proof {
      --ws-recessed: #12201d;
      --ws-surface: #182823;
      --ws-muted: #9cb2ac;
      --ws-divider: #2a423c;
      --ws-divider-strong: #3c5a52;
      --ws-action: #68c7b0;
      --ws-pencil: #7ab9d3;
    }
  }
</style>
