---
// Tare's widgets, as the gallery installs them.
//
// Five kinds ship: Next Dose, Glucose, Weight, Tare Dashboard and Food Photo.
// Home-screen tiles are a domain's `soft` field inside its `edge` keyline, with
// an engraved header and a struck numeral — the same construction as a tile on
// the Today screen, which is the point.
//
// The accessory families are deliberately monochrome. The system tints them, so
// none of them may lean on colour to carry meaning: "due" is spelled out, and a
// glucose band is named rather than merely coloured.

interface Props {
  /** Which group to render. */
  kind: 'home' | 'lock' | 'island';
}
const { kind } = Astro.props;
---

{
  kind === 'home' && (
    <div class="wg-home">
      <div class="wg-tile med">
        <div class="wg-head">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M10.5 20.5 20.5 10.5a5 5 0 0 0-7-7l-10 10a5 5 0 0 0 7 7Zm-2-12 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
          <span>Next dose</span>
        </div>
        <p class="wg-num">4d</p>
        <p class="wg-foot">Sun · 7.5 mg</p>
      </div>

      <div class="wg-tile glu">
        <div class="wg-head">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C8 8 6 11 6 14a6 6 0 0 0 12 0c0-3-2-6-6-12Z" />
          </svg>
          <span>Glucose</span>
        </div>
        <p class="wg-num">102</p>
        <p class="wg-foot">mg/dL · Normal</p>
      </div>

      <div class="wg-tile wgt">
        <div class="wg-head">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="5" r="2" />
            <path d="M4 21h16l-3-11H7L4 21Z" />
          </svg>
          <span>Weight</span>
        </div>
        <p class="wg-num">242.1</p>
        <p class="wg-foot">lbs · 58% to goal</p>
      </div>

      {/* The Dashboard widget is medium/large only, so it spans. */}
      <div class="wg-tile wg-tile--wide plate">
        <div class="wg-head wg-head--split">
          <span class="wg-brand">Tare</span>
          <span class="wg-a1c">eA1C 6.1%</span>
        </div>
        <div class="wg-dash">
          <div class="wg-dash-cell">
            <span class="wg-dash-cap">Dose</span>
            <span class="wg-dash-val med">4d</span>
          </div>
          <div class="wg-dash-cell">
            <span class="wg-dash-cap">Weight</span>
            <span class="wg-dash-val wgt">242.1</span>
          </div>
          <div class="wg-dash-cell">
            <span class="wg-dash-cap">Glucose</span>
            <span class="wg-dash-val glu">102</span>
          </div>
        </div>
        <div class="wg-dash-bar" aria-hidden="true">
          <i style="width: 58%" />
        </div>
      </div>
    </div>
  )
}

{
  kind === 'lock' && (
    <div class="wg-lock">
      <p class="wg-lock-time">9:41</p>
      <p class="wg-lock-date">Wednesday 5 August</p>
      <div class="wg-lock-row">
        <div class="wg-acc wg-acc--circ">
          <span class="wg-acc-num">4</span>
          <span class="wg-acc-cap">days</span>
        </div>
        <div class="wg-acc wg-acc--rect">
          <span class="wg-acc-cap">Next dose</span>
          <span class="wg-acc-line">4 days · Sun</span>
          <span class="wg-acc-sub">Mounjaro 7.5 mg</span>
        </div>
        <div class="wg-acc wg-acc--circ">
          <span class="wg-acc-num">102</span>
          <span class="wg-acc-cap">mg/dL</span>
        </div>
      </div>
      <p class="wg-lock-inline">◷ Tare · 102 mg/dL Normal</p>
    </div>
  )
}

{
  kind === 'island' && (
    <div class="wg-island-wrap">
      <div class="wg-island">
        <span class="wg-island-lead">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C8 8 6 11 6 14a6 6 0 0 0 12 0c0-3-2-6-6-12Z" />
          </svg>
        </span>
        <span class="wg-island-mid">Dose day</span>
        <span class="wg-island-trail">2:14</span>
      </div>
      <p class="wg-island-cap">Live Activity · Dynamic Island</p>
    </div>
  )
}

<style>
  /* ── Home Screen ── */
  .wg-home {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .wg-tile {
    display: flex;
    flex-direction: column;
    aspect-ratio: 1;
    padding: 12px;
    border-radius: 20px;
    border: 1px solid transparent;
    box-shadow: 0 10px 26px -14px rgba(34, 44, 51, 0.4);
  }
  .wg-tile--wide {
    grid-column: span 3;
    aspect-ratio: auto;
    gap: 14px;
  }

  .wg-tile.med {
    background: #ddd6f5;
    border-color: #c2b5ec;
    color: #472f9e;
  }
  .wg-tile.glu {
    background: #c7e6ee;
    border-color: #a6d5e1;
    color: #0a5d72;
  }
  .wg-tile.wgt {
    background: #cedbf2;
    border-color: #b2c6e9;
    color: #1e3d8c;
  }
  .wg-tile.plate {
    background: #fff;
    border-color: #d6e2e8;
    color: #222c33;
  }

  .wg-head {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    font-variation-settings: 'wdth' 88;
  }
  .wg-head--split {
    justify-content: space-between;
  }
  .wg-brand {
    font-size: 11px;
    letter-spacing: 0.1em;
  }
  .wg-a1c {
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    color: #472f9e;
  }

  .wg-num {
    margin: auto 0 0;
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -0.025em;
    font-variation-settings: 'wdth' 116;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .wg-foot {
    margin: 5px 0 0;
    font-size: 10px;
    font-weight: 500;
    opacity: 0.75;
  }

  .wg-dash {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }
  .wg-dash-cell {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .wg-dash-cap {
    font-size: 8.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-variation-settings: 'wdth' 88;
    color: #5e6e79;
  }
  .wg-dash-val {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.025em;
    font-variation-settings: 'wdth' 116;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .wg-dash-val.med {
    color: #472f9e;
  }
  .wg-dash-val.wgt {
    color: #1e3d8c;
  }
  .wg-dash-val.glu {
    color: #0a5d72;
  }
  .wg-dash-bar {
    margin-top: 2px;
    height: 5px;
    border-radius: 3px;
    background: #e4edf1;
    overflow: hidden;
  }
  .wg-dash-bar i {
    display: block;
    height: 100%;
    border-radius: 3px;
    background: #5c82d8;
  }

  /* ── Lock Screen ── */
  .wg-lock {
    padding: 26px 20px 22px;
    border-radius: 26px;
    background:
      radial-gradient(120% 90% at 30% 0%, #2f3d47, #141c21 70%);
    color: #fff;
    text-align: center;
    box-shadow: 0 18px 40px -20px rgba(20, 28, 33, 0.7);
  }
  .wg-lock-time {
    margin: 0;
    font-size: 52px;
    font-weight: 700;
    letter-spacing: -0.03em;
    font-variation-settings: 'wdth' 112;
    line-height: 0.95;
    font-variant-numeric: tabular-nums;
  }
  .wg-lock-date {
    margin: 4px 0 16px;
    font-size: 12px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.7);
  }

  .wg-lock-row {
    display: flex;
    align-items: stretch;
    justify-content: center;
    gap: 10px;
  }

  /* Monochrome, because the system tints these. */
  .wg-acc {
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: rgba(255, 255, 255, 0.16);
    color: #fff;
    backdrop-filter: blur(6px);
  }
  .wg-acc--circ {
    width: 62px;
    height: 62px;
    border-radius: 50%;
    align-items: center;
    gap: 1px;
    flex: none;
  }
  .wg-acc--rect {
    flex: 1;
    max-width: 168px;
    border-radius: 14px;
    padding: 8px 11px;
    align-items: flex-start;
    gap: 2px;
    text-align: left;
  }
  .wg-acc-num {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.02em;
    font-variation-settings: 'wdth' 116;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .wg-acc-cap {
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    font-variation-settings: 'wdth' 88;
    color: rgba(255, 255, 255, 0.75);
  }
  .wg-acc-line {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .wg-acc-sub {
    font-size: 10px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.7);
  }
  .wg-lock-inline {
    margin: 14px 0 0;
    font-size: 11px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.78);
  }

  /* ── Dynamic Island ── */
  .wg-island-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .wg-island {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 9px 16px;
    border-radius: 999px;
    background: #0b0f12;
    color: #fff;
    box-shadow: 0 12px 30px -14px rgba(11, 15, 18, 0.8);
  }
  .wg-island-lead {
    display: inline-flex;
    color: #ea6b58;
  }
  .wg-island-mid {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  .wg-island-trail {
    font-size: 13px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
    color: #ea6b58;
  }
  .wg-island-cap {
    margin: 0;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #5e6e79;
  }

  @media (max-width: 560px) {
    .wg-home {
      grid-template-columns: repeat(2, 1fr);
    }
    .wg-tile--wide {
      grid-column: span 2;
    }
  }
</style>
