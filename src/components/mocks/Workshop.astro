---
// The Workshop's dashboard: a Solari shop board. Rail as heading, graphite flap
// modules for every figure, projects as departure cards. Mirrors the shipping
// Concourse Board identity — nothing here rounds past 3px.
const cells = [
  { label: 'In Progress', value: '02', sub: 'active builds', tone: 'amber' },
  { label: 'In Queue', value: '18', sub: 'ideas & plans', tone: 'ink' },
  { label: 'Total Parts', value: '085', sub: 'across active projects', tone: 'ink' },
  { label: 'Est. Value', value: '$1353', sub: 'in materials', tone: 'green' },
];

const departures = [
  {
    title: 'Under Workbench Storage',
    flag: 'In Progress',
    tone: 'amber',
    stock: 'Plywood',
    parts: '11',
    hours: '12H',
  },
  {
    title: 'Walnut Serving Tray',
    flag: 'Complete',
    tone: 'green',
    stock: 'Walnut · Maple',
    parts: '10',
    hours: '06H',
  },
];
---

<div class="wk">
  <div class="wk-board">
    <div class="wk-rail">
      <span>Shop Board</span>
      <span class="wk-rail-count">Tue Aug 4 · 17:54</span>
    </div>
    <div class="wk-cells">
      {
        cells.map((c) => (
          <div class="wk-cell">
            <span class="wk-caps">{c.label}</span>
            <span class="wk-flaps">
              {c.value.split('').map((ch) => (
                <span class={`wk-flap t-${c.tone}`}>{ch}</span>
              ))}
            </span>
            <span class="wk-cell-sub">{c.sub}</span>
          </div>
        ))
      }
    </div>
  </div>

  <div class="wk-rail solo">
    <span>Projects</span>
    <span class="wk-rail-count">03</span>
  </div>

  <div class="wk-departures">
    {
      departures.map((d) => (
        <div class="wk-depart">
          <span class="wk-depart-head">
            <span class="wk-depart-title">{d.title}</span>
            <span class={`wk-flag f-${d.tone}`}>{d.flag}</span>
          </span>
          <span class="wk-depart-foot">
            <span>
              <span class="wk-caps">Stock</span>
              <span class="wk-readout">{d.stock}</span>
            </span>
            <span>
              <span class="wk-caps">Parts</span>
              <span class="wk-readout">{d.parts}</span>
            </span>
            <span>
              <span class="wk-caps">Hours</span>
              <span class="wk-readout">{d.hours}</span>
            </span>
          </span>
        </div>
      ))
    }
  </div>
</div>

<style>
  .wk {
    /* Concourse Board tokens — ported verbatim from the app's DESIGN.md. */
    --wk-concourse: #dde3e0;
    --wk-flap: #f7f9f6;
    --wk-flap-shade: #e5eae6;
    --wk-ink: #14181a;
    --wk-muted: #59686a;
    --wk-line: #c0cac6;
    --wk-steel: #2b3238;
    --wk-steel-dark: #1a2025;
    --wk-on-steel: #edf1ee;
    --wk-amber-fill: #ffb400;
    --wk-green-fill: #46a46a;
    --wk-green: #2e7148;
    --wk-face: #2e363b;
    --wk-face-lo: #232a2e;
    --wk-letter: #f2f4f1;
    --wk-board:
      'Martian Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    --wk-ui: Archivo, system-ui, -apple-system, 'Segoe UI', sans-serif;
    --wk-steel-face:
      repeating-linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.04) 0 1px,
        transparent 1px 3px
      ),
      linear-gradient(180deg, #47535b 0, #2b3238 42%, #1a2025 100%);

    display: flex;
    flex-direction: column;
    gap: 14px;
    background: var(--wk-concourse);
    padding: 14px;
    border: 1px solid var(--wk-line);
    border-radius: 3px;
    font-family: var(--wk-ui);
  }

  /* ---- the rail is the heading ---- */
  .wk-rail {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    position: relative;
    padding: 8px 12px;
    background: var(--wk-steel-face);
    color: var(--wk-on-steel);
    font-family: var(--wk-board);
    font-size: 10px;
    font-weight: 600;
    font-stretch: 82%;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.14),
      0 1px 0 rgba(20, 24, 26, 0.22);
  }
  /* rivets */
  .wk-rail::before,
  .wk-rail::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 2px;
    height: 2px;
    margin-top: -1px;
    background: rgba(255, 255, 255, 0.22);
  }
  .wk-rail::before {
    left: 5px;
  }
  .wk-rail::after {
    right: 5px;
  }
  .wk-rail.solo {
    border: 1px solid var(--wk-steel-dark);
  }
  .wk-rail-count {
    color: var(--wk-amber-fill);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.12em;
  }

  /* ---- the board ---- */
  .wk-board {
    border: 1px solid var(--wk-steel-dark);
    background: var(--wk-flap);
  }
  .wk-cells {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .wk-cell {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 11px 12px;
    border-top: 1px solid var(--wk-line);
  }
  .wk-cell:nth-child(odd) {
    border-right: 1px solid var(--wk-line);
  }
  .wk-cell:nth-child(-n + 2) {
    border-top: 0;
  }
  .wk-caps {
    display: block;
    font-family: var(--wk-board);
    font-size: 8.5px;
    font-weight: 600;
    font-stretch: 82%;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--wk-muted);
  }
  .wk-cell-sub {
    font-size: 10.5px;
    color: var(--wk-muted);
    line-height: 1.3;
  }

  /* ---- flap modules: graphite in both renditions, severed by the seam ---- */
  .wk-flaps {
    display: flex;
    gap: 2px;
  }
  .wk-flap {
    position: relative;
    width: 17px;
    height: 24px;
    display: grid;
    place-items: center;
    border-radius: 2px;
    background: linear-gradient(
      180deg,
      var(--wk-face) 0 50%,
      var(--wk-face-lo) 50% 100%
    );
    color: var(--wk-letter);
    font-family: var(--wk-board);
    font-size: 12px;
    font-weight: 700;
    font-stretch: 82%;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }
  /* the split line — the single most identifying mark in the system */
  .wk-flap::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background: rgba(10, 13, 14, 0.66);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.07);
  }
  .wk-flap.t-amber {
    color: var(--wk-amber-fill);
  }
  .wk-flap.t-green {
    color: #6bc48d;
  }

  /* ---- departure cards ---- */
  .wk-departures {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .wk-depart {
    display: flex;
    flex-direction: column;
    gap: 9px;
    padding: 11px 12px;
    background: var(--wk-flap);
    border: 1px solid var(--wk-line);
    border-radius: 3px;
    box-shadow: 0 1px 0 rgba(20, 24, 26, 0.1);
  }
  .wk-depart-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .wk-depart-title {
    font-family: var(--wk-board);
    font-size: 11px;
    font-weight: 700;
    font-stretch: 82%;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--wk-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .wk-flag {
    position: relative;
    flex: none;
    padding: 3px 7px;
    border-radius: 2px;
    font-family: var(--wk-board);
    font-size: 8px;
    font-weight: 700;
    font-stretch: 82%;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .wk-flag::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background: rgba(20, 24, 26, 0.16);
  }
  .wk-flag.f-amber {
    background: var(--wk-amber-fill);
    color: var(--wk-ink);
  }
  .wk-flag.f-green {
    background: var(--wk-green-fill);
    color: #08150d;
  }
  .wk-depart-foot {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    border-top: 1px solid var(--wk-line);
  }
  .wk-depart-foot > span {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 8px 10px 0;
  }
  .wk-depart-foot > span:first-child {
    padding-left: 0;
  }
  .wk-depart-foot > span + span {
    border-left: 1px solid var(--wk-line);
  }
  .wk-readout {
    font-family: var(--wk-board);
    font-size: 11px;
    font-weight: 600;
    font-stretch: 82%;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
    color: var(--wk-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @container (max-width: 380px) {
    .wk-cells {
      grid-template-columns: 1fr;
    }
    .wk-cell:nth-child(odd) {
      border-right: 0;
    }
    .wk-cell:nth-child(2) {
      border-top: 1px solid var(--wk-line);
    }
  }
</style>
