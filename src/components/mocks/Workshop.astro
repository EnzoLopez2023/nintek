---
const pieces = [
  { label: 'Legs ×4', w: 26 },
  { label: 'Apron ×2', w: 22 },
  { label: 'Top slat ×3', w: 34 },
  { label: 'Stretcher', w: 18 },
];
const cuts = [
  { part: 'Legs', spec: '2×2 walnut @ 17"', qty: 4 },
  { part: 'Top slats', spec: '1×4 walnut @ 48"', qty: 3 },
  { part: 'Aprons', spec: '1×3 walnut @ 42"', qty: 2 },
];
---

<div class="wk">
  <div class="wk-board">
    <div class="wk-board-label">Board layout · 1 × 8 × 96"</div>
    <div class="wk-pieces">
      {pieces.map((p, i) => (
        <div class={`wk-piece wk-p${i}`} style={`flex:${p.w}`}>{p.label}</div>
      ))}
      <div class="wk-piece wk-waste" style="flex:8">waste</div>
    </div>
  </div>

  <div class="wk-list">
    {cuts.map((c) => (
      <div class="wk-row">
        <span class="wk-part">{c.part}</span>
        <span class="wk-spec">{c.spec}</span>
        <span class="wk-qty">×{c.qty}</span>
      </div>
    ))}
  </div>

  <div class="wk-prog">
    <span class="wk-prog-l">Walnut bench</span>
    <span class="wk-prog-bar"><span class="wk-prog-fill" style="width:60%"></span></span>
    <span class="wk-prog-pct">60%</span>
  </div>
</div>

<style>
  .wk { display: flex; flex-direction: column; gap: 14px; }
  .wk-board { border: 1px solid var(--copper-edge); border-radius: var(--r-md); background: var(--copper-soft); padding: 10px 12px; }
  .wk-board-label { font-size: 10.5px; font-weight: 600; color: var(--accent-deep); margin-bottom: 8px; }
  .wk-pieces { display: flex; gap: 4px; height: 40px; }
  .wk-piece {
    border-radius: 6px; display: grid; place-items: center;
    font-size: 9.5px; font-weight: 600; color: var(--walnut-text);
    overflow: hidden; white-space: nowrap; padding: 0 4px;
  }
  .wk-p0 { background: #8b4513; }
  .wk-p1 { background: #a05a2c; }
  .wk-p2 { background: #7a3d12; }
  .wk-p3 { background: #b06a30; }
  .wk-waste { background: repeating-linear-gradient(45deg, var(--border), var(--border) 4px, var(--cream) 4px, var(--cream) 8px); color: var(--ink-muted); }
  .wk-list { display: flex; flex-direction: column; gap: 7px; }
  .wk-row { display: grid; grid-template-columns: 70px 1fr 28px; align-items: center; gap: 8px; font-size: 12px; }
  .wk-part { font-weight: 700; color: var(--ink); }
  .wk-spec { color: var(--ink-soft); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .wk-qty { font-weight: 600; color: var(--accent-deep); text-align: right; }
  .wk-prog { display: flex; align-items: center; gap: 10px; padding-top: 2px; }
  .wk-prog-l { font-size: 12px; font-weight: 600; color: var(--ink); white-space: nowrap; }
  .wk-prog-bar { flex: 1; height: 8px; border-radius: 99px; background: var(--border); overflow: hidden; }
  .wk-prog-fill { display: block; height: 100%; border-radius: 99px; background: linear-gradient(90deg, var(--copper), var(--accent)); }
  .wk-prog-pct { font-size: 12px; font-weight: 700; color: var(--ink); }
</style>
