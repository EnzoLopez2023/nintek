---
import Icon from '../Icon.astro';

const stats = [
  { label: 'Total Tools', value: '247', icon: 'package', bg: 'var(--copper-soft)', fg: 'var(--copper)' },
  { label: 'Needs Attention', value: '3', icon: 'alert', bg: '#fef3e2', fg: '#c2761a' },
  { label: 'Checked Out', value: '2', icon: 'user', bg: '#ece9fa', fg: '#6d5bd0' },
  { label: 'Total Value', value: '$14,820', icon: 'dollar', bg: '#e4f5ee', fg: '#1f9d6b' },
] as const;

const items = [
  { name: 'DeWalt 20V Drill', sub: 'Power · Cabinet 2', badge: 'good', icon: 'hammer' },
  { name: 'SawStop Table Saw', sub: 'Stationary · Bay A', badge: 'excellent', icon: 'package' },
  { name: 'Router Bit Set', sub: 'Bits · Drawer 6', badge: 'good', icon: 'grid' },
] as const;
---

<div class="stat-row">
  {stats.map((s) => (
    <div class="stat">
      <div class="stat-icon" style={`background:${s.bg};color:${s.fg}`}><Icon name={s.icon} /></div>
      <div class="stat-label">{s.label}</div>
      <div class="stat-value">{s.value}</div>
    </div>
  ))}
</div>

<div class="itemcards">
  {items.map((it) => (
    <div class="itemcard">
      <div class="itemcard-img">
        <span class={`itemcard-badge badge-${it.badge}`}>{it.badge === 'excellent' ? 'Excellent' : 'Good'}</span>
        <Icon name={it.icon} size={24} />
      </div>
      <div class="itemcard-body">
        <div class="itemcard-name">{it.name}</div>
        <div class="itemcard-sub">{it.sub}</div>
      </div>
    </div>
  ))}
</div>
