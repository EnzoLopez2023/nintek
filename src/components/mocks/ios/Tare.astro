---
// Tare on iPhone: the dashboard as it actually ships — a weight trend drawn on
// device, the glucose summary, and the next dose. No widgets or Live Activity
// are shown here because the port does not have them yet.

// Sparkline: a month of weights trending down, plotted into a 0-100 viewBox.
const weights = [252.0, 251.4, 250.9, 251.2, 250.1, 249.6, 249.8, 248.9, 248.4];
const min = Math.min(...weights);
const max = Math.max(...weights);
const pts = weights
  .map((w, i) => {
    const x = (i / (weights.length - 1)) * 100;
    const y = 30 - ((w - min) / (max - min)) * 26 - 2;
    return `${x.toFixed(1)},${y.toFixed(1)}`;
  })
  .join(' ');
---

<div class="tio">
  <div class="tio-head">
    <span class="tio-date">Thursday, 12 June</span>
    <span class="tio-dot" aria-hidden="true"></span>
  </div>

  <div class="tio-journey">
    <div class="tio-chip">
      <span class="tio-chip-num">312</span>
      <span class="tio-chip-unit">days</span>
      <span class="tio-chip-cap">Dx</span>
      <span class="tio-chip-bar glu"></span>
    </div>
    <div class="tio-chip">
      <span class="tio-chip-num">96</span>
      <span class="tio-chip-unit">days</span>
      <span class="tio-chip-cap">Keto</span>
      <span class="tio-chip-bar act"></span>
    </div>
    <div class="tio-chip">
      <span class="tio-chip-num">58</span>
      <span class="tio-chip-unit">days</span>
      <span class="tio-chip-cap">Mounjaro</span>
      <span class="tio-chip-bar med"></span>
    </div>
  </div>

  <div class="tio-tiles">
    <div class="tio-tile accent">
      <p class="tio-cap">Next dose</p>
      <p class="tio-tile-val">Sun 8:30</p>
      <p class="tio-tile-sub">Mounjaro &middot; 7.5 mg</p>
    </div>
    <div class="tio-tile">
      <p class="tio-cap">Weight</p>
      <p class="tio-tile-val">248.4</p>
      <p class="tio-tile-sub">lb &middot; down 3.6</p>
    </div>
    <div class="tio-tile">
      <p class="tio-cap">Glucose</p>
      <p class="tio-tile-val">108</p>
      <p class="tio-tile-sub">mg/dL &middot; fasting</p>
    </div>
    <div class="tio-tile">
      <p class="tio-cap">Well-being</p>
      <p class="tio-tile-val">7</p>
      <p class="tio-tile-sub">mood &middot; energy 6</p>
    </div>
  </div>

  <div class="tio-trend">
    <div class="tio-trend-head">
      <span class="tio-trend-title">30-Day Trend</span>
      <span class="tio-delta">
        <svg
          width="9"
          height="9"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="3.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 5v14"></path>
          <path d="m19 12-7 7-7-7"></path>
        </svg>
        3.6 lb
      </span>
    </div>
    <svg class="tio-spark" viewBox="0 0 100 32" preserveAspectRatio="none" aria-hidden="true">
      <polyline points={pts} fill="none" stroke-width="2.2" vector-effect="non-scaling-stroke"
      ></polyline>
    </svg>
    <div class="tio-trend-foot">
      <span>252.0</span>
      <span>Drawn on device</span>
      <span>248.4</span>
    </div>
  </div>

  <div class="tio-wb">
    <span class="tio-trend-title">Well-being today</span>
    <div class="tio-wb-row">
    <div class="tio-wb-cell">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
        stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 14s1.5 2 4 2 4-2 4-2M9 9h.01M15 9h.01"></path></svg>
      <span class="tio-wb-num">4<i>/5</i></span>
      <span class="tio-wb-cap">mood</span>
      <span class="tio-wb-bar"><i style="width: 60%"></i></span>
    </div>
    <div class="tio-wb-cell">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
        stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m13 2-8 12h6l-1 8 8-12h-6z"></path></svg>
      <span class="tio-wb-num">3<i>/5</i></span>
      <span class="tio-wb-cap">energy</span>
      <span class="tio-wb-bar"><i style="width: 45%"></i></span>
    </div>
    <div class="tio-wb-cell">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
        stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 2v7a3 3 0 0 0 6 0V2M6 9v13M18 2c-2 0-3 2-3 5s1 5 3 5v10"></path></svg>
      <span class="tio-wb-num">4<i>/5</i></span>
      <span class="tio-wb-cap">appetite</span>
      <span class="tio-wb-bar"><i style="width: 70%"></i></span>
    </div>
    <div class="tio-wb-cell">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
        stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 1 1 9.5 3.5a7 7 0 0 0 11 11z"></path></svg>
      <span class="tio-wb-num">5<i>/5</i></span>
      <span class="tio-wb-cap">sleep</span>
      <span class="tio-wb-bar"><i style="width: 85%"></i></span>
    </div>
    </div>
  </div>
</div>

<style>
  .tio {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .tio-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .tio-date {
    font-size: 0.6rem;
    font-weight: 700;
    color: var(--ink-muted);
    letter-spacing: 0.01em;
  }
  .tio-dot {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--copper-soft);
    border: 1px solid var(--copper-edge);
    flex: none;
  }

  .tio-cap {
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0;
  }

  /* ---- journey chips ---- */
  .tio-journey {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
  }
  .tio-chip {
    position: relative;
    overflow: hidden;
    border-radius: var(--r-sm);
    padding: 7px 7px 8px;
    background: var(--cream-soft);
    border: 1px solid var(--border);
    min-width: 0;
  }
  .tio-chip-num {
    display: block;
    font-size: 0.8rem;
    font-weight: 800;
    line-height: 1;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .tio-chip-cap {
    display: block;
    font-size: 0.5rem;
    font-weight: 600;
    color: var(--ink-muted);
    margin-top: 3px;
  }
  .tio-chip-bar {
    position: absolute;
    inset: auto 0 0 0;
    height: 2.5px;
  }
  .tio-chip-bar.glu {
    background: var(--good-fg);
  }
  .tio-chip-bar.act {
    background: var(--emerald);
  }
  .tio-chip-bar.med {
    background: var(--indigo);
  }

  /* ---- summary tiles ---- */
  .tio-tiles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 7px;
  }
  .tio-tile {
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--paper);
    padding: 9px 10px 10px;
    min-width: 0;
  }
  .tio-tile.accent {
    background: var(--copper-soft);
    border-color: var(--copper-edge);
  }
  .tio-tile-val {
    font-size: 1rem;
    font-weight: 800;
    line-height: 1.1;
    color: var(--ink);
    margin: 4px 0 0;
    font-variant-numeric: tabular-nums;
  }
  .tio-tile-sub {
    font-size: 0.5rem;
    color: var(--ink-muted);
    margin: 3px 0 0;
  }

  /* ---- 30-day trend ---- */
  .tio-trend {
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--cream-soft);
    padding: 9px 10px 8px;
  }
  .tio-trend-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
  }
  .tio-trend-title {
    font-size: 0.6rem;
    font-weight: 800;
    color: var(--ink);
  }
  .tio-delta {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    font-size: 0.55rem;
    font-weight: 800;
    padding: 3px 6px;
    border-radius: 999px;
    background: var(--excellent-bg);
    color: var(--excellent-fg);
    flex: none;
    font-variant-numeric: tabular-nums;
  }
  .tio-spark {
    display: block;
    width: 100%;
    height: 52px;
    margin: 7px 0 5px;
    overflow: visible;
  }
  .tio-spark polyline {
    stroke: var(--accent);
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .tio-trend-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.5rem;
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }

  .tio-chip-unit {
    display: block;
    font-size: 0.5rem;
    font-weight: 600;
    color: var(--ink-muted);
    margin-top: 1px;
  }

  /* ---- well-being today ---- */
  .tio-wb {
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--paper);
    padding: 9px 10px 10px;
  }
  .tio-wb-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
    margin-top: 7px;
  }
  .tio-wb-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    min-width: 0;
  }
  .tio-wb-cell svg {
    width: 13px;
    height: 13px;
    color: var(--ink-soft);
  }
  .tio-wb-num {
    font-size: 0.6rem;
    font-weight: 800;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .tio-wb-num i {
    font-style: normal;
    font-weight: 600;
    font-size: 0.5rem;
    color: var(--ink-muted);
  }
  .tio-wb-cap {
    font-size: 0.5rem;
    color: var(--ink-muted);
  }
  .tio-wb-bar {
    display: block;
    width: 100%;
    height: 2.5px;
    border-radius: 999px;
    background: var(--border);
    overflow: hidden;
    margin-top: 2px;
  }
  .tio-wb-bar i {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: var(--copper);
  }
</style>
