---
// Workshop on the Lock Screen: the cut-list Live Activity you tick off at the
// saw, over the Shop Board widget. Board vocabulary throughout — graphite flap
// modules, a steel header band, tracked caps, one amber signal.
const parts = [
  { name: 'Leg', qty: '×4', done: true },
  { name: 'Apron, long', qty: '×2', done: true },
  { name: 'Apron, short', qty: '×2', done: true },
  { name: 'Top slat', qty: '×5', done: false },
  { name: 'Stretcher', qty: '×2', done: false },
];
---

<div class="ios ios-lock wkios">
  <div class="ios-lock-clock tight">
    <span class="ios-lock-date">Saturday, 14 June</span>
    <span class="ios-lock-time">10:12</span>
  </div>

  <div class="wk-acc">
    <span class="wk-acc-lamp" aria-hidden="true"></span>
    <span>Cut List</span>
    <span class="wk-acc-bar"><span></span></span>
    <span>04/11</span>
  </div>

  <div class="ios-la">
    <div class="ios-la-head">
      <span class="ios-la-app">
        <span class="ios-la-mark ws" aria-hidden="true"></span>
        Walnut Bench
      </span>
      <span class="ios-la-code">
        <span class="wk-flap">4</span>
        <span class="wk-of">of 11</span>
      </span>
    </div>
    <ul class="ios-cuts">
      {
        parts.map((p) => (
          <li class={p.done ? 'done' : ''}>
            <span class="ios-cut-box" aria-hidden="true">
              {p.done && (
                <svg
                  width="8"
                  height="8"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="4.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M20 6 9 17l-5-5" />
                </svg>
              )}
            </span>
            <span class="ios-cut-name">{p.name}</span>
            <span class="ios-cut-dim">{p.qty}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="ios-widget-row solo">
    <div class="ios-widget">
      <div class="wk-band">
        <span class="wk-band-lamp" aria-hidden="true"></span>
        <span>Shop Board</span>
        <span class="wk-band-trail">Tue 17:54</span>
      </div>
      <div class="wk-wgrid">
        <div class="wk-wcell">
          <span class="wk-flap amber">0</span><span class="wk-flap amber">2</span>
          <span class="wk-wcaps">Active</span>
        </div>
        <div class="wk-wcell">
          <span class="wk-flap">1</span><span class="wk-flap">8</span>
          <span class="wk-wcaps">Queued</span>
        </div>
        <div class="wk-wcell">
          <span class="wk-flap">0</span><span class="wk-flap">8</span><span class="wk-flap">5</span>
          <span class="wk-wcaps">Parts</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Board tokens, scoped to this mock so the shared .ios-* shells stay warm
     for the other apps that use them. */
  .wkios {
    --b-face: #2e363b;
    --b-face-lo: #232a2e;
    --b-letter: #f2f4f1;
    --b-amber: #ffb400;
    --b-ink: #14181a;
    --b-muted: #59686a;
    --b-line: #c0cac6;
    --b-flap: #f7f9f6;
    --b-board: 'Martian Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    --b-ui: Archivo, system-ui, -apple-system, 'Segoe UI', sans-serif;
  }

  /* ---- graphite flap module, severed by the split line ---- */
  .wkios .wk-flap {
    position: relative;
    display: inline-grid;
    place-items: center;
    min-width: 13px;
    height: 17px;
    padding: 0 1px;
    border-radius: 2px;
    background: linear-gradient(
      180deg,
      var(--b-face) 0 50%,
      var(--b-face-lo) 50% 100%
    );
    color: var(--b-letter);
    font-family: var(--b-board);
    font-size: 9.5px;
    font-weight: 700;
    font-stretch: 82%;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }
  .wkios .wk-flap::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background: rgba(10, 13, 14, 0.7);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.08);
  }
  .wkios .wk-flap.amber {
    color: var(--b-amber);
  }

  /* ---- Live Activity: cut-list checklist ---- */
  .wkios .ios-la {
    border-radius: 3px;
    background: rgba(221, 227, 224, 0.13);
    border: 1px solid rgba(237, 241, 238, 0.16);
  }
  .wkios .ios-la-app {
    font-family: var(--b-board);
    font-size: 0.56rem;
    font-weight: 700;
    font-stretch: 82%;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    opacity: 1;
  }
  .wkios .ios-la-mark {
    width: 11px;
    height: 11px;
    border-radius: 2px;
    background: linear-gradient(180deg, #47535b, #1a2025);
    box-shadow: inset 0 0 0 1px rgba(255, 180, 0, 0.55);
  }
  .wkios .ios-la-code {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 0;
    border-radius: 0;
    background: none;
    color: inherit;
  }
  .wkios .wk-of {
    font-family: var(--b-board);
    font-size: 0.5rem;
    font-weight: 600;
    font-stretch: 82%;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.72;
  }
  .wkios .ios-cuts li {
    font-family: var(--b-ui);
    font-size: 0.62rem;
  }
  .wkios .ios-cut-box {
    width: 12px;
    height: 12px;
    border-radius: 2px;
    border: 1.4px solid rgba(237, 241, 238, 0.38);
  }
  .wkios .ios-cuts li.done .ios-cut-box {
    background: var(--b-amber);
    border-color: var(--b-amber);
    color: var(--b-ink);
  }
  .wkios .ios-cuts li.done .ios-cut-name {
    opacity: 0.45;
  }
  .wkios .ios-cut-dim {
    font-family: var(--b-board);
    font-size: 0.55rem;
    font-weight: 600;
    font-stretch: 82%;
  }

  /* ---- Home Screen widget: the board bleeds to the edges ---- */
  .wkios .ios-widget {
    border-radius: 3px;
    padding: 0;
    overflow: hidden;
    background: var(--b-flap);
    border: 1px solid #1a2025;
    box-shadow: 0 6px 18px -8px rgba(0, 0, 0, 0.55);
    gap: 0;
  }
  .wkios .wk-band {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 9px;
    background:
      repeating-linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.04) 0 1px,
        transparent 1px 3px
      ),
      linear-gradient(180deg, #47535b 0, #2b3238 45%, #1a2025 100%);
    color: #edf1ee;
    font-family: var(--b-board);
    font-size: 0.5rem;
    font-weight: 600;
    font-stretch: 82%;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.14);
  }
  .wkios .wk-band-lamp {
    width: 5px;
    height: 5px;
    background: var(--b-amber);
    flex: none;
  }
  .wkios .wk-band-trail {
    margin-left: auto;
    color: var(--b-amber);
    font-size: 0.46rem;
    letter-spacing: 0.1em;
  }
  .wkios .wk-wgrid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    background: var(--b-line);
    gap: 1px;
  }
  .wkios .wk-wcell {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px;
    padding: 8px 9px 9px;
    background: var(--b-flap);
  }
  .wkios .wk-wcaps {
    flex-basis: 100%;
    margin-top: 4px;
    font-family: var(--b-board);
    font-size: 0.45rem;
    font-weight: 600;
    font-stretch: 82%;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--b-muted);
  }

  /* ---- accessory row: the Lock Screen / StandBy widget ---- */
  .wkios .wk-acc {
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 0 0 12px;
    padding: 6px 8px;
    border-radius: 3px;
    border: 1px solid rgba(237, 241, 238, 0.16);
    background: rgba(221, 227, 224, 0.09);
    font-family: var(--b-board);
    font-size: 0.5rem;
    font-weight: 600;
    font-stretch: 82%;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(239, 242, 237, 0.82);
  }
  .wkios .wk-acc-bar {
    flex: 1;
    height: 3px;
    background: rgba(237, 241, 238, 0.18);
  }
  .wkios .wk-acc-bar span {
    display: block;
    width: 36%;
    height: 100%;
    background: var(--b-amber);
  }
  .wkios .wk-acc-lamp {
    width: 5px;
    height: 5px;
    flex: none;
    background: var(--b-amber);
  }

  /* The board hangs at the bottom of the screen, where the hand reaches. */
  .wkios .ios-widget-row {
    margin-top: auto;
  }

  /* ---- the device itself ----
     PhoneMock's shell is walnut and copper for Cairn. Wherever this mock is
     mounted, the hardware becomes steel and the wallpaper becomes night. */
  :global(.phone-wrap:has(.wkios)) :global(.phone-ambient) {
    background: radial-gradient(
      circle at 55% 38%,
      rgba(255, 180, 0, 0.16),
      transparent 68%
    );
  }
  :global(.phone:has(.wkios)) {
    background: linear-gradient(150deg, #566269, #1a2025 45%, #39434a);
  }
  :global(.phone:has(.wkios)) :global(.phone-screen) {
    background:
      radial-gradient(120% 60% at 50% 0%, #1f262a 0%, transparent 60%),
      linear-gradient(175deg, #171b1d, #0c0f10 62%, #101415);
    color: #eff2ed;
  }
  :global(.phone:has(.wkios)) :global(.phone-island) {
    background: #060809;
  }
</style>
