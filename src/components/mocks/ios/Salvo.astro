---
import home from '../../../assets/salvo/home.webp';
---

<img
  class="salvo-capture"
  src={home.src}
  alt="Current Salvo pre-release title screen on iPad"
  width={home.width}
  height={home.height}
  loading="lazy"
/>

<style>
  .salvo-capture {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
