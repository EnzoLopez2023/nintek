---
// ShopKeep on iPhone: the VisionKit scanner viewfinder mid-recognition.
---

<div class="ios ios-scan">
  <div class="ios-scan-frame">
    <span class="ios-scan-corner tl"></span>
    <span class="ios-scan-corner tr"></span>
    <span class="ios-scan-corner bl"></span>
    <span class="ios-scan-corner br"></span>
    <span class="ios-scan-line"></span>
    <div class="ios-barcode" aria-hidden="true">
      <i style="--w: 3px"></i><i style="--w: 1px"></i><i style="--w: 2px"></i>
      <i style="--w: 1px"></i><i style="--w: 4px"></i><i style="--w: 1px"></i>
      <i style="--w: 2px"></i><i style="--w: 3px"></i><i style="--w: 1px"></i>
      <i style="--w: 1px"></i><i style="--w: 3px"></i><i style="--w: 2px"></i>
      <i style="--w: 1px"></i><i style="--w: 4px"></i><i style="--w: 2px"></i>
      <i style="--w: 1px"></i><i style="--w: 2px"></i><i style="--w: 3px"></i>
    </div>
    <span class="ios-scan-hint">EAN-13 · 885911678322</span>
  </div>

  <div class="ios-sheet">
    <span class="ios-sheet-grab"></span>
    <div class="ios-sheet-row">
      <span class="ios-sheet-thumb" aria-hidden="true">
        <svg
          width="17"
          height="17"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M15 12l-8.5 8.5a2.1 2.1 0 1 1-3-3L12 9"></path>
          <path d="M17.6 15 22 10.6"></path>
        </svg>
      </span>
      <div class="ios-sheet-text">
        <p class="ios-sheet-name">DeWalt DCD791 Drill/Driver</p>
        <p class="ios-sheet-sub">Power tools · Excellent</p>
      </div>
      <span class="ios-sheet-check" aria-hidden="true">
        <svg
          width="13"
          height="13"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="3.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M20 6 9 17l-5-5"></path>
        </svg>
      </span>
    </div>
    <div class="ios-sheet-loc">
      <span class="ios-sheet-pin" aria-hidden="true">
        <svg
          width="11"
          height="11"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"></path>
          <circle cx="12" cy="10" r="2.6"></circle>
        </svg>
      </span>
      Filed to <b>Rolling cabinet · Drawer B3</b>
    </div>
  </div>
</div>
