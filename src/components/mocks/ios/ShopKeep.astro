---
// ShopKeep on iPhone: the Tool Library dashboard (LIB.01) as it ships today.
// The app is built as a machine control panel — a pale enamel cabinet with one
// inset graphite readout per screen, hairline rules and square-cut corners.
// Colour is rationed: it only ever reports a machine state.
//
// Every number here matches the shipping fixture set. Figures are monospaced
// with tabular figures and plain counts are zero-padded, because in this world
// a count is a measurement.

const alarms = [
  { label: 'Overdue checkout', count: '01', state: 'missing' },
  { label: 'Maintenance overdue', count: '01', state: 'repair' },
  { label: 'Maintenance due soon', count: '02', state: 'service' },
  { label: 'Warranty expired', count: '01', state: 'repair' },
  { label: 'Warranty expiring', count: '01', state: 'service' },
  { label: 'Low stock', count: '01', state: 'service' },
] as const;

const offsets = [
  { code: 'G54', name: 'Power Tools', count: '034' },
  { code: 'G55', name: 'Hand Tools', count: '028' },
  { code: 'G56', name: 'Measuring', count: '019' },
  { code: 'G57', name: 'Workholding', count: '016' },
] as const;
---

<div class="ios skio">
  {/* ── Nameplate ── */}
  <div class="skio-plate">
    <p class="skio-title">Shop status</p>
    <p class="skio-sub">134 tools on the register across 9 categories.</p>
    <div class="skio-rule">
      <span class="skio-rule-index" aria-hidden="true"></span>
      <span class="skio-rule-line" aria-hidden="true"></span>
      <span class="skio-desig">LIB.01</span>
    </div>
  </div>

  {/* ── The readout. One per screen, sunk into the enamel. ── */}
  <div class="skio-dro">
    <div class="skio-cell">
      <span class="skio-cell-label">Tools in library</span>
      <span class="skio-cell-fig">134</span>
      <span class="skio-cell-cap">9 categories</span>
    </div>
    <div class="skio-cell">
      <span class="skio-cell-label">Checked out</span>
      <span class="skio-cell-fig issued">003</span>
      <span class="skio-cell-cap">3 signed out</span>
    </div>
    <div class="skio-cell">
      <span class="skio-cell-label">In service</span>
      <span class="skio-cell-fig service">007</span>
      <span class="skio-cell-cap">repair or maintenance</span>
    </div>
    <div class="skio-cell">
      <span class="skio-cell-label">Library value</span>
      <span class="skio-cell-fig rest">$48,621</span>
      <span class="skio-cell-cap">USD · insured basis</span>
    </div>
  </div>

  {/* ── Alarms: what the shop cannot account for ── */}
  <div class="skio-panel">
    <div class="skio-panel-head">
      <span class="skio-panel-title">Alarms</span>
      <span class="skio-panel-meta">07 Active</span>
    </div>
    {
      alarms.map((a) => (
        <div class="skio-row">
          <span class={`skio-swatch ${a.state}`} aria-hidden="true" />
          <span class="skio-row-label">{a.label}</span>
          <span class={`skio-row-count ${a.state}`}>{a.count}</span>
        </div>
      ))
    }
  </div>

  {/* ── Work offsets: the categories, addressed like fixture offsets ── */}
  <div class="skio-panel">
    <div class="skio-panel-head">
      <span class="skio-panel-title">Work offsets</span>
      <span class="skio-panel-meta">09 Pockets</span>
    </div>
    {
      offsets.map((o) => (
        <div class="skio-row">
          <span class="skio-row-code">{o.code}</span>
          <span class="skio-row-label">{o.name}</span>
          <span class="skio-row-count">{o.count}</span>
        </div>
      ))
    }
  </div>
</div>

<style>
  /* ---- library palette, light ----
     Lifted verbatim from the shipping app's `library` skin. */
  .skio {
    --sk-cream: #dce6e0;
    --sk-cream-soft: #ebf2ee;
    --sk-paper: #fafdfb;
    --sk-ink: #101a17;
    --sk-ink-soft: #3a4742;
    --sk-subtle: #5c6c66;
    --sk-line: #c6d3cd;
    --sk-line-strong: #9baea7;
    --sk-accent: #0a6fa6;

    /* The readout is dark in both appearances — it is a lit screen. */
    --sk-dro-bg: #101a17;
    --sk-dro-ink: #e8f2ee;
    --sk-dro-muted: #8ca39b;
    --sk-dro-rule: #2a3733;

    /* Machine state — the move a tool is making. */
    --sk-rest: #00764a;
    --sk-issued: #0a6fa6;
    --sk-service: #9a6300;
    --sk-missing: #bc005c;
    --sk-repair: #ac4409;

    /* Brightened for use on the graphite readout. */
    --sk-rest-lit: #3ed494;
    --sk-issued-lit: #4fbaf0;
    --sk-service-lit: #ffb833;

    --sk-num: 'Martian Mono', ui-monospace, SFMono-Regular, 'SF Mono', Menlo,
      monospace;

    /* Panels seat on the cabinet: flush face, hairline, contact shadow. */
    --sk-seat: 0 1px 2px rgba(16, 26, 23, 0.1);

    gap: 0.72em;
    color: var(--sk-ink);
    overflow: hidden;
  }

  /* ---- nameplate ---- */
  .skio-plate {
    flex: none;
  }
  .skio-title {
    font-size: 1.62em;
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--sk-ink);
  }
  .skio-sub {
    font-size: 0.92em;
    line-height: 1.3;
    color: var(--sk-subtle);
    margin-top: 0.3em;
  }
  .skio-rule {
    display: flex;
    align-items: center;
    gap: 0.5em;
    margin-top: 0.62em;
  }
  .skio-rule-index {
    width: 22px;
    height: 2px;
    flex: none;
    background: var(--sk-accent);
  }
  .skio-rule-line {
    flex: 1;
    height: 1px;
    background: var(--sk-line);
  }
  .skio-desig {
    font-family: var(--sk-num);
    font-size: 0.82em;
    font-weight: 600;
    letter-spacing: 0.4px;
    color: var(--sk-subtle);
    font-variant-numeric: tabular-nums;
    flex: none;
  }

  /* ---- the readout ---- */
  .skio-dro {
    flex: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    /* The 1px hairlines between cells are the rule showing through the gap —
       the band is one instrument, not four cards floated apart. */
    background: var(--sk-dro-rule);
    border-radius: 3px;
    gap: 1px;
    overflow: hidden;
  }
  .skio-cell {
    background: var(--sk-dro-bg);
    padding: 0.62em 0.68em 0.68em;
    min-width: 0;
  }
  .skio-cell-label {
    display: block;
    font-size: 0.72em;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    line-height: 1.25;
    color: var(--sk-dro-muted);
    /* Two lines are always reserved so the figures stay on one baseline. */
    min-height: 2.5em;
  }
  .skio-cell-fig {
    display: block;
    font-family: var(--sk-num);
    font-size: 1.34em;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--sk-dro-ink);
    font-variant-numeric: tabular-nums;
  }
  .skio-cell-fig.issued {
    color: var(--sk-issued-lit);
  }
  .skio-cell-fig.service {
    color: var(--sk-service-lit);
  }
  .skio-cell-fig.rest {
    color: var(--sk-rest-lit);
  }
  .skio-cell-cap {
    display: block;
    font-size: 0.72em;
    line-height: 1.3;
    color: var(--sk-dro-muted);
    margin-top: 0.3em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ---- seated panels ---- */
  .skio-panel {
    flex: none;
    background: var(--sk-paper);
    border: 1px solid var(--sk-line);
    border-radius: 3px;
    box-shadow: var(--sk-seat);
    overflow: hidden;
  }
  .skio-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6em;
    padding: 0.46em 0.68em;
    background: var(--sk-cream-soft);
    border-bottom: 1px solid var(--sk-line);
  }
  .skio-panel-title {
    font-size: 0.78em;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1.3px;
    color: var(--sk-ink-soft);
  }
  .skio-panel-meta {
    font-family: var(--sk-num);
    font-size: 0.72em;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    color: var(--sk-subtle);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .skio-row {
    display: flex;
    align-items: center;
    gap: 0.55em;
    padding: 0.46em 0.68em;
  }
  .skio-row + .skio-row {
    border-top: 1px solid var(--sk-line);
  }
  /* State is a square. Never a dot. */
  .skio-swatch {
    width: 8px;
    height: 8px;
    flex: none;
  }
  .skio-swatch.missing {
    background: var(--sk-missing);
  }
  .skio-swatch.repair {
    background: var(--sk-repair);
  }
  .skio-swatch.service {
    background: var(--sk-service);
  }
  .skio-row-code {
    font-family: var(--sk-num);
    font-size: 0.74em;
    font-weight: 600;
    letter-spacing: 0.3px;
    color: var(--sk-subtle);
    flex: none;
  }
  .skio-row-label {
    flex: 1;
    min-width: 0;
    font-size: 0.94em;
    color: var(--sk-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .skio-row-count {
    font-family: var(--sk-num);
    font-size: 0.86em;
    font-weight: 600;
    color: var(--sk-subtle);
    font-variant-numeric: tabular-nums;
    flex: none;
  }
  .skio-row-count.missing {
    color: var(--sk-missing);
  }
  .skio-row-count.repair {
    color: var(--sk-repair);
  }
  .skio-row-count.service {
    color: var(--sk-service);
  }

  /* ---- the device itself ----
     PhoneMock's light screen is warm cream for Tare. Wherever this mock is
     mounted the screen becomes cabinet enamel, so the readout has something
     to sit in. The ambient glow behind the phone is switched off: a machine
     control panel does not radiate, and this world allows no blur. */
  :global(.phone-wrap:has(.skio)) :global(.phone-ambient) {
    display: none;
  }
  :global(.phone:has(.skio)) {
    background: #2c3934;
  }
  :global(.phone.light:has(.skio)) :global(.phone-screen) {
    background: #dce6e0;
    color: #101a17;
  }
  :global(.phone:has(.skio)) :global(.phone-island) {
    background: #070c0a;
  }
</style>
