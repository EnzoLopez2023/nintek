---
// Cairn on the Lock Screen: a timed exam Live Activity plus the streak widget.
---

<div class="ios ios-lock">
  <div class="ios-lock-clock">
    <span class="ios-lock-date">Thursday, 12 June</span>
    <span class="ios-lock-time">9:41</span>
  </div>

  <div class="ios-la">
    <div class="ios-la-head">
      <span class="ios-la-app">
        <span class="ios-la-mark" aria-hidden="true"></span>
        Cairn
      </span>
      <span class="ios-la-code">AZ-104</span>
    </div>
    <div class="ios-la-main">
      <div>
        <p class="ios-la-label">Exam sandbox</p>
        <p class="ios-la-sub">Question 34 of 60</p>
      </div>
      <span class="ios-la-timer">42:18</span>
    </div>
    <div class="ios-la-bar"><span style="width: 57%"></span></div>
  </div>

  <div class="ios-widget-row">
    <div class="ios-widget">
      <span class="ios-widget-flame" aria-hidden="true">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2c1 3 4 4.5 4 8a4 4 0 0 1-8 0c0-1 .3-1.8 1-2.5C8 9 9 5 12 2z"
          ></path>
        </svg>
      </span>
      <span class="ios-widget-num">18</span>
      <span class="ios-widget-cap">days streak</span>
    </div>
    <div class="ios-widget">
      <span class="ios-widget-cap">Cards due today</span>
      <span class="ios-widget-num sm">24</span>
      <span class="ios-widget-foot">Best score · 86%</span>
    </div>
  </div>
</div>
