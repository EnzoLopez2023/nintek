---
const games = [
  { ab: '#',  name: 'Sudoku',        desc: 'Fill the grid. Six difficulties.', color: '#3b82f6', dark: '#1d4ed8' },
  { ab: 'Σ',  name: 'Number Sums',   desc: 'Circle numbers to hit each total.',  color: '#22c55e', dark: '#15803d' },
  { ab: '⊙',  name: 'Word Search',   desc: 'Themed grids. Drag to find words.',  color: '#f59e0b', dark: '#b45309' },
  { ab: 'S',  name: 'Scrabble',      desc: 'Full 15×15 board. vs computer.',     color: '#eab308', dark: '#a16207' },
  { ab: 'W',  name: 'Word Rush',     desc: 'Guess the word against the clock.',  color: '#8b5cf6', dark: '#6d28d9' },
  { ab: '◉',  name: 'Lights Out',    desc: 'Flip cells. Clear the board.',       color: '#f59e0b', dark: '#b45309', beta: true },
  { ab: '⛨',  name: 'Tower Defense', desc: 'Build turrets. Survive the waves.',  color: '#ef4444', dark: '#b91c1c', beta: true },
  { ab: '⊞',  name: 'City War',      desc: 'Capture every tower. 100 maps.',    color: '#6366f1', dark: '#4338ca' },
];
---

<div class="pz">
  <div class="pz-grid">
    {games.map((g) => (
      <div class="pz-tile" style={`background:linear-gradient(145deg,${g.color},${g.dark})`}>
        <div class="pz-ab">{g.ab}</div>
        <div class="pz-name">
          {g.name}
          {g.beta && <span class="pz-beta">BETA</span>}
        </div>
        <div class="pz-desc">{g.desc}</div>
      </div>
    ))}
  </div>
</div>

<style>
  /* bleed dark bg to mockup edges */
  .pz {
    margin: 0 -22px -22px;
    border-radius: 0 0 20px 20px;
    background: #0f172a;
    padding: 12px 16px 16px;
  }

  .pz-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 7px; }
  .pz-tile {
    border-radius: 10px; padding: 10px 9px;
    display: flex; flex-direction: column; gap: 3px;
    min-height: 80px;
  }
  .pz-ab   { font-size: 18px; font-weight: 800; color: rgba(255,255,255,0.92); line-height: 1; }
  .pz-name {
    font-size: 10px; font-weight: 700; color: #fff; margin-top: 2px;
    display: flex; align-items: center; gap: 4px; flex-wrap: wrap;
  }
  .pz-beta {
    font-size: 8px; font-weight: 700; letter-spacing: 0.06em;
    background: rgba(255,255,255,0.25); color: #fff;
    padding: 1px 4px; border-radius: 3px;
  }
  .pz-desc { font-size: 9.5px; color: rgba(255,255,255,0.65); line-height: 1.3; margin-top: 2px; }
</style>
