---
// Tare on Apple Watch — the wrist's version of the phone's Today screen, in the
// same order and the same colours. Rebuilt against the watchOS simulator in
// Aug 2026.
//
// Every hex is from `TareWatchShared/WatchTheme.swift`, which carries only the
// dark half of each pair on purpose: watchOS has one appearance, so the light
// values would be dead weight that quietly rots.

interface Props {
  /** `home` shows the three reading cards; `log` shows the Quick Log menu. */
  view?: 'home' | 'log';
}
const { view = 'home' } = Astro.props;

const spark = (data: number[], h = 22) => {
  const min = Math.min(...data);
  const max = Math.max(...data);
  return data
    .map((v, i) => {
      const x = (i / (data.length - 1)) * 100;
      const y = h - 2 - ((v - min) / (max - min || 1)) * (h - 5);
      return `${x.toFixed(1)},${y.toFixed(1)}`;
    })
    .join(' ');
};

const glucoseSpark = spark([
  126, 124, 121, 119, 120, 117, 115, 118, 114, 116, 113, 115, 118, 120, 116, 112,
  110, 113, 109, 111, 108, 110, 107, 109, 106, 108, 105, 107, 104, 102,
]);
const weightSpark = spark([
  250.8, 250.1, 249.4, 249.6, 248.7, 248.2, 248.5, 247.6, 247.1, 247.4, 246.6,
  246.1, 246.4, 245.6, 245.1, 245.4, 244.7, 244.2, 244.5, 243.8, 243.3, 242.9,
  242.4, 242.1,
]);

/* The four things the crown can enter, from `WatchQuickLogMenu`. */
const logKinds = [
  { label: 'Glucose', tint: 'glu' },
  { label: 'Weight', tint: 'wgt' },
  { label: 'Dose', tint: 'med' },
  { label: 'Mood', tint: 'act' },
];
---

<div class="tw">
  <div class="tw-status">
    <span class="tw-title">Tare</span>
    <span class="tw-time">9:41</span>
  </div>

  {
    view === 'home' ? (
      <div class="tw-scroll">
        <div class="tw-card med">
          <p class="tw-cap">Next dose</p>
          <p class="tw-val">Sun</p>
          <p class="tw-sub">8:30am · 7.5 mg</p>
        </div>

        <div class="tw-card glu">
          <p class="tw-cap">Glucose</p>
          <p class="tw-val">
            102<i>mg/dL</i>
            <span class="tw-band">
              <em />Normal
            </span>
          </p>
          <svg class="tw-spark" viewBox="0 0 100 22" preserveAspectRatio="none" aria-hidden="true">
            <polyline
              points={glucoseSpark}
              fill="none"
              stroke="#6DBFD4"
              stroke-width="1.6"
              stroke-linejoin="round"
              stroke-linecap="round"
              vector-effect="non-scaling-stroke"
            />
          </svg>
          <p class="tw-sub">30-day avg 116</p>
        </div>

        <div class="tw-card wgt">
          <p class="tw-cap">Weight</p>
          <p class="tw-val">242.1<i>lbs</i></p>
          <svg class="tw-spark" viewBox="0 0 100 22" preserveAspectRatio="none" aria-hidden="true">
            <polyline
              points={weightSpark}
              fill="none"
              stroke="#83A4E0"
              stroke-width="1.6"
              stroke-linejoin="round"
              stroke-linecap="round"
              vector-effect="non-scaling-stroke"
            />
          </svg>
          <p class="tw-sub">−8.7 lbs / 30d</p>
        </div>

        <div class="tw-action">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm1 11v4h-2v-4H7v-2h4V7h2v4h4v2Z" />
          </svg>
          Quick Log
        </div>
      </div>
    ) : (
      <div class="tw-scroll">
        <p class="tw-menu-cap">Quick Log</p>
        {logKinds.map((k) => (
          <div class={`tw-row ${k.tint}`}>
            <span>{k.label}</span>
            <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m9 18 6-6-6-6" />
            </svg>
          </div>
        ))}
        <p class="tw-pending">2 entries waiting for iPhone</p>
      </div>
    )
  }
</div>

<style>
  .tw {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 7% 6% 0;
    /* `WatchTheme.well` — the page behind the tiles. */
    background: radial-gradient(120% 80% at 50% 0%, #1b252b, #141c21 70%);
    font-family: 'Archivo', system-ui, sans-serif;
    color: #e4edf1;
    overflow: hidden;
  }

  .tw-status {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 5px;
  }
  .tw-title {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.01em;
    font-variation-settings: 'wdth' 112;
    color: #5e6e79;
  }
  .tw-time {
    font-size: 12px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: #fff;
  }

  .tw-scroll {
    display: flex;
    flex-direction: column;
    gap: 5px;
    overflow: hidden;
  }

  /* ── Cards ── */
  .tw-card {
    padding: 6px 8px 7px;
    border-radius: 10px;
    border: 1px solid transparent;
  }
  .tw-card.med {
    background: #403962;
    border-color: #574c9a;
  }
  .tw-card.glu {
    background: #0a4a5b;
    border-color: #116e86;
  }
  .tw-card.wgt {
    background: #28405d;
    border-color: #245282;
  }

  .tw-cap {
    margin: 0;
    font-size: 7px;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    font-variation-settings: 'wdth' 88;
  }
  .tw-card.med .tw-cap {
    color: #a692e7;
  }
  .tw-card.glu .tw-cap {
    color: #6dbfd4;
  }
  .tw-card.wgt .tw-cap {
    color: #83a4e0;
  }

  .tw-val {
    display: flex;
    align-items: baseline;
    gap: 3px;
    margin: 1px 0 0;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.02em;
    font-variation-settings: 'wdth' 116;
    line-height: 1.05;
    font-variant-numeric: tabular-nums;
  }
  .tw-card.med .tw-val {
    color: #ddd6f5;
  }
  .tw-card.glu .tw-val {
    color: #c7e6ee;
  }
  .tw-card.wgt .tw-val {
    color: #cedbf2;
  }
  .tw-val i {
    font-size: 7.5px;
    font-weight: 500;
    font-style: normal;
    color: #9caeb9;
  }

  /* Never colour alone — the band is named beside its dot, which is what keeps
     it readable when a watch face flattens to monochrome. */
  .tw-band {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    margin-left: auto;
    font-size: 7.5px;
    font-weight: 500;
    color: #9caeb9;
    letter-spacing: 0;
  }
  .tw-band em {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #89c04c;
  }

  .tw-spark {
    display: block;
    width: 100%;
    height: 15px;
    margin: 2px 0 1px;
  }

  .tw-sub {
    margin: 1px 0 0;
    font-size: 7.5px;
    font-weight: 500;
    color: #9caeb9;
  }

  /* borderedProminent, tinted `WatchTheme.meds.edge`. */
  .tw-action {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    margin-top: 1px;
    padding: 6px;
    border-radius: 9px;
    background: #574c9a;
    font-size: 9px;
    font-weight: 600;
    color: #fff;
  }

  /* ── Quick Log menu ── */
  .tw-menu-cap {
    margin: 0 0 2px;
    font-size: 7px;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    font-variation-settings: 'wdth' 88;
    color: #9caeb9;
  }
  .tw-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 9px;
    border-radius: 10px;
    background: #1a242a;
    border: 1px solid #2a3841;
    font-size: 11px;
    font-weight: 600;
  }
  .tw-row.glu {
    color: #6dbfd4;
    border-color: #116e86;
  }
  .tw-row.wgt {
    color: #83a4e0;
    border-color: #245282;
  }
  .tw-row.med {
    color: #a692e7;
    border-color: #574c9a;
  }
  .tw-row.act {
    color: #9fc66f;
    border-color: #4c6e20;
  }
  .tw-pending {
    margin: 3px 0 0;
    text-align: center;
    font-size: 7.5px;
    font-weight: 500;
    color: #9caeb9;
  }
</style>
