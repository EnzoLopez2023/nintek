---
const pts = '0,16 36,22 72,15 108,30 144,26 180,40 216,38 252,50 288,48';
const area = `0,70 ${pts} 288,70`;
const tiles = [
  { label: 'Next dose', value: '2 days' },
  { label: 'Streak', value: '31 days' },
  { label: 'Protein', value: '112 g' },
];
---

<div class="th">
  <div class="th-top">
    <div>
      <div class="th-big">184.2 <span>lb</span></div>
      <div class="th-trend"><span class="th-arrow">▼</span> 12.4 lb this month</div>
    </div>
    <div class="th-glu">
      <div class="th-glu-num">98</div>
      <div class="th-glu-cap">fasting glucose</div>
    </div>
  </div>

  <div class="th-chart">
    <svg viewBox="0 0 288 70" preserveAspectRatio="none" width="100%" height="70">
      <polygon points={area} class="th-area" />
      <polyline points={pts} class="th-line" />
    </svg>
    <div class="th-axis"><span>Jun 1</span><span>Today</span></div>
  </div>

  <div class="th-tiles">
    {tiles.map((t) => (
      <div class="th-tile">
        <div class="th-tile-v">{t.value}</div>
        <div class="th-tile-l">{t.label}</div>
      </div>
    ))}
  </div>
</div>

<style>
  .th { display: flex; flex-direction: column; gap: 16px; }
  .th-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
  .th-big { font-size: 30px; font-weight: 800; letter-spacing: -0.02em; color: var(--ink); line-height: 1; }
  .th-big span { font-size: 14px; font-weight: 600; color: var(--ink-muted); }
  .th-trend { margin-top: 6px; font-size: 12.5px; font-weight: 600; color: #1f9d6b; }
  .th-arrow { font-size: 10px; }
  .th-glu { text-align: right; }
  .th-glu-num {
    font-size: 22px; font-weight: 800; color: var(--accent-deep);
  }
  .th-glu-cap { font-size: 10.5px; color: var(--ink-muted); margin-top: 2px; }
  .th-chart {
    border-radius: var(--r-md); background: var(--copper-soft);
    border: 1px solid var(--copper-edge); padding: 10px 12px 8px;
  }
  .th-area { fill: rgba(193, 122, 46, 0.14); }
  .th-line { fill: none; stroke: var(--copper); stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
  .th-axis { display: flex; justify-content: space-between; font-size: 10.5px; color: var(--ink-muted); margin-top: 4px; }
  .th-tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .th-tile { border: 1px solid var(--border); border-radius: var(--r-md); padding: 10px; background: var(--cream-soft); }
  .th-tile-v { font-size: 15px; font-weight: 700; color: var(--ink); }
  .th-tile-l { font-size: 11px; color: var(--ink-muted); margin-top: 2px; }
</style>
