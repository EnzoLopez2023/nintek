---
const days = [
  { val: '312', unit: 'days', label: 'Dx',        bg: '#fce7f3', fg: '#9d174d', bar: '#f472b6' },
  { val: '96',  unit: 'days', label: 'Keto',      bg: '#dcfce7', fg: '#166534', bar: '#4ade80' },
  { val: '58',  unit: 'days', label: 'Mounjaro',  bg: '#ede9fe', fg: '#5b21b6', bar: '#a78bfa' },
];

const metrics = [
  { section: 'NEXT DOSE',   value: 'Sun 8:30', sub: 'Mounjaro · 7.5 mg',    icon: '💉' },
  { section: 'WEIGHT',      value: '248.4',    sub: 'lb · −1.6 this month', icon: '⚖' },
  { section: 'GLUCOSE',     value: '108',      sub: 'mg/dL · fasting',       icon: '💧' },
  { section: 'WELL-BEING',  value: '7',        sub: 'mood · energy 6',       icon: '〜' },
];
---

<div class="tr">
  <div class="tr-days">
    {days.map((d) => (
      <div class="tr-day" style={`background:${d.bg};`}>
        <div class="tr-day-val" style={`color:${d.fg}`}>{d.val}</div>
        <div class="tr-day-unit" style={`color:${d.fg}`}>{d.unit}</div>
        <div class="tr-day-label" style={`color:${d.fg}`}>{d.label}</div>
        <div class="tr-day-bar" style={`background:${d.bar}`}></div>
      </div>
    ))}
  </div>

  <div class="tr-grid">
    {metrics.map((m) => (
      <div class="tr-metric">
        <div class="tr-metric-l">{m.section}</div>
        <div class="tr-metric-v">{m.value}</div>
        <div class="tr-metric-sub">{m.sub}</div>
      </div>
    ))}
  </div>
</div>

<style>
  .tr { display: flex; flex-direction: column; gap: 12px; }

  .tr-days { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .tr-day {
    border-radius: var(--r-md); padding: 10px 11px 8px;
    position: relative; overflow: hidden;
  }
  .tr-day-val  { font-size: 20px; font-weight: 800; line-height: 1; }
  .tr-day-unit { font-size: 10px; font-weight: 600; margin-top: 1px; opacity: 0.7; }
  .tr-day-label{ font-size: 11px; font-weight: 700; margin-top: 4px; }
  .tr-day-bar  { position: absolute; bottom: 0; left: 0; right: 0; height: 3px; opacity: 0.5; }

  .tr-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .tr-metric {
    border: 1px solid var(--border); border-radius: var(--r-md);
    padding: 10px 12px; background: var(--cream-soft);
  }
  .tr-metric-l {
    font-size: 9px; font-weight: 700; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--ink-muted); margin-bottom: 3px;
  }
  .tr-metric-v   { font-size: 17px; font-weight: 800; color: var(--ink); line-height: 1.1; }
  .tr-metric-sub { font-size: 10.5px; color: var(--ink-muted); margin-top: 2px; }
</style>
