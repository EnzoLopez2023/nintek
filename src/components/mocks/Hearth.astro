---
const stats = [
  { label: 'Next Task', value: 'Furnace filter', sub: 'due in 12 days' },
  { label: 'Lawn',      value: '6 days',         sub: 'since last mow' },
  { label: 'Recipes',   value: '127',             sub: '3 new this week' },
];

const tiles = [
  {
    name: 'Recipe Manager', sub: 'Your recipe collection',
    svg: '<path d="M4 4h12a4 4 0 0 1 0 8h-2v8H8a4 4 0 0 1-4-4V4z"/><line x1="8" y1="8" x2="12" y2="8"/><line x1="8" y1="12" x2="12" y2="12"/><line x1="8" y1="16" x2="11" y2="16"/>',
  },
  {
    name: 'Home Maintenance', sub: 'Tasks & warranties',
    svg: '<path d="M3 21l3-3 7-7-3-3-7 7-3 3z"/><path d="M14 5l5 5"/><path d="M17 2l5 5-4 4-5-5z"/>',
  },
  {
    name: 'Yard Maintenance', sub: 'Lawn calendar & care',
    svg: '<path d="M5 21h14"/><path d="M7 21V11l5-7 5 7v10"/><path d="M10 21v-5h4v5"/>',
  },
  {
    name: 'Media Library', sub: 'Plex movie insights',
    svg: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M10 9l5 3-5 3V9z" fill="currentColor" stroke="none"/>',
  },
];
---

<div class="ht">
  <div class="ht-section">AT A GLANCE</div>
  <div class="ht-stats">
    {stats.map((s) => (
      <div class="ht-stat">
        <div class="ht-stat-l">{s.label}</div>
        <div class="ht-stat-v">{s.value}</div>
        <div class="ht-stat-sub">{s.sub}</div>
      </div>
    ))}
  </div>

  <div class="ht-divider"></div>

  <div class="ht-section">QUICK ACCESS</div>
  <div class="ht-tiles">
    {tiles.map((t) => (
      <div class="ht-tile">
        <div class="ht-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
               set:html={t.svg} />
        </div>
        <div class="ht-tile-name">{t.name}</div>
        <div class="ht-tile-sub">{t.sub}</div>
      </div>
    ))}
  </div>
</div>

<style>
  .ht { display: flex; flex-direction: column; gap: 10px; }

  .ht-section {
    font-size: 9.5px; font-weight: 700; letter-spacing: 0.09em;
    text-transform: uppercase; color: var(--ink-muted);
  }

  .ht-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .ht-stat {
    border: 1px solid var(--border); border-radius: var(--r-md);
    padding: 10px 11px; background: var(--cream-soft);
  }
  .ht-stat-l {
    font-size: 9.5px; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.05em; color: var(--ink-muted); margin-bottom: 3px;
  }
  .ht-stat-v { font-size: 15px; font-weight: 700; color: var(--ink); line-height: 1.2; }
  .ht-stat-sub { font-size: 10.5px; color: #5C2A4A; margin-top: 2px; font-weight: 500; }

  .ht-divider { height: 1px; background: var(--border); margin: 2px 0; }

  .ht-tiles { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .ht-tile {
    border: 1px solid var(--border); border-radius: var(--r-md);
    padding: 11px 12px; background: var(--cream-soft);
  }
  .ht-icon {
    width: 22px; height: 22px; color: #5C2A4A; margin-bottom: 6px;
  }
  .ht-icon svg { width: 100%; height: 100%; }
  .ht-tile-name { font-size: 12px; font-weight: 700; color: var(--ink); }
  .ht-tile-sub  { font-size: 10.5px; color: var(--ink-muted); margin-top: 2px; }
</style>
