---
const tasks = [
  { who: 'Maya', text: 'Take out recycling', done: true },
  { who: 'Sam', text: 'Water the garden', done: true },
  { who: 'Dad', text: 'Pick up groceries', done: false },
];
const meals = [
  { day: 'Fri', meal: 'Sheet-pan salmon' },
  { day: 'Sat', meal: 'Sourdough & soup' },
  { day: 'Sun', meal: 'Roast chicken' },
];
---

<div class="ht">
  <div class="ht-recipe">
    <div class="ht-thumb"><span>🍲</span></div>
    <div class="ht-recipe-main">
      <div class="ht-recipe-name">Sourdough & roasted tomato soup</div>
      <div class="ht-recipe-sub">Dinner · Saturday · serves 4</div>
    </div>
    <span class="ht-tag">Meal plan</span>
  </div>

  <div class="ht-cols">
    <div class="ht-tasks">
      <div class="ht-label">Shared chores</div>
      {tasks.map((t) => (
        <div class="ht-task">
          <span class={`ht-box ${t.done ? 'on' : ''}`}>{t.done && '✓'}</span>
          <span class={`ht-task-t ${t.done ? 'done' : ''}`}>{t.text}</span>
          <span class="ht-who">{t.who}</span>
        </div>
      ))}
    </div>
    <div class="ht-week">
      <div class="ht-label">This week</div>
      {meals.map((m) => (
        <div class="ht-meal">
          <span class="ht-day">{m.day}</span>
          <span class="ht-meal-t">{m.meal}</span>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .ht { display: flex; flex-direction: column; gap: 14px; }
  .ht-recipe {
    display: flex; align-items: center; gap: 12px; padding: 10px;
    border: 1px solid var(--border); border-radius: var(--r-md); background: var(--cream-soft);
  }
  .ht-thumb {
    width: 44px; height: 44px; flex: none; border-radius: 12px;
    background: var(--copper-soft); border: 1px solid var(--copper-edge);
    display: grid; place-items: center; font-size: 22px;
  }
  .ht-recipe-main { min-width: 0; flex: 1; }
  .ht-recipe-name { font-size: 13px; font-weight: 700; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ht-recipe-sub { font-size: 11px; color: var(--ink-muted); margin-top: 2px; }
  .ht-tag { font-size: 10.5px; font-weight: 600; color: var(--accent-deep); background: var(--copper-soft); border: 1px solid var(--copper-edge); padding: 4px 9px; border-radius: 99px; flex: none; }
  .ht-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .ht-label { font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-muted); margin-bottom: 8px; }
  .ht-task { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
  .ht-box {
    width: 17px; height: 17px; flex: none; border-radius: 6px; border: 1.5px solid var(--border-strong);
    display: grid; place-items: center; font-size: 10px; color: #fff;
  }
  .ht-box.on { background: var(--accent); border-color: var(--accent); }
  .ht-task-t { font-size: 12px; color: var(--ink-soft); flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ht-task-t.done { text-decoration: line-through; color: var(--ink-muted); }
  .ht-who { font-size: 10px; color: var(--ink-muted); }
  .ht-meal { display: flex; align-items: baseline; gap: 8px; margin-bottom: 8px; }
  .ht-day { font-size: 10.5px; font-weight: 700; color: var(--accent); width: 24px; flex: none; }
  .ht-meal-t { font-size: 12px; color: var(--ink-soft); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
</style>
