---
// Nintek N-grid as a home back-link. Place left of the app's own brand mark.
---
<a href="/" class="nintek-back" aria-label="nintek home">
  <svg width="20" height="20" viewBox="0 0 100 100" fill="none" aria-hidden="true">
    <circle cx="19" cy="19" r="12" fill="#C17A2E"/>
    <circle cx="50" cy="19" r="12" fill="#9c8476"/>
    <circle cx="81" cy="19" r="12" fill="#C17A2E"/>
    <circle cx="19" cy="50" r="12" fill="#C17A2E"/>
    <circle cx="50" cy="50" r="12" fill="#C17A2E"/>
    <circle cx="81" cy="50" r="12" fill="#C17A2E"/>
    <circle cx="19" cy="81" r="12" fill="#C17A2E"/>
    <circle cx="50" cy="81" r="12" fill="#9c8476"/>
    <circle cx="81" cy="81" r="12" fill="#C17A2E"/>
  </svg>
</a>
<span class="nintek-back-sep" aria-hidden="true"></span>

<style>
  .nintek-back {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    opacity: 0.5;
    transition: opacity 0.18s;
    text-decoration: none;
  }
  .nintek-back:hover {
    opacity: 1;
    text-decoration: none;
  }
  .nintek-back-sep {
    display: inline-block;
    width: 1px;
    height: 18px;
    background: currentColor;
    opacity: 0.18;
    margin: 0 10px;
    align-self: center;
    flex-shrink: 0;
  }
</style>
