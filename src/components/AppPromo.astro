---
import type { App } from '../data/apps';
import MockShell from './MockShell.astro';
import PhoneMock from './PhoneMock.astro';
import PlatformBadges from './PlatformBadges.astro';
import Cairn from './mocks/Cairn.astro';
import PulseWire from './mocks/PulseWire.astro';
import Puzzlebox from './mocks/Puzzlebox.astro';
import Hearth from './mocks/Hearth.astro';
import ShopKeep from './mocks/ShopKeep.astro';
import Tabloom from './mocks/Tabloom.astro';
import Workshop from './mocks/Workshop.astro';
import CortexPhone from './mocks/ios/Cortex.astro';
import TarePhone from './mocks/ios/Tare.astro';

interface Props {
  app: App;
  index: number;
}
const { app, index } = Astro.props;
// Alternate the mockup to the left on odd rows for rhythm.
const reverse = index % 2 === 1;

const bodies: Record<string, any> = {
  cairn: Cairn,
  pulsewire: PulseWire,
  puzzlebox: Puzzlebox,
  hearth: Hearth,
  shopkeep: ShopKeep,
  tabloom: Tabloom,
  workshop: Workshop,
};

/** Apps whose home is a phone get a device frame instead of browser chrome.
 *  Tare is here because the native app is now the product — showing it in a
 *  browser window would advertise the version being retired. */
const phoneBodies: Record<string, any> = {
  cortex: CortexPhone,
  tare: TarePhone,
};

/** Cortex ships a dark UI; Tare's is a cool enamel, so it gets a shell to
 *  match rather than the default walnut. */
const phoneTones: Record<string, 'light' | 'dark' | 'navy' | 'enamel'> = {
  tare: 'enamel',
};

const PhoneBody = phoneBodies[app.slug];
const Body = bodies[app.slug];
const isNativeBeta = app.native?.status === 'testflight';
const isScreenshotBody = app.slug === 'tabloom';
const iconSrc = app.slug === 'tabloom' ? '/apps/tabloom.svg' : `/apps/${app.slug}.png`;
---

<section class={`promo${reverse ? ' reverse' : ''}`}>
  <div class="container">
    <div class="promo-grid">
      <div class="promo-text reveal">
        <span class="eyebrow">
          <span class="eyebrow-dot"></span>
          {app.category}
        </span>
        <h2 class="promo-title">
          <span style="display:block">{app.headline.lead}</span>
          <span style="display:block"><span class="em">{app.headline.em}</span></span>
        </h2>
        <p class="promo-sub">{app.description}</p>
        <PlatformBadges app={app} />
        <div class="promo-meta">
          {
            app.hasPage ? (
              <a class="promo-app" href={`/${app.slug}`}>
                <img
                  src={iconSrc}
                  alt={`${app.name} icon`}
                  width="30"
                  height="30"
                />
                {app.name}
              </a>
            ) : (
              <span class="promo-app">
                <img
                  src={iconSrc}
                  alt={`${app.name} icon`}
                  width="30"
                  height="30"
                />
                {app.name}
              </span>
            )
          }
          <span class="promo-quiet">{app.quiet}</span>
        </div>
        {
          isNativeBeta && (
            <a class="promo-native" href={app.slug === 'cortex' ? '/cortex' : `/ios#${app.slug}`}>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="6" y="2" width="12" height="20" rx="3" />
                <path d="M11 18.5h2" />
              </svg>
              {app.native!.thesis}
              <span class="arrow" aria-hidden="true">
                →
              </span>
            </a>
          )
        }
      </div>

      <div class="reveal">
        {
          PhoneBody ? (
            <PhoneMock
              tone={phoneTones[app.slug] ?? 'dark'}
              chip={app.mockup.chip}
              live={app.mockup.live}
              fullBleed={app.slug === 'cortex'}
            >
              <PhoneBody />
            </PhoneMock>
          ) : isScreenshotBody ? (
            <div class="mockup-wrap">
              <Body />
            </div>
          ) : (
            <MockShell
              title={app.mockup.title}
              subtitle={app.mockup.subtitle}
              chip={app.mockup.chip}
              live={app.mockup.live}
            >
              <Body />
            </MockShell>
          )
        }
      </div>
    </div>
  </div>
</section>
