---
import type { App } from '../data/apps';
import MockShell from './MockShell.astro';
import PlatformBadges from './PlatformBadges.astro';
import Cairn from './mocks/Cairn.astro';
import WorkshopShowcase from './WorkshopShowcase.astro';
import ShopKeepReleaseVisual from './ShopKeepReleaseVisual.astro';
import TareReleaseVisual from './TareReleaseVisual.astro';
import WebReleaseVisual from './WebReleaseVisual.astro';

interface Props {
  app: App;
  index: number;
}
const { app, index } = Astro.props;
// Alternate the mockup to the left on odd rows for rhythm.
const reverse = index % 2 === 1;

const bodies: Record<string, any> = {
  cairn: Cairn,
};

const Body = bodies[app.slug];
const isCurrentNative = app.native && app.native.status !== 'next';
const isWorkshop = app.slug === 'workshop';
const iconSrc = `/apps/${app.slug}.png`;
---

<section
  class={`promo${reverse ? ' reverse' : ''}${isWorkshop ? ' workshop-promo' : ''}`}
  id={isWorkshop ? 'workshop-app' : undefined}
>
  <div class="container">
    <div class="promo-grid">
      <div class="promo-text reveal">
        {
          !isWorkshop && (
            <span class="eyebrow">
              <span class="eyebrow-dot"></span>
              {app.category}
            </span>
          )
        }
        <h2 class="promo-title">
          <span style="display:block">{app.headline.lead}</span>
          <span style="display:block"><span class="em">{app.headline.em}</span></span>
        </h2>
        <p class="promo-sub">{app.description}</p>
        <PlatformBadges app={app} />
        <div class="promo-meta">
          {isWorkshop && <span class="workshop-promo-category">{app.category}</span>}
          {
            app.hasPage ? (
              <a class="promo-app" href={`/${app.slug}`}>
                <img
                  src={iconSrc}
                  alt={`${app.name} icon`}
                  width="30"
                  height="30"
                />
                {app.name}
              </a>
            ) : (
              <span class="promo-app">
                <img
                  src={iconSrc}
                  alt={`${app.name} icon`}
                  width="30"
                  height="30"
                />
                {app.name}
              </span>
            )
          }
          <span class="promo-quiet">{app.quiet}</span>
        </div>
        {
          isCurrentNative && (
            <a
              class="promo-native"
              href={`/ios#${app.slug}`}
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="6" y="2" width="12" height="20" rx="3" />
                <path d="M11 18.5h2" />
              </svg>
              {app.native!.thesis}
              <span class="arrow" aria-hidden="true">
                →
              </span>
            </a>
          )
        }
      </div>

      <div class="reveal">
        {
          isWorkshop ? (
            <WorkshopShowcase />
          ) : app.slug === 'tare' ? (
            <TareReleaseVisual />
          ) : app.slug === 'shopkeep' ? (
            <ShopKeepReleaseVisual compact />
          ) : app.slug === 'tabloom' || app.slug === 'pulsewire' ? (
            <WebReleaseVisual product={app.slug} />
          ) : Body ? (
            <MockShell
              title={app.mockup.title}
              subtitle={app.mockup.subtitle}
              chip={app.mockup.chip}
              live={app.mockup.live}
            >
              <Body />
            </MockShell>
          ) : (
            <MockShell
              title={app.mockup.title}
              subtitle={app.mockup.subtitle}
              chip={app.mockup.chip}
              live={app.mockup.live}
            >
              <div class="canonical-icon-evidence">
                <img
                  src={iconSrc}
                  alt={`${app.name} canonical app icon`}
                  width="1024"
                  height="1024"
                  loading="lazy"
                  decoding="async"
                />
                <p>Canonical upstream identity · no product UI substituted</p>
              </div>
            </MockShell>
          )
        }
      </div>
    </div>
  </div>
</section>
