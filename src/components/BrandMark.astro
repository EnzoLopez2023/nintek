---
interface Props {
  size?: number;
}
const { size = 22 } = Astro.props;
---

<!--
  Nintek brand mark — 3×3 dot grid where 7 amber dots trace the letter N.
  Grid: r=12, gap=7, edge=7 on a 100×100 viewBox.
  N pattern: cream dots at top-center (50,19) and bottom-center (50,81).
-->
<svg
  width={size}
  height={size}
  viewBox="0 0 100 100"
  fill="none"
  aria-hidden="true"
  style="display:inline-block;flex-shrink:0"
>
  <!-- Row 1: amber · cream · amber -->
  <circle cx="19" cy="19" r="12" fill="#C17A2E" />
  <circle cx="50" cy="19" r="12" fill="#9c8476" />
  <circle cx="81" cy="19" r="12" fill="#C17A2E" />
  <!-- Row 2: amber · amber · amber  (the diagonal of N) -->
  <circle cx="19" cy="50" r="12" fill="#C17A2E" />
  <circle cx="50" cy="50" r="12" fill="#C17A2E" />
  <circle cx="81" cy="50" r="12" fill="#C17A2E" />
  <!-- Row 3: amber · cream · amber -->
  <circle cx="19" cy="81" r="12" fill="#C17A2E" />
  <circle cx="50" cy="81" r="12" fill="#9c8476" />
  <circle cx="81" cy="81" r="12" fill="#C17A2E" />
</svg>
